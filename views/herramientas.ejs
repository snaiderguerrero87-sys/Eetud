<%- include('layouts/main', { 
    title: 'Listado de Herramientas',
    usuario: 'Administrador',
    body: `
        <div class="page-header">
            <h1>Listado de Herramientas</h1>
            <button class="btn-primary" onclick="abrirModal()">
                <i class="fas fa-plus"></i> Crear Herramienta
            </button>
        </div>

        <section class="table-container">
            <table class="data-table" id="tablaHerramientas">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Marca</th>
                        <th>Ubicación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="cuerpoTabla">
                </tbody>
            </table>
            <div id="sinDatos" class="empty-state" style="display:none;">
                <i class="fas fa-tools"></i>
                <p>No hay herramientas registradas</p>
                <button class="btn-primary" onclick="abrirModal()">
                    <i class="fas fa-plus"></i> Crear primera herramienta
                </button>
            </div>
        </section>

        <div id="modalHerramienta" class="modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 id="modalTitulo">Nueva Herramienta</h2>
                    <span class="close" onclick="cerrarModal()">&times;</span>
                </div>
                <form id="formHerramienta">
                    <div class="form-group">
                        <label for="codigo">Código *</label>
                        <input type="text" id="codigo" placeholder="Ej: HER-001" required>
                    </div>
                    <div class="form-group">
                        <label for="nombre">Nombre *</label>
                        <input type="text" id="nombre" placeholder="Ej: Taladro eléctrico" required>
                    </div>
                    <div class="form-group">
                        <label for="marca">Marca *</label>
                        <input type="text" id="marca" placeholder="Ej: Bosch" required>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-secondary" onclick="cerrarModal()">Cancelar</button>
                        <button type="submit" class="btn-primary">Guardar Herramienta</button>
                    </div>
                </form>
            </div>
        </div>

        <button class="btn-danger btn-cache" onclick="borrarTodas()">
            <i class="fas fa-trash"></i> Borrar Todas Mis Herramientas
        </button>

        <style>
            .ubicacion-asignada {
                color: var(--success);
                font-weight: 500;
            }
            .ubicacion-vacia {
                color: var(--gray-500);
            }
        </style>

        <script>
            var herramientas = [];
            var editandoId = null;

            document.addEventListener('DOMContentLoaded', function() {
                cargarHerramientas();
            });

            // ============================================================
            // ===== CARGAR HERRAMIENTAS DESDE EL SERVIDOR =====
            // ============================================================
            async function cargarHerramientas() {
                try {
                    const response = await fetch('/api/herramientas');
                    if (!response.ok) throw new Error('Error al cargar herramientas');
                    herramientas = await response.json();
                    renderizarTabla();
                } catch (error) {
                    console.error('Error:', error);
                    mostrarNotificacion('Error al cargar herramientas');
                    herramientas = [];
                    renderizarTabla();
                }
            }

            function renderizarTabla() {
                var tbody = document.getElementById('cuerpoTabla');
                var sinDatos = document.getElementById('sinDatos');
                var tabla = document.getElementById('tablaHerramientas');

                if (herramientas.length === 0) {
                    tbody.innerHTML = '';
                    sinDatos.style.display = 'block';
                    tabla.style.display = 'none';
                    return;
                }

                sinDatos.style.display = 'none';
                tabla.style.display = 'table';

                var html = '';
                for (var i = 0; i < herramientas.length; i++) {
                    var h = herramientas[i];
                    var ubicacionHtml = h.ubicacion
                        ? '<span class="ubicacion-asignada"><i class="fas fa-check-circle"></i> ' + h.ubicacion + '</span>'
                        : '<span class="ubicacion-vacia">-</span>';

                    html += '<tr>';
                    html += '<td><strong>' + escapeHtml(h.codigo) + '</strong></td>';
                    html += '<td>' + escapeHtml(h.nombre) + '</td>';
                    html += '<td>' + escapeHtml(h.marca) + '</td>';
                    html += '<td>' + ubicacionHtml + '</td>';
                    html += '<td>';
                    html += '<button class="btn-edit" onclick="editarHerramienta(' + h.id + ')"><i class="fas fa-edit"></i></button>';
                    html += '<button class="btn-delete" onclick="eliminarHerramienta(' + h.id + ')"><i class="fas fa-trash"></i></button>';
                    html += '</td>';
                    html += '</tr>';
                }
                tbody.innerHTML = html;
            }

            function escapeHtml(text) {
                if (text === undefined || text === null) return '';
                return String(text)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            // ============================================================
            // ===== MODAL =====
            // ============================================================
            function abrirModal(herramienta) {
                var modal = document.getElementById('modalHerramienta');
                var form = document.getElementById('formHerramienta');
                var titulo = modal.querySelector('.modal-header h2');

                if (herramienta) {
                    titulo.textContent = 'Editar Herramienta';
                    document.getElementById('codigo').value = herramienta.codigo;
                    document.getElementById('nombre').value = herramienta.nombre;
                    document.getElementById('marca').value = herramienta.marca;
                    editandoId = herramienta.id;
                } else {
                    titulo.textContent = 'Nueva Herramienta';
                    form.reset();
                    editandoId = null;
                    document.getElementById('codigo').value = generarCodigo();
                }

                modal.style.display = 'flex';
            }

            function cerrarModal() {
                document.getElementById('modalHerramienta').style.display = 'none';
                document.getElementById('formHerramienta').reset();
                editandoId = null;
            }

            function generarCodigo() {
                if (herramientas.length === 0) return 'HER-001';
                var maxNum = 0;
                for (var i = 0; i < herramientas.length; i++) {
                    var match = herramientas[i].codigo.match(/HER-(\d+)/);
                    if (match) {
                        var num = parseInt(match[1]);
                        if (num > maxNum) maxNum = num;
                    }
                }
                return 'HER-' + String(maxNum + 1).padStart(3, '0');
            }

            // ============================================================
            // ===== CRUD =====
            // ============================================================
            document.getElementById('formHerramienta').addEventListener('submit', async function(e) {
                e.preventDefault();

                var codigo = document.getElementById('codigo').value.trim();
                var nombre = document.getElementById('nombre').value.trim();
                var marca = document.getElementById('marca').value.trim();

                if (!codigo || !nombre || !marca) {
                    alert('Por favor, completa todos los campos obligatorios (*)');
                    return;
                }

                try {
                    var url = editandoId !== null
                        ? '/api/herramientas/' + editandoId
                        : '/api/herramientas';
                    var method = editandoId !== null ? 'PUT' : 'POST';

                    var response = await fetch(url, {
                        method: method,
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ codigo: codigo, nombre: nombre, marca: marca })
                    });

                    if (!response.ok) {
                        var err = await response.json();
                        throw new Error(err.error || 'Error al guardar');
                    }

                    await cargarHerramientas();
                    cerrarModal();
                    mostrarNotificacion(editandoId !== null ? 'Herramienta actualizada' : 'Herramienta creada');
                    editandoId = null;
                } catch (error) {
                    console.error('Error:', error);
                    mostrarNotificacion('Error: ' + error.message);
                }
            });

            function editarHerramienta(id) {
                var herramienta = null;
                for (var i = 0; i < herramientas.length; i++) {
                    if (herramientas[i].id === id) {
                        herramienta = herramientas[i];
                        break;
                    }
                }
                if (herramienta) abrirModal(herramienta);
            }

            async function eliminarHerramienta(id) {
                if (!confirm('¿Estás seguro de eliminar esta herramienta?')) return;

                try {
                    var response = await fetch('/api/herramientas/' + id, { method: 'DELETE' });
                    if (!response.ok) throw new Error('Error al eliminar');
                    await cargarHerramientas();
                    mostrarNotificacion('Herramienta eliminada');
                } catch (error) {
                    console.error('Error:', error);
                    mostrarNotificacion('Error al eliminar');
                }
            }

            async function borrarTodas() {
                if (herramientas.length === 0) {
                    alert('No hay herramientas para borrar');
                    return;
                }
                if (!confirm('⚠️ ¿Borrar TODAS tus herramientas? Esta acción no se puede deshacer.')) return;

                try {
                    for (var i = 0; i < herramientas.length; i++) {
                        await fetch('/api/herramientas/' + herramientas[i].id, { method: 'DELETE' });
                    }
                    await cargarHerramientas();
                    mostrarNotificacion('Todas las herramientas fueron eliminadas');
                } catch (error) {
                    console.error('Error:', error);
                    mostrarNotificacion('Error al borrar');
                }
            }

            // ============================================================
            // ===== NOTIFICACIONES =====
            // ============================================================
            function mostrarNotificacion(mensaje) {
                var notificacion = document.createElement('div');
                notificacion.className = 'notification';
                notificacion.textContent = mensaje;
                document.body.appendChild(notificacion);
                setTimeout(function() { notificacion.classList.add('show'); }, 100);
                setTimeout(function() {
                    notificacion.classList.remove('show');
                    setTimeout(function() { notificacion.remove(); }, 300);
                }, 3000);
            }

            window.onclick = function(event) {
                var modal = document.getElementById('modalHerramienta');
                if (event.target === modal) cerrarModal();
            };
        </script>
    `
}) %>