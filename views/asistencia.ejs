<%- include('layouts/main', { 
    title: 'Asistencia - Empleados',
    usuario: usuario,
    body: `
        <div class="page-header">
            <h1>Gestión de Empleados</h1>
            <button class="btn-primary" onclick="abrirModal()">
                <i class="fas fa-user-plus"></i> Crear Empleado
            </button>
        </div>

        <section class="table-container">
            <table class="data-table" id="tablaEmpleados">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Cargo</th>
                        <th>Costo Día</th>
                        <th>Costo Mes</th>
                        <th>Costo Hora</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="cuerpoTabla">
                </tbody>
            </table>
            <div id="sinDatos" class="empty-state" style="display:none;">
                <i class="fas fa-users"></i>
                <p>No hay empleados registrados</p>
                <button class="btn-primary" onclick="abrirModal()">
                    <i class="fas fa-user-plus"></i> Crear primer empleado
                </button>
            </div>
        </section>

        <div id="modalEmpleado" class="modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 id="modalTitulo">Nuevo Empleado</h2>
                    <span class="close" onclick="cerrarModal()">&times;</span>
                </div>
                <form id="formEmpleado">
                    <div class="form-group">
                        <label for="nombre">Nombre completo *</label>
                        <input type="text" id="nombre" placeholder="Ej: Juan Pérez" required>
                    </div>
                    <div class="form-group">
                        <label for="cargo">Cargo *</label>
                        <input type="text" id="cargo" placeholder="Ej: Ingeniero Civil" required>
                    </div>
                    <div class="form-group">
                        <label for="costoDia">Costo por Día (COP) *</label>
                        <input type="number" id="costoDia" placeholder="Ej: 80000" required oninput="calcularCostos()">
                    </div>
                    <div class="form-row">
                        <div class="form-group half">
                            <label for="costoMes">Costo Mensual (COP)</label>
                            <input type="text" id="costoMes" readonly style="background: var(--gray-100);">
                        </div>
                        <div class="form-group half">
                            <label for="costoHora">Costo por Hora (COP)</label>
                            <input type="text" id="costoHora" readonly style="background: var(--gray-100);">
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-secondary" onclick="cerrarModal()">Cancelar</button>
                        <button type="submit" class="btn-primary">Guardar Empleado</button>
                    </div>
                </form>
            </div>
        </div>

        <button class="btn-danger btn-cache" onclick="borrarTodos()">
            <i class="fas fa-trash"></i> Borrar Todos Mis Empleados
        </button>

        <script>
            var empleados = [];
            var editandoId = null;

            document.addEventListener('DOMContentLoaded', function() {
                cargarEmpleados();
            });

            // ============================================================
            // ===== CALCULAR COSTOS (preview en el modal) =====
            // ============================================================
            function calcularCostos() {
                var costoDia = parseFloat(document.getElementById('costoDia').value) || 0;
                var costoMes = costoDia * 30;
                var costoHora = costoDia / 8;
                document.getElementById('costoMes').value = '$' + Number(costoMes).toLocaleString('es-CO');
                document.getElementById('costoHora').value = '$' + Number(costoHora).toLocaleString('es-CO');
            }

            // ============================================================
            // ===== CARGAR EMPLEADOS DESDE EL SERVIDOR =====
            // ============================================================
            async function cargarEmpleados() {
                try {
                    const response = await fetch('/api/empleados');
                    if (!response.ok) throw new Error('Error al cargar empleados');
                    empleados = await response.json();
                    renderizarTabla();
                } catch (error) {
                    console.error('Error:', error);
                    mostrarNotificacion('Error al cargar empleados');
                    empleados = [];
                    renderizarTabla();
                }
            }

            function renderizarTabla() {
                var tbody = document.getElementById('cuerpoTabla');
                var sinDatos = document.getElementById('sinDatos');
                var tabla = document.getElementById('tablaEmpleados');

                if (empleados.length === 0) {
                    tbody.innerHTML = '';
                    sinDatos.style.display = 'block';
                    tabla.style.display = 'none';
                    return;
                }

                sinDatos.style.display = 'none';
                tabla.style.display = 'table';

                var html = '';
                for (var i = 0; i < empleados.length; i++) {
                    var e = empleados[i];
                    var costoDia = '$' + Number(e.costoDia).toLocaleString('es-CO');
                    var costoMes = '$' + Number(e.costoMes).toLocaleString('es-CO');
                    var costoHora = '$' + Number(e.costoHora).toLocaleString('es-CO');

                    html += '<tr>';
                    html += '<td><strong>' + e.id + '</strong></td>';
                    html += '<td>' + escapeHtml(e.nombre) + '</td>';
                    html += '<td>' + escapeHtml(e.cargo) + '</td>';
                    html += '<td>' + costoDia + '</td>';
                    html += '<td>' + costoMes + '</td>';
                    html += '<td>' + costoHora + '</td>';
                    html += '<td>';
                    html += '<button class="btn-edit" onclick="editarEmpleado(' + e.id + ')"><i class="fas fa-edit"></i></button>';
                    html += '<button class="btn-delete" onclick="eliminarEmpleado(' + e.id + ')"><i class="fas fa-trash"></i></button>';
                    html += '</td>';
                    html += '</tr>';
                }
                tbody.innerHTML = html;
            }

            function escapeHtml(text) {
                if (text === undefined || text === null) return '';
                return String(text)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            // ============================================================
            // ===== MODAL =====
            // ============================================================
            function abrirModal(empleado) {
                var modal = document.getElementById('modalEmpleado');
                var form = document.getElementById('formEmpleado');
                var titulo = document.getElementById('modalTitulo');

                if (empleado) {
                    titulo.textContent = 'Editar Empleado';
                    document.getElementById('nombre').value = empleado.nombre;
                    document.getElementById('cargo').value = empleado.cargo;
                    document.getElementById('costoDia').value = empleado.costoDia;
                    editandoId = empleado.id;
                    calcularCostos();
                } else {
                    titulo.textContent = 'Nuevo Empleado';
                    form.reset();
                    editandoId = null;
                    document.getElementById('costoMes').value = '';
                    document.getElementById('costoHora').value = '';
                }

                modal.style.display = 'flex';
            }

            function cerrarModal() {
                document.getElementById('modalEmpleado').style.display = 'none';
                document.getElementById('formEmpleado').reset();
                editandoId = null;
                document.getElementById('costoMes').value = '';
                document.getElementById('costoHora').value = '';
            }

            // ============================================================
            // ===== CRUD =====
            // ============================================================
            document.getElementById('formEmpleado').addEventListener('submit', async function(e) {
                e.preventDefault();

                var nombre = document.getElementById('nombre').value.trim();
                var cargo = document.getElementById('cargo').value.trim();
                var costoDia = parseFloat(document.getElementById('costoDia').value);

                if (!nombre || !cargo || !costoDia) {
                    alert('Por favor, completa todos los campos obligatorios (*)');
                    return;
                }

                try {
                    var url = editandoId !== null
                        ? '/api/empleados/' + editandoId
                        : '/api/empleados';
                    var method = editandoId !== null ? 'PUT' : 'POST';

                    var response = await fetch(url, {
                        method: method,
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ nombre: nombre, cargo: cargo, costoDia: costoDia })
                    });

                    if (!response.ok) {
                        var err = await response.json();
                        throw new Error(err.error || 'Error al guardar');
                    }

                    await cargarEmpleados();
                    cerrarModal();
                    mostrarNotificacion(editandoId !== null ? 'Empleado actualizado' : 'Empleado creado');
                    editandoId = null;
                } catch (error) {
                    console.error('Error:', error);
                    mostrarNotificacion('Error: ' + error.message);
                }
            });

            function editarEmpleado(id) {
                var empleado = null;
                for (var i = 0; i < empleados.length; i++) {
                    if (empleados[i].id === id) {
                        empleado = empleados[i];
                        break;
                    }
                }
                if (empleado) abrirModal(empleado);
            }

            async function eliminarEmpleado(id) {
                if (!confirm('¿Estás seguro de eliminar este empleado?')) return;

                try {
                    var response = await fetch('/api/empleados/' + id, { method: 'DELETE' });
                    if (!response.ok) throw new Error('Error al eliminar');
                    await cargarEmpleados();
                    mostrarNotificacion('Empleado eliminado');
                } catch (error) {
                    console.error('Error:', error);
                    mostrarNotificacion('Error al eliminar');
                }
            }

            async function borrarTodos() {
                if (empleados.length === 0) {
                    alert('No hay empleados para borrar');
                    return;
                }
                if (!confirm('⚠️ ¿Borrar TODOS tus empleados? Esta acción no se puede deshacer.')) return;

                try {
                    for (var i = 0; i < empleados.length; i++) {
                        await fetch('/api/empleados/' + empleados[i].id, { method: 'DELETE' });
                    }
                    await cargarEmpleados();
                    mostrarNotificacion('Todos los empleados fueron eliminados');
                } catch (error) {
                    console.error('Error:', error);
                    mostrarNotificacion('Error al borrar');
                }
            }

            // ============================================================
            // ===== NOTIFICACIONES =====
            // ============================================================
            function mostrarNotificacion(mensaje) {
                var notificacion = document.createElement('div');
                notificacion.className = 'notification';
                notificacion.textContent = mensaje;
                document.body.appendChild(notificacion);
                setTimeout(function() { notificacion.classList.add('show'); }, 100);
                setTimeout(function() {
                    notificacion.classList.remove('show');
                    setTimeout(function() { notificacion.remove(); }, 300);
                }, 3000);
            }

            window.onclick = function(event) {
                var modal = document.getElementById('modalEmpleado');
                if (event.target === modal) cerrarModal();
            };
        </script>
    `
}) %>