<%- include('layouts/main', { 
    title: 'Listado de Cotizaciones',
    usuario: 'Administrador',
    body: `
        <div class="page-header">
            <h1>Listado de Cotizaciones</h1>
            <div style="display:flex; gap:12px; flex-wrap:wrap;">
                <button class="btn-primary" onclick="abrirModal()">
                    <i class="fas fa-plus"></i> Crear Cotización
                </button>
            </div>
        </div>

        <!-- Tabla de Cotizaciones -->
        <section class="table-container">
            <table class="data-table" id="tablaCotizaciones">
                <thead>
                    <tr>
                        <th>N° Cotización</th>
                        <th>Cliente</th>
                        <th>Tipo</th>
                        <th>Proyecto</th>
                        <th>Objetivo</th>
                        <th>Valor Total</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="cuerpoTabla">
                    <!-- Los datos se cargan con JavaScript -->
                </tbody>
            </table>
            <div id="sinDatos" class="empty-state">
                <i class="fas fa-file-invoice"></i>
                <p>No hay cotizaciones registradas</p>
                <button class="btn-primary" onclick="abrirModal()">
                    <i class="fas fa-plus"></i> Crear primera cotización
                </button>
            </div>
        </section>

        <!-- Modal para crear/editar cotización -->
        <div id="modalCotizacion" class="modal modal-cotizacion">
            <div class="modal-content modal-content-cotizacion">
                <div class="modal-header">
                    <h2 id="modalTitulo">Nueva Cotización</h2>
                    <span class="close" onclick="cerrarModal()">&times;</span>
                </div>
                <form id="formCotizacion">
                    <div class="form-row">
                        <div class="form-group half">
                            <label for="numero">N° Cotización</label>
                            <input type="text" id="numero" placeholder="Ej: COT-001">
                            <div id="numeroAnterior" style="font-size:12px; color:var(--gray-600); margin-top:4px;">
                                Último número usado: <span id="ultimoNumero">-</span>
                            </div>
                        </div>
                        <div class="form-group half">
                            <label for="tipo">Tipo de Cotización *</label>
                            <select id="tipo" class="form-select" required>
                                <option value="">-- Seleccionar --</option>
                                <option value="Obra">Obra</option>
                                <option value="Servicio">Servicio</option>
                                <option value="Mantenimiento">Mantenimiento</option>
                                <option value="Suministro">Suministro</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group half">
                            <label for="cliente">Cliente *</label>
                            <input type="text" id="cliente" placeholder="Ej: Constructora ABC" required>
                        </div>
                        <div class="form-group half">
                            <label for="proyecto">Proyecto *</label>
                            <input type="text" id="proyecto" placeholder="Ej: Edificio Torre Central" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="objetivo">Objetivo</label>
                        <textarea id="objetivo" rows="2" placeholder="Ej: Construcción de estructura de 10 pisos" style="width:100%; padding:10px 14px; border:1px solid var(--gray-200); border-radius:8px; font-size:14px; font-family:inherit; resize:vertical;"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="direccion">Dirección</label>
                        <input type="text" id="direccion" placeholder="Ej: Calle 123 #45-67">
                    </div>

                    <hr class="form-divider">

                    <!-- SECCIÓN: ITEMS JERÁRQUICOS -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <h3 class="section-title" style="margin: 0;"><i class="fas fa-list"></i> Items de Cotización</h3>
                        <button type="button" class="btn-undo" id="btnUndo" onclick="undoAction()" title="Deshacer última acción">
                            <i class="fas fa-undo"></i> Deshacer
                        </button>
                    </div>

                    <!-- Contenedor de items -->
                    <div id="listaItems" class="items-container">
                        <div class="empty-items">No hay items agregados. Comienza agregando un Título.</div>
                    </div>

                    <hr class="form-divider">

                    <!-- SECCIÓN: SUBTOTALES Y AJUSTES -->
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
                        <div>
                            <h3 class="section-title"><i class="fas fa-calculator"></i> Ajustes</h3>

                            <div class="subtotal-row">
                                <div class="subtotal-label">Subtotal</div>
                                <div class="subtotal-value" id="subtotalDisplay">$0</div>
                            </div>

                            <div class="ajuste-row">
                                <div class="ajuste-info">
                                    <label class="toggle-label-mini">
                                        <input type="checkbox" class="toggle-ajuste" data-ajuste="admin" checked>
                                        <span class="toggle-slider-mini"></span>
                                    </label>
                                    <span class="ajuste-nombre">Administración</span>
                                    <span class="ajuste-porcentaje">(%)</span>
                                </div>
                                <input type="number" class="ajuste-input" id="adminPorcentaje" value="0" min="0" step="0.1" oninput="calcularTotales()">
                                <span class="ajuste-valor" id="adminValor">$0</span>
                            </div>

                            <div class="ajuste-row">
                                <div class="ajuste-info">
                                    <label class="toggle-label-mini">
                                        <input type="checkbox" class="toggle-ajuste" data-ajuste="imprevistos" checked>
                                        <span class="toggle-slider-mini"></span>
                                    </label>
                                    <span class="ajuste-nombre">Imprevistos</span>
                                    <span class="ajuste-porcentaje">(%)</span>
                                </div>
                                <input type="number" class="ajuste-input" id="imprevistosPorcentaje" value="0" min="0" step="0.1" oninput="calcularTotales()">
                                <span class="ajuste-valor" id="imprevistosValor">$0</span>
                            </div>

                            <div class="ajuste-row">
                                <div class="ajuste-info">
                                    <label class="toggle-label-mini">
                                        <input type="checkbox" class="toggle-ajuste" data-ajuste="utilidad" checked>
                                        <span class="toggle-slider-mini"></span>
                                    </label>
                                    <span class="ajuste-nombre">Utilidad</span>
                                    <span class="ajuste-porcentaje">(%)</span>
                                </div>
                                <input type="number" class="ajuste-input" id="utilidadPorcentaje" value="0" min="0" step="0.1" oninput="calcularTotales()">
                                <span class="ajuste-valor" id="utilidadValor">$0</span>
                            </div>

                            <div class="ajuste-row iva-row">
                                <div class="ajuste-info">
                                    <label class="toggle-label-mini">
                                        <input type="checkbox" class="toggle-ajuste" data-ajuste="iva" checked>
                                        <span class="toggle-slider-mini"></span>
                                    </label>
                                    <span class="ajuste-nombre">IVA</span>
                                    <span class="ajuste-porcentaje">(%)</span>
                                    <span class="ajuste-nota">(sobre Utilidad)</span>
                                </div>
                                <input type="number" class="ajuste-input" id="ivaPorcentaje" value="0" min="0" step="0.1" oninput="calcularTotales()">
                                <span class="ajuste-valor" id="ivaValor">$0</span>
                            </div>
                        </div>

                        <!-- TOTAL -->
                        <div>
                            <h3 class="section-title"><i class="fas fa-file-invoice"></i> Resumen</h3>
                            <div class="total-container final-total" style="margin-top:10px;">
                                <div class="total-label">Valor Total Cotización:</div>
                                <div class="total-value" id="valorTotalFinal">$0</div>
                            </div>
                        </div>
                    </div>

                    <hr class="form-divider">

                    <div class="form-actions">
                        <button type="button" class="btn-secondary" onclick="cerrarModal()">Cancelar</button>
                        <button type="submit" class="btn-primary">Guardar Cotización</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- ===== MODAL SELECCIONAR APU (MÚLTIPLES) ===== -->
        <div id="modalSeleccionarAPU" class="modal modal-grande">
            <div class="modal-content" style="max-width:700px;">
                <div class="modal-header">
                    <h2><i class="fas fa-table"></i> Seleccionar APU</h2>
                    <span class="close" onclick="cerrarSelectorAPU()">&times;</span>
                </div>
                <div style="padding:10px 0;">
                    <p style="color:var(--gray-600); margin-bottom:12px;">Selecciona los APU que deseas agregar a la cotización:</p>
                    
                    <div style="display:flex; gap:10px; margin-bottom:12px;">
                        <input type="text" id="buscarAPUSelector" placeholder="Buscar APU por nombre o código..." style="flex:1; padding:8px 12px; border:1px solid var(--gray-200); border-radius:6px; font-size:14px;" oninput="filtrarAPUSelector()">
                        <span id="apuContadorSelector" style="display:flex; align-items:center; color:var(--gray-600); font-size:13px;">0 APU</span>
                    </div>

                    <div id="listaAPUSelector" style="max-height:350px; overflow-y:auto; border:1px solid var(--gray-200); border-radius:6px; padding:4px;">
                        <p class="empty-items">Cargando APU...</p>
                    </div>

                    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:12px; gap:10px; flex-wrap:wrap;">
                        <div style="display:flex; gap:6px;">
                            <button class="btn-sm" onclick="seleccionarTodosAPU()" style="color:var(--primary); border-color:var(--primary);">Seleccionar todos</button>
                            <button class="btn-sm" onclick="deseleccionarTodosAPU()" style="color:var(--danger); border-color:var(--danger);">Deseleccionar todos</button>
                        </div>
                        <span id="apuSeleccionadosContador" style="font-size:14px; color:var(--primary); font-weight:600;">0 APU seleccionados</span>
                    </div>

                    <div style="display:flex; gap:12px; margin-top:16px; justify-content:flex-end; border-top:1px solid var(--gray-200); padding-top:16px;">
                        <button class="btn-secondary" onclick="cerrarSelectorAPU()">Cancelar</button>
                        <button class="btn-primary" onclick="agregarAPUSeleccionados()">
                            <i class="fas fa-plus"></i> Agregar Seleccionados
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botón para borrar caché -->
        <button class="btn-danger btn-cache" onclick="borrarCache()">
            <i class="fas fa-trash"></i> Borrar Caché
        </button>

        <style>
            /* ===== MODAL COTIZACIÓN ===== */
            .modal-cotizacion .modal-content-cotizacion {
                max-width: 95vw !important;
                width: 95vw !important;
                max-height: 92vh !important;
                padding: 24px 32px !important;
                overflow-y: auto !important;
            }

            .modal-cotizacion .modal-content-cotizacion .form-row {
                display: flex !important;
                gap: 16px !important;
            }
            .modal-cotizacion .modal-content-cotizacion .form-row .form-group.half {
                flex: 1 !important;
            }

            /* ===== SELECTOR APU ===== */
            .apu-item-selector {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 8px 12px;
                border-bottom: 1px solid var(--gray-100);
                transition: all 0.2s;
                cursor: pointer;
            }
            .apu-item-selector:hover {
                background: var(--gray-50);
            }
            .apu-item-selector input[type="checkbox"] {
                width: 18px;
                height: 18px;
                cursor: pointer;
                accent-color: var(--primary);
                flex-shrink: 0;
            }
            .apu-item-selector .apu-info {
                flex: 1;
                display: flex;
                flex-wrap: wrap;
                gap: 4px 12px;
            }
            .apu-item-selector .apu-info .apu-codigo {
                font-weight: 600;
                color: var(--gray-900);
            }
            .apu-item-selector .apu-info .apu-nombre {
                color: var(--gray-700);
            }
            .apu-item-selector .apu-info .apu-categoria {
                font-size: 12px;
                color: var(--gray-500);
                background: var(--gray-100);
                padding: 2px 8px;
                border-radius: 4px;
            }
            .apu-item-selector .apu-info .apu-valor {
                font-size: 13px;
                font-weight: 600;
                color: var(--primary);
                margin-left: auto;
            }
            .apu-item-selector.seleccionado {
                background: #e8f4fd;
                border-left: 3px solid var(--primary);
            }

            /* ===== BOTÓN PDF ===== */
            .btn-pdf {
                background: #dc2626;
                color: white;
                border: none;
                padding: 6px 10px;
                border-radius: 6px;
                cursor: pointer;
                transition: all 0.2s;
                margin-left: 4px;
            }
            .btn-pdf:hover {
                background: #b91c1c;
                transform: scale(1.05);
            }

            .btn-print { background: #10b981; color: white; border: none; padding: 6px 10px; border-radius: 6px; cursor: pointer; transition: all 0.2s; margin-left: 4px; }
            .btn-print:hover { background: #059669; transform: scale(1.05); }

            /* ===== RESPONSIVE ===== */
            @media (max-width: 768px) {
                .modal-cotizacion .modal-content-cotizacion {
                    max-width: 98vw !important;
                    width: 98vw !important;
                    padding: 16px !important;
                    max-height: 95vh !important;
                }
                .modal-cotizacion .modal-content-cotizacion .form-row {
                    flex-direction: column !important;
                    gap: 0 !important;
                }
                .modal-cotizacion .modal-content-cotizacion .form-row .form-group.half {
                    flex: none !important;
                }
                .modal-cotizacion .modal-content-cotizacion .item-row {
                    flex-wrap: wrap !important;
                }
                .modal-cotizacion .modal-content-cotizacion .item-row .form-group {
                    flex: 1 !important;
                    min-width: 100px !important;
                }
                #modalSeleccionarAPU .modal-content {
                    max-width: 95vw !important;
                    width: 95vw !important;
                    padding: 16px !important;
                }
                .apu-item-selector {
                    flex-wrap: wrap !important;
                }
                .apu-item-selector .apu-info {
                    flex-direction: column !important;
                    gap: 2px !important;
                }
                .apu-item-selector .apu-info .apu-valor {
                    margin-left: 0 !important;
                }
                .form-actions {
                    flex-direction: column !important;
                }
                .form-actions button {
                    width: 100% !important;
                }
            }

            .modal-cotizacion .modal-content-cotizacion::-webkit-scrollbar {
                width: 6px;
            }
            .modal-cotizacion .modal-content-cotizacion::-webkit-scrollbar-track {
                background: var(--gray-100);
                border-radius: 10px;
            }
            .modal-cotizacion .modal-content-cotizacion::-webkit-scrollbar-thumb {
                background: var(--primary);
                border-radius: 10px;
            }
        </style>

        <script>
            // ===== VARIABLES GLOBALES =====
            var cotizaciones = [];
            var editandoId = null;
            var apusData = [];
            var items = [];
            var counterId = 0;

            // ===== VARIABLES PARA UNDO =====
            var historial = [];
            var maxHistorial = 20;

            // ===== VARIABLES PARA SELECTOR DE APU =====
            var apusFiltradosSelector = [];
            var apusSeleccionadosTemp = [];
            var posicionInsertarAPU = null;

            // ===== FUNCIÓN PARA ESCAPAR HTML =====
            function escapeHTML(str) {
                if (!str) return '';
                return String(str).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            }

            // ===== FUNCIONES PARA UNDO =====
            function guardarEstado() {
                var copia = JSON.stringify(items);
                historial.push(copia);
                if (historial.length > maxHistorial) {
                    historial.shift();
                }
                actualizarBotonUndo();
            }

            function undoAction() {
                if (historial.length <= 1) {
                    alert('No hay acciones para deshacer');
                    return;
                }
                historial.pop();
                var estadoAnterior = historial[historial.length - 1];
                items = JSON.parse(estadoAnterior);
                renderizarItems();
                actualizarBotonUndo();
                mostrarNotificacion('↩️ Acción deshecha');
            }

            function actualizarBotonUndo() {
                var btn = document.getElementById('btnUndo');
                if (btn) {
                    if (historial.length > 1) {
                        btn.style.opacity = '1';
                        btn.style.pointerEvents = 'auto';
                    } else {
                        btn.style.opacity = '0.5';
                        btn.style.pointerEvents = 'none';
                    }
                }
            }

            // ===== FUNCIÓN PARA OBTENER VALOR DEL APU =====
            function obtenerValorAPU(apu) {
                if (!apu) return 0;
                if (apu.valor !== undefined && apu.valor !== null) {
                    return apu.valor;
                }
                if (apu.items) {
                    var total = 0;
                    if (apu.items.materiales) {
                        for (var i = 0; i < apu.items.materiales.length; i++) {
                            total += apu.items.materiales[i].subtotal || 0;
                        }
                    }
                    if (apu.items.cargos) {
                        for (var j = 0; j < apu.items.cargos.length; j++) {
                            total += apu.items.cargos[j].subtotal || 0;
                        }
                    }
                    return total;
                }
                return 0;
            }

            // ===== CARGAR DATOS DE REFERENCIA =====
            function cargarAPUs() {
                try {
                    var data = localStorage.getItem('apu');
                    if (data) {
                        apusData = JSON.parse(data);
                    } else {
                        apusData = [];
                    }
                } catch (e) {
                    apusData = [];
                }
            }

            // ===== GENERAR NUMERACIÓN =====
            function generarNumeracion() {
                var contadorTitulo = 0;
                var contadorAPU = {};
                var contadorSubitem = {};

                for (var i = 0; i < items.length; i++) {
                    var item = items[i];
                    if (item.tipo === 'titulo') {
                        contadorTitulo++;
                        contadorAPU[contadorTitulo] = 0;
                        contadorSubitem[contadorTitulo + '.' + contadorAPU[contadorTitulo]] = 0;
                        item.numero = contadorTitulo + '.';
                    } else if (item.tipo === 'apu') {
                        if (!item.padreTitulo) {
                            item.padreTitulo = contadorTitulo;
                        }
                        var padre = item.padreTitulo || contadorTitulo;
                        contadorAPU[padre] = (contadorAPU[padre] || 0) + 1;
                        var claveAPU = padre + '.' + contadorAPU[padre];
                        contadorSubitem[claveAPU] = 0;
                        item.numero = padre + '.' + contadorAPU[padre];
                    } else if (item.tipo === 'subitem') {
                        var padreAPU = item.padreAPU || '';
                        var partes = padreAPU.split('.');
                        var padre = parseInt(partes[0]) || 1;
                        var apuNum = parseInt(partes[1]) || 0;
                        if (apuNum > 0) {
                            var clave = padre + '.' + apuNum;
                            contadorSubitem[clave] = (contadorSubitem[clave] || 0) + 1;
                            item.numero = padre + '.' + apuNum + '.' + contadorSubitem[clave];
                        } else {
                            var ultimoAPU = null;
                            for (var j = i - 1; j >= 0; j--) {
                                if (items[j].tipo === 'apu') {
                                    ultimoAPU = items[j];
                                    break;
                                }
                            }
                            if (ultimoAPU) {
                                var partesUltimo = ultimoAPU.numero.split('.');
                                var p = parseInt(partesUltimo[0]) || 1;
                                var a = parseInt(partesUltimo[1]) || 0;
                                var clave = p + '.' + a;
                                contadorSubitem[clave] = (contadorSubitem[clave] || 0) + 1;
                                item.numero = p + '.' + a + '.' + contadorSubitem[clave];
                                item.padreAPU = ultimoAPU.numero;
                            }
                        }
                    }
                }
            }

            // ===== FUNCIONES PARA ACTUALIZAR =====
            function actualizarItemDesdeInput(index, campo, valor) {
                if (index >= 0 && index < items.length) {
                    items[index][campo] = valor;
                    calcularTotales();
                    guardarEstado();
                }
            }

            function actualizarCantidadDesdeInput(index, valor) {
                var cantidad = parseFloat(valor) || 1;
                if (cantidad < 0.1) {
                    cantidad = 0.1;
                }
                if (index >= 0 && index < items.length) {
                    items[index].cantidad = cantidad;
                    renderizarItems();
                    guardarEstado();
                }
            }

            // ===== CALCULAR SUBTOTAL =====
            function calcularSubtotal() {
                var total = 0;
                for (var i = 0; i < items.length; i++) {
                    if (items[i].tipo === 'apu') {
                        total += (items[i].valorUnitario || 0) * (items[i].cantidad || 1);
                    }
                }
                return total;
            }

            // ===== CALCULAR TODOS LOS TOTALES =====
            function calcularTotales() {
                var subtotal = calcularSubtotal();

                document.getElementById('subtotalDisplay').textContent = '$' + Number(subtotal).toLocaleString('es-CO');

                var adminPorc = parseFloat(document.getElementById('adminPorcentaje').value) || 0;
                var imprevistosPorc = parseFloat(document.getElementById('imprevistosPorcentaje').value) || 0;
                var utilidadPorc = parseFloat(document.getElementById('utilidadPorcentaje').value) || 0;
                var ivaPorc = parseFloat(document.getElementById('ivaPorcentaje').value) || 0;

                var adminActivo = document.querySelector('.toggle-ajuste[data-ajuste="admin"]').checked;
                var imprevistosActivo = document.querySelector('.toggle-ajuste[data-ajuste="imprevistos"]').checked;
                var utilidadActivo = document.querySelector('.toggle-ajuste[data-ajuste="utilidad"]').checked;
                var ivaActivo = document.querySelector('.toggle-ajuste[data-ajuste="iva"]').checked;

                var adminValor = adminActivo ? (subtotal * adminPorc / 100) : 0;
                var imprevistosValor = imprevistosActivo ? (subtotal * imprevistosPorc / 100) : 0;
                var utilidadValor = utilidadActivo ? (subtotal * utilidadPorc / 100) : 0;
                var ivaValor = ivaActivo ? (utilidadValor * ivaPorc / 100) : 0;

                document.getElementById('adminValor').textContent = '$' + Number(adminValor).toLocaleString('es-CO');
                document.getElementById('imprevistosValor').textContent = '$' + Number(imprevistosValor).toLocaleString('es-CO');
                document.getElementById('utilidadValor').textContent = '$' + Number(utilidadValor).toLocaleString('es-CO');
                document.getElementById('ivaValor').textContent = '$' + Number(ivaValor).toLocaleString('es-CO');

                var totalFinal = subtotal + adminValor + imprevistosValor + utilidadValor + ivaValor;
                document.getElementById('valorTotalFinal').textContent = '$' + Number(totalFinal).toLocaleString('es-CO');

                window._ajustes = {
                    adminPorc: adminPorc,
                    imprevistosPorc: imprevistosPorc,
                    utilidadPorc: utilidadPorc,
                    ivaPorc: ivaPorc,
                    adminActivo: adminActivo,
                    imprevistosActivo: imprevistosActivo,
                    utilidadActivo: utilidadActivo,
                    ivaActivo: ivaActivo,
                    adminValor: adminValor,
                    imprevistosValor: imprevistosValor,
                    utilidadValor: utilidadValor,
                    ivaValor: ivaValor,
                    subtotal: subtotal,
                    totalFinal: totalFinal
                };
            }

            // ===== FUNCIÓN PARA OBTENER ÚLTIMO NÚMERO =====
            function obtenerUltimoNumero() {
                if (cotizaciones.length === 0) {
                    return '-';
                }
                var numeros = [];
                for (var i = 0; i < cotizaciones.length; i++) {
                    if (cotizaciones[i].numero) {
                        numeros.push(cotizaciones[i].numero);
                    }
                }
                if (numeros.length === 0) return '-';
                numeros.sort();
                return numeros[numeros.length - 1];
            }

            // ===== DRAG & DROP =====
            var dragIndex = null;

            function iniciarDrag(e, index) {
                dragIndex = index;
                var row = e.target.closest('.item-row');
                if (row) {
                    row.style.opacity = '0.5';
                    row.style.border = '2px dashed var(--primary)';
                }
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', index);
            }

            function finalizarDrag(e) {
                var rows = document.querySelectorAll('.item-row');
                for (var i = 0; i < rows.length; i++) {
                    rows[i].style.opacity = '1';
                    rows[i].style.border = '';
                }
                dragIndex = null;
            }

            function soltarItem(e, targetIndex) {
                e.preventDefault();
                var sourceIndex = parseInt(e.dataTransfer.getData('text/plain'));

                if (isNaN(sourceIndex) || sourceIndex === targetIndex || sourceIndex < 0 || targetIndex < 0) {
                    finalizarDrag(e);
                    return;
                }

                if (sourceIndex >= items.length || targetIndex >= items.length) {
                    finalizarDrag(e);
                    return;
                }

                var itemMover = items.splice(sourceIndex, 1)[0];
                items.splice(targetIndex, 0, itemMover);

                guardarEstado();
                renderizarItems();
                finalizarDrag(e);
                mostrarNotificacion('📦 Item movido');
            }

            function permitirSoltar(e) {
                e.preventDefault();
            }

            // ===== RENDERIZAR ITEMS =====
            function renderizarItems() {
                var container = document.getElementById('listaItems');
                if (!container) return;

                if (items.length === 0) {
                    container.innerHTML = '<div class="empty-items">No hay items agregados. Comienza agregando un Título.</div>';
                    calcularTotales();
                    return;
                }

                generarNumeracion();

                var html = '<div class="items-list">';
                var totalCotizacion = 0;

                for (var i = 0; i < items.length; i++) {
                    var item = items[i];
                    var clase = 'item-' + item.tipo;
                    var numero = item.numero || '';

                    var subtotal = 0;
                    if (item.tipo === 'apu') {
                        subtotal = (item.valorUnitario || 0) * (item.cantidad || 1);
                        totalCotizacion += subtotal;
                    }

                    html += '<div class="item-row ' + clase + '" data-index="' + i + '" draggable="true" ';
                    html += 'ondragstart="iniciarDrag(event, ' + i + ')" ';
                    html += 'ondragend="finalizarDrag(event)" ';
                    html += 'ondragover="permitirSoltar(event)" ';
                    html += 'ondrop="soltarItem(event, ' + i + ')">';
                    html += '<div class="item-drag-handle"><i class="fas fa-grip-vertical"></i></div>';
                    html += '<div class="item-numero">' + numero + '</div>';
                    html += '<div class="item-contenido">';

                    if (item.tipo === 'titulo') {
                        var valorDesc = escapeHTML(item.descripcion || '');
                        html += '<input type="text" class="item-input-titulo" value="' + valorDesc + '" placeholder="Escribe el título..." data-index="' + i + '" data-campo="descripcion">';
                    } else if (item.tipo === 'apu') {
                        var codigoEscapado = escapeHTML(item.codigo || '');
                        var nombreEscapado = escapeHTML(item.nombre || '');
                        var unidadEscapado = escapeHTML(item.unidad || 'und');
                        html += '<span class="item-apu-info">';
                        html += '<strong>' + codigoEscapado + '</strong> - ';
                        html += '<span>' + nombreEscapado + '</span>';
                        html += ' <span class="apu-detalle">(' + unidadEscapado + ')</span>';
                        html += '</span>';
                        html += '<div class="item-apu-params">';
                        html += '<label>Cantidad: <input type="number" class="apu-cantidad" value="' + (item.cantidad || 1) + '" min="0.1" step="0.1" data-index="' + i + '"></label>';
                        html += '<span class="apu-subtotal">Subtotal: $' + Number(subtotal).toLocaleString('es-CO') + '</span>';
                        html += '</div>';
                    } else if (item.tipo === 'subitem') {
                        var valorSub = escapeHTML(item.descripcion || '');
                        html += '<input type="text" class="item-input-subitem" value="' + valorSub + '" placeholder="Escribe el subitem..." data-index="' + i + '" data-campo="descripcion">';
                    }

                    html += '</div>';
                    html += '<div class="item-acciones">';
                    html += '<button type="button" class="btn-insertar" data-index="' + i + '" title="Insertar después">';
                    html += '<i class="fas fa-plus-circle"></i>';
                    html += '</button>';
                    html += '<button type="button" class="btn-eliminar-item" data-index="' + i + '" title="Eliminar">';
                    html += '<i class="fas fa-trash"></i>';
                    html += '</button>';
                    html += '</div>';
                    html += '</div>';
                }

                html += '</div>';
                container.innerHTML = html;

                // === EVENT LISTENERS ===
                var textInputs = container.querySelectorAll('.item-input-titulo, .item-input-subitem');
                for (var t = 0; t < textInputs.length; t++) {
                    (function(input) {
                        var index = parseInt(input.dataset.index);
                        var campo = input.dataset.campo;
                        input.addEventListener('input', function() {
                            actualizarItemDesdeInput(index, campo, this.value);
                        });
                    })(textInputs[t]);
                }

                var cantidadInputs = container.querySelectorAll('.apu-cantidad');
                for (var c = 0; c < cantidadInputs.length; c++) {
                    (function(input) {
                        var index = parseInt(input.dataset.index);
                        input.addEventListener('change', function() {
                            actualizarCantidadDesdeInput(index, this.value);
                        });
                    })(cantidadInputs[c]);
                }

                var btnInsertar = container.querySelectorAll('.btn-insertar');
                for (var b = 0; b < btnInsertar.length; b++) {
                    (function(btn) {
                        var index = parseInt(btn.dataset.index);
                        btn.addEventListener('click', function() {
                            mostrarMenuInsertar(index);
                        });
                    })(btnInsertar[b]);
                }

                var btnEliminar = container.querySelectorAll('.btn-eliminar-item');
                for (var d = 0; d < btnEliminar.length; d++) {
                    (function(btn) {
                        var index = parseInt(btn.dataset.index);
                        btn.addEventListener('click', function() {
                            eliminarItem(index);
                        });
                    })(btnEliminar[d]);
                }

                calcularTotales();
                actualizarBotonUndo();
            }

            // ===== MENÚ INSERTAR CONTEXTUAL =====
            function mostrarMenuInsertar(index) {
                if (index < 0 || index >= items.length) return;

                var itemActual = items[index];
                var tipoActual = itemActual.tipo;

                var opciones = [];

                if (tipoActual === 'titulo') {
                    opciones.push({ tipo: 'apu', label: 'Agregar APU' });
                } else if (tipoActual === 'apu') {
                    opciones.push({ tipo: 'titulo', label: 'Agregar Título' });
                    opciones.push({ tipo: 'apu', label: 'Agregar APU' });
                    opciones.push({ tipo: 'subitem', label: 'Agregar Subitem' });
                } else if (tipoActual === 'subitem') {
                    opciones.push({ tipo: 'titulo', label: 'Agregar Título' });
                    opciones.push({ tipo: 'apu', label: 'Agregar APU' });
                    opciones.push({ tipo: 'subitem', label: 'Agregar Subitem' });
                }

                if (opciones.length === 0) {
                    alert('No hay opciones disponibles para insertar después de este elemento');
                    return;
                }

                var menuHTML = '<div class="insert-menu-overlay" id="insertMenu">';
                menuHTML += '<div class="insert-menu-box">';
                menuHTML += '<h3>Insertar después</h3>';
                for (var i = 0; i < opciones.length; i++) {
                    menuHTML += '<button type="button" class="btn-insert-option" data-tipo="' + opciones[i].tipo + '">';
                    menuHTML += opciones[i].label;
                    menuHTML += '</button>';
                }
                menuHTML += '<button type="button" class="btn-secondary" id="btnCancelarInsert">Cancelar</button>';
                menuHTML += '</div>';
                menuHTML += '</div>';

                var existing = document.getElementById('insertMenu');
                if (existing) existing.remove();

                document.body.insertAdjacentHTML('beforeend', menuHTML);

                var options = document.querySelectorAll('#insertMenu .btn-insert-option');
                for (var j = 0; j < options.length; j++) {
                    (function(btn) {
                        var tipo = btn.dataset.tipo;
                        btn.addEventListener('click', function() {
                            if (tipo === 'apu') {
                                cerrarInsertMenu();
                                posicionInsertarAPU = index + 1;
                                abrirSelectorAPU();
                            } else {
                                insertarItemTipo(index, tipo);
                            }
                        });
                    })(options[j]);
                }

                document.getElementById('btnCancelarInsert').addEventListener('click', function() {
                    cerrarInsertMenu();
                });
            }

            function cerrarInsertMenu() {
                var menu = document.getElementById('insertMenu');
                if (menu) menu.remove();
            }

            // ===== INSERTAR ITEM POR TIPO =====
            function insertarItemTipo(index, tipo) {
                cerrarInsertMenu();

                if (tipo === 'titulo') {
                    items.splice(index + 1, 0, {
                        id: ++counterId,
                        tipo: 'titulo',
                        descripcion: '',
                        numero: ''
                    });
                    guardarEstado();
                    renderizarItems();
                    setTimeout(function() {
                        var inputs = document.querySelectorAll('.item-input-titulo');
                        if (inputs.length > 0) {
                            inputs[inputs.length - 1].focus();
                        }
                    }, 200);
                } else if (tipo === 'subitem') {
                    var padreAPU = null;
                    for (var k = index; k >= 0; k--) {
                        if (items[k].tipo === 'apu') {
                            padreAPU = items[k].numero || '';
                            break;
                        }
                    }
                    if (!padreAPU) {
                        for (var l = items.length - 1; l >= 0; l--) {
                            if (items[l].tipo === 'apu') {
                                padreAPU = items[l].numero || '';
                                break;
                            }
                        }
                    }
                    if (!padreAPU) {
                        alert('Debe haber un APU antes del Subitem');
                        return;
                    }
                    items.splice(index + 1, 0, {
                        id: ++counterId,
                        tipo: 'subitem',
                        descripcion: '',
                        numero: '',
                        padreAPU: padreAPU
                    });
                    guardarEstado();
                    renderizarItems();
                    setTimeout(function() {
                        var inputs = document.querySelectorAll('.item-input-subitem');
                        if (inputs.length > 0) {
                            inputs[inputs.length - 1].focus();
                        }
                    }, 200);
                }
            }

            // ============================================================
            // ===== SELECTOR DE APU (MÚLTIPLES) =====
            // ============================================================
            
            function abrirSelectorAPU() {
                cargarAPUs();
                apusSeleccionadosTemp = [];
                apusFiltradosSelector = apusData.slice();
                renderizarListaAPUSelector();
                document.getElementById('modalSeleccionarAPU').style.display = 'flex';
            }

            function cerrarSelectorAPU() {
                document.getElementById('modalSeleccionarAPU').style.display = 'none';
                posicionInsertarAPU = null;
            }

            function filtrarAPUSelector() {
                var busqueda = document.getElementById('buscarAPUSelector').value.toLowerCase().trim();
                if (busqueda === '') {
                    apusFiltradosSelector = apusData.slice();
                } else {
                    apusFiltradosSelector = apusData.filter(function(a) {
                        return a.codigo.toLowerCase().includes(busqueda) || 
                               a.nombre.toLowerCase().includes(busqueda) ||
                               (a.categoria && a.categoria.toLowerCase().includes(busqueda));
                    });
                }
                renderizarListaAPUSelector();
            }

            function renderizarListaAPUSelector() {
                var container = document.getElementById('listaAPUSelector');
                if (!container) return;

                if (apusFiltradosSelector.length === 0) {
                    container.innerHTML = '<div class="selector-vacio">No hay APU disponibles</div>';
                } else {
                    var html = '';
                    for (var i = 0; i < apusFiltradosSelector.length; i++) {
                        var a = apusFiltradosSelector[i];
                        var seleccionado = apusSeleccionadosTemp.some(function(s) {
                            return s.id === a.id;
                        });
                        var valorFormateado = '$' + Number(a.valor || 0).toLocaleString('es-CO');
                        var claseSeleccionado = seleccionado ? 'seleccionado' : '';
                        
                        html += '<div class="apu-item-selector ' + claseSeleccionado + '" data-id="' + a.id + '" onclick="toggleAPUSeleccionado(' + a.id + ')">';
                        html += '<input type="checkbox" ' + (seleccionado ? 'checked' : '') + ' onclick="event.stopPropagation(); toggleAPUSeleccionado(' + a.id + ')">';
                        html += '<div class="apu-info">';
                        html += '<span class="apu-codigo">' + a.codigo + '</span>';
                        html += '<span class="apu-nombre">' + a.nombre + '</span>';
                        if (a.categoria) {
                            html += '<span class="apu-categoria">' + a.categoria + '</span>';
                        }
                        html += '<span class="apu-valor">' + valorFormateado + '</span>';
                        html += '</div>';
                        html += '</div>';
                    }
                    container.innerHTML = html;
                }

                document.getElementById('apuContadorSelector').textContent = apusFiltradosSelector.length + ' APU';
                document.getElementById('apuSeleccionadosContador').textContent = apusSeleccionadosTemp.length + ' APU seleccionados';
            }

            function toggleAPUSeleccionado(id) {
                var index = -1;
                for (var i = 0; i < apusSeleccionadosTemp.length; i++) {
                    if (apusSeleccionadosTemp[i].id === id) {
                        index = i;
                        break;
                    }
                }
                if (index === -1) {
                    var apu = null;
                    for (var j = 0; j < apusData.length; j++) {
                        if (apusData[j].id === id) {
                            apu = apusData[j];
                            break;
                        }
                    }
                    if (apu) {
                        apusSeleccionadosTemp.push({
                            id: apu.id,
                            codigo: apu.codigo || '',
                            nombre: apu.nombre || '',
                            unidad: apu.unidad || 'und',
                            valorUnitario: apu.valor || 0,
                            cantidad: 1
                        });
                    }
                } else {
                    apusSeleccionadosTemp.splice(index, 1);
                }
                renderizarListaAPUSelector();
            }

            function seleccionarTodosAPU() {
                apusSeleccionadosTemp = [];
                for (var i = 0; i < apusFiltradosSelector.length; i++) {
                    var a = apusFiltradosSelector[i];
                    apusSeleccionadosTemp.push({
                        id: a.id,
                        codigo: a.codigo || '',
                        nombre: a.nombre || '',
                        unidad: a.unidad || 'und',
                        valorUnitario: a.valor || 0,
                        cantidad: 1
                    });
                }
                renderizarListaAPUSelector();
            }

            function deseleccionarTodosAPU() {
                apusSeleccionadosTemp = [];
                renderizarListaAPUSelector();
            }

            function agregarAPUSeleccionados() {
                if (apusSeleccionadosTemp.length === 0) {
                    alert('Selecciona al menos un APU');
                    return;
                }

                var posicion = posicionInsertarAPU !== null ? posicionInsertarAPU : items.length;
                
                for (var i = 0; i < apusSeleccionadosTemp.length; i++) {
                    var apu = apusSeleccionadosTemp[i];
                    items.splice(posicion + i, 0, {
                        id: ++counterId,
                        tipo: 'apu',
                        apuId: apu.id,
                        codigo: apu.codigo,
                        nombre: apu.nombre,
                        unidad: apu.unidad,
                        valorUnitario: apu.valorUnitario,
                        cantidad: apu.cantidad || 1,
                        numero: '',
                        padreTitulo: null
                    });
                }

                guardarEstado();
                renderizarItems();
                cerrarSelectorAPU();
                posicionInsertarAPU = null;
                mostrarNotificacion('✅ ' + apusSeleccionadosTemp.length + ' APU(s) agregados');
            }

            // ===== ELIMINAR ITEM =====
            function eliminarItem(index) {
                if (index >= 0 && index < items.length) {
                    if (confirm('¿Eliminar este item?')) {
                        items.splice(index, 1);
                        guardarEstado();
                        renderizarItems();
                    }
                }
            }

            // ===== CARGAR COTIZACIONES =====
            function cargarCotizaciones() {
                try {
                    var data = localStorage.getItem('cotizaciones');
                    if (data) {
                        cotizaciones = JSON.parse(data);
                    } else {
                        cotizaciones = [];
                    }
                } catch (e) {
                    cotizaciones = [];
                }
                renderizarTabla();
            }

            function guardarCotizaciones() {
                localStorage.setItem('cotizaciones', JSON.stringify(cotizaciones));
                renderizarTabla();
            }

            function renderizarTabla() {
                var tbody = document.getElementById('cuerpoTabla');
                var sinDatos = document.getElementById('sinDatos');
                var tabla = document.getElementById('tablaCotizaciones');

                if (!tbody) return;

                if (!cotizaciones || !Array.isArray(cotizaciones)) {
                    cotizaciones = [];
                }

                if (cotizaciones.length === 0) {
                    tbody.innerHTML = '';
                    if (sinDatos) sinDatos.style.display = 'block';
                    if (tabla) tabla.style.display = 'none';
                    return;
                }

                if (sinDatos) sinDatos.style.display = 'none';
                if (tabla) tabla.style.display = 'table';

                var html = '';
                for (var i = 0; i < cotizaciones.length; i++) {
                    var c = cotizaciones[i];
                    var valorFormateado = '$' + Number(c.valorTotalFinal || c.valorTotal || 0).toLocaleString('es-CO');
                    html += '<tr>';
                    html += '<td><strong>' + (c.numero || '-') + '</strong></td>';
                    html += '<td>' + (c.cliente || '-') + '</td>';
                    html += '<td>' + (c.tipo || '-') + '</td>';
                    html += '<td>' + (c.proyecto || '-') + '</td>';
                    var objetivo = c.objetivo || '';
                    html += '<td>' + (objetivo.substring(0, 30) + (objetivo.length > 30 ? '...' : '')) + '</td>';
                    html += '<td>' + valorFormateado + '</td>';
                    html += '<td>';
                    html += '<button class="btn-edit" onclick="editarCotizacion(' + c.id + ')">';
                    html += '<i class="fas fa-edit"></i>';
                    html += '</button>';
                    html += '<button class="btn-delete" onclick="eliminarCotizacion(' + c.id + ')">';
                    html += '<i class="fas fa-trash"></i>';
                    html += '</button>';
                    html += '<button class="btn-pdf" onclick="exportarPDF(' + c.id + ')">';
                    html += '<i class="fas fa-file-pdf"></i>';
                    html += '</button>';
                    html += '</td>';
                    html += '</tr>';
                }
                tbody.innerHTML = html;
            }

            // ============================================================
            // ===== EXPORTAR COTIZACIÓN A PDF =====
            // ============================================================
            
            function exportarPDF(id) {
                var notificacion = document.createElement('div');
                notificacion.className = 'notification';
                notificacion.textContent = '⏳ Generando PDF...';
                document.body.appendChild(notificacion);
                setTimeout(function() { notificacion.classList.add('show'); }, 100);

                var cotizacion = null;
                for (var i = 0; i < cotizaciones.length; i++) {
                    if (cotizaciones[i].id === id) {
                        cotizacion = cotizaciones[i];
                        break;
                    }
                }

                if (!cotizacion) {
                    notificacion.classList.remove('show');
                    setTimeout(function() { notificacion.remove(); }, 300);
                    mostrarNotificacion('❌ Cotización no encontrada');
                    return;
                }

                // Obtener datos de la empresa
                var empresaData = null;
                try {
                    var data = localStorage.getItem('empresaInfo');
                    if (data) {
                        empresaData = JSON.parse(data);
                    }
                } catch (e) {
                    empresaData = null;
                }

                // Construir datos para el PDF
                var pdfData = {
                    cotizacion: cotizacion,
                    empresa: empresaData || {
                        nombre: 'Mi Empresa',
                        nit: '',
                        telefono: '',
                        email: '',
                        direccion: '',
                        web: '',
                        logo: ''
                    },
                    fecha: new Date().toISOString()
                };

                // Enviar al servidor para generar el PDF
                fetch('/api/cotizacion-pdf', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(pdfData)
                })
                .then(function(response) {
                    if (!response.ok) {
                        return response.json().then(function(err) {
                            throw new Error(err.error || 'Error al generar PDF');
                        });
                    }
                    return response.blob();
                })
                .then(function(blob) {
                    var url = window.URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = 'Cotizacion_' + (cotizacion.numero || 'COT-' + cotizacion.id) + '_' + new Date().toISOString().slice(0,10) + '.pdf';
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    a.remove();
                    notificacion.classList.remove('show');
                    setTimeout(function() { notificacion.remove(); }, 300);
                    mostrarNotificacion('✅ PDF generado correctamente');
                })
                .catch(function(error) {
                    notificacion.classList.remove('show');
                    setTimeout(function() { notificacion.remove(); }, 300);
                    mostrarNotificacion('❌ Error: ' + error.message);
                });
            }

            // ===== MODAL =====
            function abrirModal(cotizacion) {
                var modal = document.getElementById('modalCotizacion');
                var form = document.getElementById('formCotizacion');
                var titulo = document.getElementById('modalTitulo');

                if (!modal) return;

                items = [];
                counterId = 0;
                historial = [];
                renderizarItems();

                cargarAPUs();

                var ultimo = obtenerUltimoNumero();
                document.getElementById('ultimoNumero').textContent = ultimo;

                document.getElementById('adminPorcentaje').value = 0;
                document.getElementById('imprevistosPorcentaje').value = 0;
                document.getElementById('utilidadPorcentaje').value = 0;
                document.getElementById('ivaPorcentaje').value = 0;

                document.querySelectorAll('.toggle-ajuste').forEach(function(el) {
                    el.checked = true;
                });

                if (!cotizacion) {
                    items.push({
                        id: ++counterId,
                        tipo: 'titulo',
                        descripcion: '',
                        numero: ''
                    });
                    guardarEstado();
                    renderizarItems();
                    setTimeout(function() {
                        var inputs = document.querySelectorAll('.item-input-titulo');
                        if (inputs.length > 0) {
                            inputs[0].focus();
                        }
                    }, 200);
                }

                if (cotizacion) {
                    titulo.textContent = 'Editar Cotización';
                    document.getElementById('numero').value = cotizacion.numero || '';
                    document.getElementById('cliente').value = cotizacion.cliente || '';
                    document.getElementById('tipo').value = cotizacion.tipo || '';
                    document.getElementById('proyecto').value = cotizacion.proyecto || '';
                    document.getElementById('objetivo').value = cotizacion.objetivo || '';
                    document.getElementById('direccion').value = cotizacion.direccion || '';
                    editandoId = cotizacion.id;

                    if (cotizacion.ajustes) {
                        var a = cotizacion.ajustes;
                        document.getElementById('adminPorcentaje').value = a.adminPorc || 0;
                        document.getElementById('imprevistosPorcentaje').value = a.imprevistosPorc || 0;
                        document.getElementById('utilidadPorcentaje').value = a.utilidadPorc || 0;
                        document.getElementById('ivaPorcentaje').value = a.ivaPorc || 0;
                        if (a.adminActivo !== undefined) {
                            document.querySelector('.toggle-ajuste[data-ajuste="admin"]').checked = a.adminActivo;
                        }
                        if (a.imprevistosActivo !== undefined) {
                            document.querySelector('.toggle-ajuste[data-ajuste="imprevistos"]').checked = a.imprevistosActivo;
                        }
                        if (a.utilidadActivo !== undefined) {
                            document.querySelector('.toggle-ajuste[data-ajuste="utilidad"]').checked = a.utilidadActivo;
                        }
                        if (a.ivaActivo !== undefined) {
                            document.querySelector('.toggle-ajuste[data-ajuste="iva"]').checked = a.ivaActivo;
                        }
                    }

                    if (cotizacion.items && cotizacion.items.length > 0) {
                        items = cotizacion.items;
                        for (var i = 0; i < items.length; i++) {
                            if (!items[i].id) {
                                items[i].id = ++counterId;
                            }
                            if (counterId < items[i].id) {
                                counterId = items[i].id;
                            }
                        }
                        guardarEstado();
                        renderizarItems();
                    }
                } else {
                    titulo.textContent = 'Nueva Cotización';
                    form.reset();
                    document.getElementById('numero').value = '';
                    editandoId = null;
                }

                document.querySelectorAll('.toggle-ajuste').forEach(function(el) {
                    el.addEventListener('change', function() {
                        calcularTotales();
                    });
                });

                calcularTotales();
                modal.style.display = 'flex';
                actualizarBotonUndo();
            }

            function cerrarModal() {
                var modal = document.getElementById('modalCotizacion');
                if (modal) modal.style.display = 'none';
                var form = document.getElementById('formCotizacion');
                if (form) form.reset();
                editandoId = null;
                items = [];
                historial = [];
                renderizarItems();
                cerrarSelectorAPU();
                cerrarInsertMenu();
                actualizarBotonUndo();
            }

            // ===== CRUD =====
            document.addEventListener('DOMContentLoaded', function() {
                cargarCotizaciones();
                cargarAPUs();

                var form = document.getElementById('formCotizacion');
                if (form) {
                    form.addEventListener('submit', function(e) {
                        e.preventDefault();

                        var numero = document.getElementById('numero').value.trim();
                        var cliente = document.getElementById('cliente').value.trim();
                        var tipo = document.getElementById('tipo').value;
                        var proyecto = document.getElementById('proyecto').value.trim();
                        var objetivo = document.getElementById('objetivo').value.trim();
                        var direccion = document.getElementById('direccion').value.trim();

                        if (!cliente || !tipo || !proyecto) {
                            alert('Por favor, completa todos los campos obligatorios (*)');
                            return;
                        }

                        if (items.length === 0) {
                            alert('Debes agregar al menos un Título');
                            return;
                        }

                        var ajustes = window._ajustes || {
                            adminPorc: 0,
                            imprevistosPorc: 0,
                            utilidadPorc: 0,
                            ivaPorc: 0,
                            adminActivo: true,
                            imprevistosActivo: true,
                            utilidadActivo: true,
                            ivaActivo: true,
                            adminValor: 0,
                            imprevistosValor: 0,
                            utilidadValor: 0,
                            ivaValor: 0,
                            subtotal: 0,
                            totalFinal: 0
                        };

                        var numeroFinal = numero;
                        if (!numeroFinal) {
                            var ultimo = obtenerUltimoNumero();
                            if (ultimo !== '-') {
                                var match = ultimo.match(/(\d+)$/);
                                if (match) {
                                    var num = parseInt(match[1]) + 1;
                                    var prefijo = ultimo.replace(/\d+$/, '');
                                    numeroFinal = prefijo + String(num).padStart(3, '0');
                                } else {
                                    numeroFinal = 'COT-001';
                                }
                            } else {
                                numeroFinal = 'COT-001';
                            }
                        }

                        var cotizacionData = {
                            numero: numeroFinal,
                            cliente: cliente,
                            tipo: tipo,
                            proyecto: proyecto,
                            objetivo: objetivo,
                            direccion: direccion,
                            valorTotal: ajustes.subtotal || 0,
                            valorTotalFinal: ajustes.totalFinal || 0,
                            items: items,
                            ajustes: ajustes
                        };

                        if (editandoId !== null) {
                            var index = -1;
                            for (var k = 0; k < cotizaciones.length; k++) {
                                if (cotizaciones[k].id === editandoId) {
                                    index = k;
                                    break;
                                }
                            }
                            if (index !== -1) {
                                cotizaciones[index] = { id: editandoId };
                                for (var key in cotizacionData) {
                                    cotizaciones[index][key] = cotizacionData[key];
                                }
                            }
                        } else {
                            var nuevoId = 1;
                            if (cotizaciones.length > 0) {
                                var maxId = 0;
                                for (var m = 0; m < cotizaciones.length; m++) {
                                    if (cotizaciones[m].id > maxId) {
                                        maxId = cotizaciones[m].id;
                                    }
                                }
                                nuevoId = maxId + 1;
                            }
                            cotizaciones.push({ id: nuevoId });
                            var ultimoIndex = cotizaciones.length - 1;
                            for (var key2 in cotizacionData) {
                                cotizaciones[ultimoIndex][key2] = cotizacionData[key2];
                            }
                        }

                        guardarCotizaciones();
                        cerrarModal();
                        var mensaje = editandoId !== null ? 'Cotización actualizada' : 'Cotización creada';
                        mostrarNotificacion(mensaje);
                        editandoId = null;
                    });
                }
            });

            function editarCotizacion(id) {
                var cotizacion = null;
                for (var i = 0; i < cotizaciones.length; i++) {
                    if (cotizaciones[i].id === id) {
                        cotizacion = cotizaciones[i];
                        break;
                    }
                }
                if (cotizacion) {
                    abrirModal(cotizacion);
                }
            }

            function eliminarCotizacion(id) {
                if (confirm('¿Estás seguro de eliminar esta cotización?')) {
                    var nuevasCotizaciones = [];
                    for (var i = 0; i < cotizaciones.length; i++) {
                        if (cotizaciones[i].id !== id) {
                            nuevasCotizaciones.push(cotizaciones[i]);
                        }
                    }
                    cotizaciones = nuevasCotizaciones;
                    guardarCotizaciones();
                    mostrarNotificacion('Cotización eliminada');
                }
            }

            // ===== BORRAR CACHÉ =====
            function borrarCache() {
                if (confirm('⚠️ ¿Estás seguro de borrar TODOS los datos guardados? Esta acción no se puede deshacer.')) {
                    localStorage.clear();
                    cotizaciones = [];
                    guardarCotizaciones();
                    mostrarNotificacion('🗑️ Caché borrada correctamente');
                }
            }

            // ===== NOTIFICACIONES =====
            function mostrarNotificacion(mensaje) {
                var notificacion = document.createElement('div');
                notificacion.className = 'notification';
                notificacion.textContent = mensaje;
                document.body.appendChild(notificacion);
                setTimeout(function() {
                    notificacion.classList.add('show');
                }, 100);
                setTimeout(function() {
                    notificacion.classList.remove('show');
                    setTimeout(function() {
                        notificacion.remove();
                    }, 300);
                }, 3000);
            }

            window.onclick = function(event) {
                var modal = document.getElementById('modalCotizacion');
                if (event.target === modal) {
                    cerrarModal();
                }
                var selector = document.getElementById('modalSeleccionarAPU');
                if (event.target === selector) {
                    cerrarSelectorAPU();
                }
                var menu = document.getElementById('insertMenu');
                if (event.target === menu) {
                    cerrarInsertMenu();
                }
            };
        </script>
    `
