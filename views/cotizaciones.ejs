<%- include('layouts/main', { 
    title: 'Listado de Cotizaciones',
    usuario: usuario,
    body: `
        <div class="page-header">
            <h1>Listado de Cotizaciones</h1>
            <div style="display:flex; gap:12px; flex-wrap:wrap;">
                <button class="btn-primary" onclick="abrirModal()">
                    <i class="fas fa-plus"></i> Crear Cotización
                </button>
            </div>
        </div>

        <section class="table-container">
            <table class="data-table" id="tablaCotizaciones">
                <thead>
                    <tr>
                        <th>N° Cotización</th>
                        <th>Cliente</th>
                        <th>Tipo</th>
                        <th>Proyecto</th>
                        <th>Objetivo</th>
                        <th>Valor Total</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="cuerpoTabla"></tbody>
            </table>
            <div id="sinDatos" class="empty-state">
                <i class="fas fa-file-invoice"></i>
                <p>No hay cotizaciones registradas</p>
                <button class="btn-primary" onclick="abrirModal()">
                    <i class="fas fa-plus"></i> Crear primera cotización
                </button>
            </div>
        </section>

        <div id="modalCotizacion" class="modal modal-cotizacion">
            <div class="modal-content modal-content-cotizacion">
                <div class="modal-header">
                    <h2 id="modalTitulo">Nueva Cotización</h2>
                    <span class="close" onclick="cerrarModal()">&times;</span>
                </div>
                <form id="formCotizacion">
                    <div class="form-row">
                        <div class="form-group half">
                            <label for="numero">N° Cotización</label>
                            <input type="text" id="numero" placeholder="Ej: COT-001">
                            <div id="numeroAnterior" style="font-size:12px; color:var(--gray-600); margin-top:4px;">
                                Último número usado: <span id="ultimoNumero">-</span>
                            </div>
                        </div>
                        <div class="form-group half">
                            <label for="tipo">Tipo de Cotización *</label>
                            <select id="tipo" class="form-select" required>
                                <option value="">-- Seleccionar --</option>
                                <option value="Obra">Obra</option>
                                <option value="Servicio">Servicio</option>
                                <option value="Mantenimiento">Mantenimiento</option>
                                <option value="Suministro">Suministro</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group half">
                            <label for="cliente">Cliente *</label>
                            <input type="text" id="cliente" placeholder="Ej: Constructora ABC" required>
                        </div>
                        <div class="form-group half">
                            <label for="proyecto">Proyecto *</label>
                            <input type="text" id="proyecto" placeholder="Ej: Edificio Torre Central" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="objetivo">Objetivo</label>
                        <textarea id="objetivo" rows="2" placeholder="Ej: Construcción de estructura de 10 pisos" style="width:100%; padding:10px 14px; border:1px solid var(--gray-200); border-radius:8px; font-size:14px; font-family:inherit; resize:vertical;"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="direccion">Dirección</label>
                        <input type="text" id="direccion" placeholder="Ej: Calle 123 #45-67">
                    </div>

                    <hr class="form-divider">

                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <h3 class="section-title" style="margin: 0;"><i class="fas fa-list"></i> Items de Cotización</h3>
                        <button type="button" class="btn-undo" id="btnUndo" onclick="undoAction()" title="Deshacer última acción">
                            <i class="fas fa-undo"></i> Deshacer
                        </button>
                    </div>

                    <div id="listaItems" class="items-container">
                        <div class="empty-items">No hay items agregados. Comienza agregando un Título.</div>
                    </div>

                    <hr class="form-divider">

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
                        <div>
                            <h3 class="section-title"><i class="fas fa-calculator"></i> Ajustes</h3>

                            <div class="subtotal-row">
                                <div class="subtotal-label">Subtotal</div>
                                <div class="subtotal-value" id="subtotalDisplay">$0</div>
                            </div>

                            <div class="ajuste-row">
                                <div class="ajuste-info">
                                    <label class="toggle-label-mini">
                                        <input type="checkbox" class="toggle-ajuste" data-ajuste="admin" checked>
                                        <span class="toggle-slider-mini"></span>
                                    </label>
                                    <span class="ajuste-nombre">Administración</span>
                                    <span class="ajuste-porcentaje">(%)</span>
                                </div>
                                <input type="number" class="ajuste-input" id="adminPorcentaje" value="0" min="0" step="0.1" oninput="calcularTotales()">
                                <span class="ajuste-valor" id="adminValor">$0</span>
                            </div>

                            <div class="ajuste-row">
                                <div class="ajuste-info">
                                    <label class="toggle-label-mini">
                                        <input type="checkbox" class="toggle-ajuste" data-ajuste="imprevistos" checked>
                                        <span class="toggle-slider-mini"></span>
                                    </label>
                                    <span class="ajuste-nombre">Imprevistos</span>
                                    <span class="ajuste-porcentaje">(%)</span>
                                </div>
                                <input type="number" class="ajuste-input" id="imprevistosPorcentaje" value="0" min="0" step="0.1" oninput="calcularTotales()">
                                <span class="ajuste-valor" id="imprevistosValor">$0</span>
                            </div>

                            <div class="ajuste-row">
                                <div class="ajuste-info">
                                    <label class="toggle-label-mini">
                                        <input type="checkbox" class="toggle-ajuste" data-ajuste="utilidad" checked>
                                        <span class="toggle-slider-mini"></span>
                                    </label>
                                    <span class="ajuste-nombre">Utilidad</span>
                                    <span class="ajuste-porcentaje">(%)</span>
                                </div>
                                <input type="number" class="ajuste-input" id="utilidadPorcentaje" value="0" min="0" step="0.1" oninput="calcularTotales()">
                                <span class="ajuste-valor" id="utilidadValor">$0</span>
                            </div>

                            <div class="ajuste-row iva-row">
                                <div class="ajuste-info">
                                    <label class="toggle-label-mini">
                                        <input type="checkbox" class="toggle-ajuste" data-ajuste="iva" checked>
                                        <span class="toggle-slider-mini"></span>
                                    </label>
                                    <span class="ajuste-nombre">IVA</span>
                                    <span class="ajuste-porcentaje">(%)</span>
                                    <span class="ajuste-nota">(sobre Utilidad)</span>
                                </div>
                                <input type="number" class="ajuste-input" id="ivaPorcentaje" value="0" min="0" step="0.1" oninput="calcularTotales()">
                                <span class="ajuste-valor" id="ivaValor">$0</span>
                            </div>
                        </div>

                        <div>
                            <h3 class="section-title"><i class="fas fa-file-invoice"></i> Resumen</h3>
                            <div class="total-container final-total" style="margin-top:10px;">
                                <div class="total-label">Valor Total Cotización:</div>
                                <div class="total-value" id="valorTotalFinal">$0</div>
                            </div>
                        </div>
                    </div>

                    <hr class="form-divider">

                    <div class="form-actions">
                        <button type="button" class="btn-secondary" onclick="cerrarModal()">Cancelar</button>
                        <button type="submit" class="btn-primary">Guardar Cotización</button>
                    </div>
                </form>
            </div>
        </div>

        <div id="modalSeleccionarAPU" class="modal modal-grande">
            <div class="modal-content" style="max-width:700px;">
                <div class="modal-header">
                    <h2><i class="fas fa-table"></i> Seleccionar APU</h2>
                    <span class="close" onclick="cerrarSelectorAPU()">&times;</span>
                </div>
                <div style="padding:10px 0;">
                    <p style="color:var(--gray-600); margin-bottom:12px;">Selecciona los APU que deseas agregar a la cotización:</p>
                    
                    <div style="display:flex; gap:10px; margin-bottom:12px;">
                        <input type="text" id="buscarAPUSelector" placeholder="Buscar APU por nombre o código..." style="flex:1; padding:8px 12px; border:1px solid var(--gray-200); border-radius:6px; font-size:14px;" oninput="filtrarAPUSelector()">
                        <span id="apuContadorSelector" style="display:flex; align-items:center; color:var(--gray-600); font-size:13px;">0 APU</span>
                    </div>

                    <div id="listaAPUSelector" style="max-height:350px; overflow-y:auto; border:1px solid var(--gray-200); border-radius:6px; padding:4px;">
                        <p class="empty-items">Cargando APU...</p>
                    </div>

                    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:12px; gap:10px; flex-wrap:wrap;">
                        <div style="display:flex; gap:6px;">
                            <button class="btn-sm" onclick="seleccionarTodosAPU()" style="color:var(--primary); border-color:var(--primary);">Seleccionar todos</button>
                            <button class="btn-sm" onclick="deseleccionarTodosAPU()" style="color:var(--danger); border-color:var(--danger);">Deseleccionar todos</button>
                        </div>
                        <span id="apuSeleccionadosContador" style="font-size:14px; color:var(--primary); font-weight:600;">0 APU seleccionados</span>
                    </div>

                    <div style="display:flex; gap:12px; margin-top:16px; justify-content:flex-end; border-top:1px solid var(--gray-200); padding-top:16px;">
                        <button class="btn-secondary" onclick="cerrarSelectorAPU()">Cancelar</button>
                        <button class="btn-primary" onclick="agregarAPUSeleccionados()">
                            <i class="fas fa-plus"></i> Agregar Seleccionados
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <button class="btn-danger btn-cache" onclick="borrarCache()">
            <i class="fas fa-trash"></i> Borrar Todas Mis Cotizaciones
        </button>

        <style>
            .modal-cotizacion .modal-content-cotizacion {
                max-width: 95vw !important;
                width: 95vw !important;
                max-height: 92vh !important;
                padding: 24px 32px !important;
                overflow-y: auto !important;
            }

            .modal-cotizacion .modal-content-cotizacion .form-row {
                display: flex !important;
                gap: 16px !important;
            }
            .modal-cotizacion .modal-content-cotizacion .form-row .form-group.half {
                flex: 1 !important;
            }

            .apu-item-selector {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 8px 12px;
                border-bottom: 1px solid var(--gray-100);
                transition: all 0.2s;
                cursor: pointer;
            }
            .apu-item-selector:hover {
                background: var(--gray-50);
            }
            .apu-item-selector input[type="checkbox"] {
                width: 18px;
                height: 18px;
                cursor: pointer;
                accent-color: var(--primary);
                flex-shrink: 0;
            }
            .apu-item-selector .apu-info {
                flex: 1;
                display: flex;
                flex-wrap: wrap;
                gap: 4px 12px;
            }
            .apu-item-selector .apu-info .apu-codigo {
                font-weight: 600;
                color: var(--gray-900);
            }
            .apu-item-selector .apu-info .apu-nombre {
                color: var(--gray-700);
            }
            .apu-item-selector .apu-info .apu-categoria {
                font-size: 12px;
                color: var(--gray-500);
                background: var(--gray-100);
                padding: 2px 8px;
                border-radius: 4px;
            }
            .apu-item-selector .apu-info .apu-valor {
                font-size: 13px;
                font-weight: 600;
                color: var(--primary);
                margin-left: auto;
            }
            .apu-item-selector.seleccionado {
                background: #e8f4fd;
                border-left: 3px solid var(--primary);
            }

            .btn-pdf {
                background: #dc2626;
                color: white;
                border: none;
                padding: 6px 10px;
                border-radius: 6px;
                cursor: pointer;
                transition: all 0.2s;
                margin-left: 4px;
            }
            .btn-pdf:hover {
                background: #b91c1c;
                transform: scale(1.05);
            }

            @media (max-width: 768px) {
                .modal-cotizacion .modal-content-cotizacion {
                    max-width: 98vw !important;
                    width: 98vw !important;
                    padding: 16px !important;
                    max-height: 95vh !important;
                }
                .modal-cotizacion .modal-content-cotizacion .form-row {
                    flex-direction: column !important;
                    gap: 0 !important;
                }
                .modal-cotizacion .modal-content-cotizacion .form-row .form-group.half {
                    flex: none !important;
                }
                #modalSeleccionarAPU .modal-content {
                    max-width: 95vw !important;
                    width: 95vw !important;
                    padding: 16px !important;
                }
                .apu-item-selector {
                    flex-wrap: wrap !important;
                }
                .apu-item-selector .apu-info {
                    flex-direction: column !important;
                    gap: 2px !important;
                }
                .apu-item-selector .apu-info .apu-valor {
                    margin-left: 0 !important;
                }
                .form-actions {
                    flex-direction: column !important;
                }
                .form-actions button {
                    width: 100% !important;
                }
            }

            .modal-cotizacion .modal-content-cotizacion::-webkit-scrollbar {
                width: 6px;
            }
            .modal-cotizacion .modal-content-cotizacion::-webkit-scrollbar-track {
                background: var(--gray-100);
                border-radius: 10px;
            }
            .modal-cotizacion .modal-content-cotizacion::-webkit-scrollbar-thumb {
                background: var(--primary);
                border-radius: 10px;
            }

            .items-container {
                background: var(--gray-50);
                border-radius: 8px;
                padding: 12px;
                max-height: 400px;
                overflow-y: auto;
                border: 1px solid var(--gray-200);
            }
            .items-list { display: flex; flex-direction: column; gap: 4px; }
            .item-row {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px 12px;
                background: white;
                border-radius: 6px;
                border: 1px solid var(--gray-100);
                transition: all 0.2s;
                cursor: grab;
            }
            .item-row:hover { border-color: var(--primary-light); box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
            .item-row.item-titulo { background: #f0f4f8; border-left: 4px solid var(--primary); }
            .item-row.item-apu { background: #f8fafc; border-left: 4px solid var(--success); }
            .item-row.item-subitem { background: white; border-left: 4px solid var(--warning); margin-left: 20px; }
            .item-drag-handle { color: var(--gray-400); font-size: 14px; cursor: grab; padding: 0 4px; user-select: none; }
            .item-numero { font-weight: 700; color: var(--gray-600); font-size: 13px; min-width: 60px; font-family: monospace; }
            .item-contenido { flex: 1; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
            .item-input-titulo { flex: 1; border: none; background: transparent; font-size: 14px; font-weight: 600; color: var(--gray-900); padding: 4px 0; font-family: inherit; min-width: 100px; }
            .item-input-titulo:focus { outline: none; border-bottom: 2px solid var(--primary); }
            .item-input-subitem { flex: 1; border: none; background: transparent; font-size: 14px; color: var(--gray-900); padding: 4px 0; font-family: inherit; min-width: 100px; }
            .item-input-subitem:focus { outline: none; border-bottom: 2px solid var(--warning); }
            .item-apu-info { flex: 1; font-size: 14px; color: var(--gray-900); }
            .item-apu-info strong { color: var(--primary); }
            .apu-detalle { color: var(--gray-600); font-size: 12px; }
            .item-apu-params { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
            .item-apu-params label { display: flex; align-items: center; gap: 4px; font-size: 13px; font-weight: 500; color: var(--gray-600); }
            .apu-cantidad { width: 60px; padding: 2px 6px; border: 1px solid var(--gray-200); border-radius: 4px; font-size: 13px; text-align: center; }
            .apu-subtotal { font-size: 13px; font-weight: 600; color: var(--success); }
            .item-acciones { display: flex; gap: 4px; }
            .btn-insertar { background: transparent; border: none; color: var(--gray-400); cursor: pointer; padding: 4px 6px; border-radius: 4px; font-size: 16px; transition: all 0.2s; }
            .btn-insertar:hover { color: var(--primary); background: rgba(37, 99, 235, 0.1); }
            .btn-eliminar-item { background: transparent; border: none; color: var(--gray-400); cursor: pointer; padding: 4px 6px; border-radius: 4px; font-size: 14px; transition: all 0.2s; }
            .btn-eliminar-item:hover { color: var(--danger); background: rgba(239, 68, 68, 0.1); }

            .insert-menu-overlay {
                position: fixed; top: 0; left: 0; right: 0; bottom: 0;
                background: rgba(0,0,0,0.3); display: flex; align-items: center; justify-content: center; z-index: 2000;
            }
            .insert-menu-box { background: white; border-radius: 12px; padding: 24px; min-width: 250px; box-shadow: var(--shadow-lg); }
            .insert-menu-box h3 { margin-bottom: 12px; font-size: 16px; text-align: center; }
            .btn-insert-option {
                display: block; width: 100%; padding: 10px 16px; margin-bottom: 6px;
                border: 1px solid var(--gray-200); border-radius: 8px; background: white;
                cursor: pointer; font-size: 14px; font-weight: 500; transition: all 0.2s; text-align: left;
            }
            .btn-insert-option:hover { background: var(--primary); color: white; border-color: var(--primary); }
            .insert-menu-box .btn-secondary { width: 100%; margin-top: 8px; justify-content: center; }

            .subtotal-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: var(--gray-50); border-radius: 8px; margin-bottom: 12px; border: 1px solid var(--gray-200); }
            .subtotal-label { font-size: 16px; font-weight: 700; color: var(--gray-900); }
            .subtotal-value { font-size: 18px; font-weight: 700; color: var(--primary); }

            .ajuste-row { display: flex; align-items: center; gap: 12px; padding: 8px 16px; margin-bottom: 6px; background: white; border-radius: 6px; border: 1px solid var(--gray-100); transition: all 0.2s; }
            .ajuste-row:hover { border-color: var(--gray-200); }
            .ajuste-row.iva-row { border-color: var(--gray-200); background: var(--gray-50); }
            .ajuste-info { display: flex; align-items: center; gap: 8px; flex: 1; min-width: 150px; }
            .ajuste-nombre { font-size: 14px; font-weight: 500; color: var(--gray-900); }
            .ajuste-porcentaje { font-size: 12px; color: var(--gray-600); }
            .ajuste-nota { font-size: 11px; color: var(--gray-500); font-style: italic; }
            .ajuste-input { width: 70px; padding: 4px 8px; border: 1px solid var(--gray-200); border-radius: 4px; font-size: 14px; text-align: center; font-weight: 600; }
            .ajuste-valor { font-size: 14px; font-weight: 600; color: var(--gray-900); min-width: 100px; text-align: right; }

            .toggle-label-mini { display: flex; align-items: center; cursor: pointer; margin: 0; }
            .toggle-label-mini input { display: none; }
            .toggle-slider-mini { position: relative; width: 32px; height: 18px; background: var(--gray-200); border-radius: 10px; transition: all 0.3s; flex-shrink: 0; }
            .toggle-slider-mini::after { content: ''; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; background: white; border-radius: 50%; transition: all 0.3s; box-shadow: var(--shadow); }
            .toggle-label-mini input:checked + .toggle-slider-mini { background: var(--primary); }
            .toggle-label-mini input:checked + .toggle-slider-mini::after { transform: translateX(14px); }

            .final-total { background: var(--primary); border-radius: 8px; padding: 16px 24px; }
            .final-total .total-label { color: white; font-size: 20px; }
            .final-total .total-value { color: white; font-size: 28px; font-weight: 700; }

            @media (max-width: 768px) {
                .ajuste-row { flex-wrap: wrap; gap: 6px; padding: 10px 12px; }
                .ajuste-info { min-width: 100%; flex: 0 0 100%; }
                .ajuste-input { flex: 1; width: 60px; }
                .ajuste-valor { min-width: 80px; }
                .subtotal-row { flex-direction: column; text-align: center; gap: 4px; }
                .final-total { flex-direction: column; text-align: center; gap: 8px; }
                .final-total .total-value { font-size: 22px; }
                .item-row { flex-wrap: wrap; padding: 10px; }
                .item-numero { min-width: 40px; font-size: 12px; }
                .item-apu-params { width: 100%; justify-content: flex-start; }
                .item-acciones { width: 100%; justify-content: flex-end; }
                .item-drag-handle { display: none; }
            }

            .btn-undo { background: var(--gray-100); border: 1px solid var(--gray-200); color: var(--gray-900); padding: 6px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s; }
            .btn-undo:hover { background: var(--primary); color: white; border-color: var(--primary); transform: translateY(-2px); box-shadow: var(--shadow); }
            .btn-print { background: #10b981; color: white; border: none; padding: 6px 10px; border-radius: 6px; cursor: pointer; transition: all 0.2s; margin-left: 4px; }
            .btn-print:hover { background: #059669; transform: scale(1.05); }
        </style>

        <script>
            var cotizaciones = [];
            var editandoId = null;
            var apusData = [];
            var items = [];
            var counterId = 0;
            var historial = [];
            var maxHistorial = 20;
            var apusFiltradosSelector = [];
            var apusSeleccionadosTemp = [];
            var posicionInsertarAPU = null;
            var dragIndex = null;

            function escapeHTML(str) {
                if (!str) return '';
                return String(str).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            }

            // ===== UNDO =====
            function guardarEstado() {
                historial.push(JSON.stringify(items));
                if (historial.length > maxHistorial) historial.shift();
                actualizarBotonUndo();
            }

            function undoAction() {
                if (historial.length <= 1) { alert('No hay acciones para deshacer'); return; }
                historial.pop();
                items = JSON.parse(historial[historial.length - 1]);
                renderizarItems();
                actualizarBotonUndo();
                mostrarNotificacion('↩️ Acción deshecha');
            }

            function actualizarBotonUndo() {
                var btn = document.getElementById('btnUndo');
                if (btn) {
                    btn.style.opacity = historial.length > 1 ? '1' : '0.5';
                    btn.style.pointerEvents = historial.length > 1 ? 'auto' : 'none';
                }
            }

            // ===== CARGAR APUS =====
            async function cargarAPUs() {
                try {
                    const r = await fetch('/api/apus');
                    if (!r.ok) throw new Error('Error');
                    apusData = await r.json();
                } catch (e) { apusData = []; }
            }

            // ===== NUMERACIÓN =====
            function generarNumeracion() {
                var contadorTitulo = 0;
                var contadorAPU = {};
                var contadorSubitem = {};

                for (var i = 0; i < items.length; i++) {
                    var item = items[i];
                    if (item.tipo === 'titulo') {
                        contadorTitulo++;
                        contadorAPU[contadorTitulo] = 0;
                        item.numero = contadorTitulo + '.';
                        item._idTitulo = contadorTitulo;
                    } else if (item.tipo === 'apu') {
                        var padre = item.padreTitulo || contadorTitulo;
                        contadorAPU[padre] = (contadorAPU[padre] || 0) + 1;
                        item.numero = padre + '.' + contadorAPU[padre];
                        contadorSubitem[padre + '.' + contadorAPU[padre]] = 0;
                    } else if (item.tipo === 'subitem') {
                        var partes = (item.padreAPU || '').split('.');
                        var p = parseInt(partes[0]) || 1;
                        var a = parseInt(partes[1]) || 0;
                        if (a > 0) {
                            var clave = p + '.' + a;
                            contadorSubitem[clave] = (contadorSubitem[clave] || 0) + 1;
                            item.numero = p + '.' + a + '.' + contadorSubitem[clave];
                        }
                    }
                }
            }

            // ===== CALCULAR =====
            function calcularSubtotal() {
                var total = 0;
                for (var i = 0; i < items.length; i++) {
                    if (items[i].tipo === 'apu') {
                        total += (items[i].valorUnitario || 0) * (items[i].cantidad || 1);
                    }
                }
                return total;
            }

            function calcularTotales() {
                var subtotal = calcularSubtotal();
                document.getElementById('subtotalDisplay').textContent = '$' + Number(subtotal).toLocaleString('es-CO');

                var adminPorc = parseFloat(document.getElementById('adminPorcentaje').value) || 0;
                var imprevistosPorc = parseFloat(document.getElementById('imprevistosPorcentaje').value) || 0;
                var utilidadPorc = parseFloat(document.getElementById('utilidadPorcentaje').value) || 0;
                var ivaPorc = parseFloat(document.getElementById('ivaPorcentaje').value) || 0;

                var adminActivo = document.querySelector('.toggle-ajuste[data-ajuste="admin"]').checked;
                var imprevistosActivo = document.querySelector('.toggle-ajuste[data-ajuste="imprevistos"]').checked;
                var utilidadActivo = document.querySelector('.toggle-ajuste[data-ajuste="utilidad"]').checked;
                var ivaActivo = document.querySelector('.toggle-ajuste[data-ajuste="iva"]').checked;

                var adminValor = adminActivo ? (subtotal * adminPorc / 100) : 0;
                var imprevistosValor = imprevistosActivo ? (subtotal * imprevistosPorc / 100) : 0;
                var utilidadValor = utilidadActivo ? (subtotal * utilidadPorc / 100) : 0;
                var ivaValor = ivaActivo ? (utilidadValor * ivaPorc / 100) : 0;

                document.getElementById('adminValor').textContent = '$' + Number(adminValor).toLocaleString('es-CO');
                document.getElementById('imprevistosValor').textContent = '$' + Number(imprevistosValor).toLocaleString('es-CO');
                document.getElementById('utilidadValor').textContent = '$' + Number(utilidadValor).toLocaleString('es-CO');
                document.getElementById('ivaValor').textContent = '$' + Number(ivaValor).toLocaleString('es-CO');

                var totalFinal = subtotal + adminValor + imprevistosValor + utilidadValor + ivaValor;
                document.getElementById('valorTotalFinal').textContent = '$' + Number(totalFinal).toLocaleString('es-CO');

                window._ajustes = {
                    adminPorc: adminPorc, imprevistosPorc: imprevistosPorc, utilidadPorc: utilidadPorc, ivaPorc: ivaPorc,
                    adminActivo: adminActivo, imprevistosActivo: imprevistosActivo, utilidadActivo: utilidadActivo, ivaActivo: ivaActivo,
                    adminValor: adminValor, imprevistosValor: imprevistosValor, utilidadValor: utilidadValor, ivaValor: ivaValor,
                    subtotal: subtotal, totalFinal: totalFinal
                };
            }

            // ===== NÚMERO COTIZACIÓN =====
            function obtenerUltimoNumero() {
                if (cotizaciones.length === 0) return '-';
                var nums = [];
                for (var i = 0; i < cotizaciones.length; i++) {
                    if (cotizaciones[i].numero) nums.push(cotizaciones[i].numero);
                }
                if (nums.length === 0) return '-';
                nums.sort();
                return nums[nums.length - 1];
            }

            // ===== DRAG & DROP =====
            function iniciarDrag(e, index) {
                dragIndex = index;
                var row = e.target.closest('.item-row');
                if (row) { row.style.opacity = '0.5'; row.style.border = '2px dashed var(--primary)'; }
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', index);
            }

            function finalizarDrag(e) {
                var rows = document.querySelectorAll('.item-row');
                for (var i = 0; i < rows.length; i++) {
                    rows[i].style.opacity = '1';
                    rows[i].style.border = '';
                }
                dragIndex = null;
            }

            function soltarItem(e, targetIndex) {
                e.preventDefault();
                var sourceIndex = parseInt(e.dataTransfer.getData('text/plain'));
                if (isNaN(sourceIndex) || sourceIndex === targetIndex || sourceIndex < 0 || targetIndex < 0) { finalizarDrag(e); return; }
                if (sourceIndex >= items.length || targetIndex >= items.length) { finalizarDrag(e); return; }

                var itemMover = items.splice(sourceIndex, 1)[0];
                items.splice(targetIndex, 0, itemMover);
                guardarEstado();
                renderizarItems();
                finalizarDrag(e);
                mostrarNotificacion('📦 Item movido');
            }

            function permitirSoltar(e) { e.preventDefault(); }

            // ===== RENDERIZAR ITEMS =====
            function renderizarItems() {
                var container = document.getElementById('listaItems');
                if (!container) return;

                if (items.length === 0) {
                    container.innerHTML = '<div class="empty-items">No hay items agregados. Comienza agregando un Título.</div>';
                    calcularTotales();
                    return;
                }

                generarNumeracion();

                var html = '<div class="items-list">';
                for (var i = 0; i < items.length; i++) {
                    var item = items[i];
                    var clase = 'item-' + item.tipo;
                    var numero = item.numero || '';
                    var subtotal = 0;
                    if (item.tipo === 'apu') subtotal = (item.valorUnitario || 0) * (item.cantidad || 1);

                    html += '<div class="item-row ' + clase + '" data-index="' + i + '" draggable="true" ';
                    html += 'ondragstart="iniciarDrag(event, ' + i + ')" ';
                    html += 'ondragend="finalizarDrag(event)" ';
                    html += 'ondragover="permitirSoltar(event)" ';
                    html += 'ondrop="soltarItem(event, ' + i + ')">';
                    html += '<div class="item-drag-handle"><i class="fas fa-grip-vertical"></i></div>';
                    html += '<div class="item-numero">' + numero + '</div>';
                    html += '<div class="item-contenido">';

                    if (item.tipo === 'titulo') {
                        html += '<input type="text" class="item-input-titulo" value="' + escapeHTML(item.descripcion || '') + '" placeholder="Escribe el título..." data-index="' + i + '" data-campo="descripcion">';
                    } else if (item.tipo === 'apu') {
                        html += '<span class="item-apu-info">';
                        html += '<strong>' + escapeHTML(item.codigo || '') + '</strong> - ';
                        html += '<span>' + escapeHTML(item.nombre || '') + '</span>';
                        html += ' <span class="apu-detalle">(' + escapeHTML(item.unidad || 'und') + ')</span>';
                        html += '</span>';
                        html += '<div class="item-apu-params">';
                        html += '<label>Cantidad: <input type="number" class="apu-cantidad" value="' + (item.cantidad || 1) + '" min="0.1" step="0.1" data-index="' + i + '"></label>';
                        html += '<span class="apu-subtotal">Subtotal: $' + Number(subtotal).toLocaleString('es-CO') + '</span>';
                        html += '</div>';
                    } else if (item.tipo === 'subitem') {
                        html += '<input type="text" class="item-input-subitem" value="' + escapeHTML(item.descripcion || '') + '" placeholder="Escribe el subitem..." data-index="' + i + '" data-campo="descripcion">';
                    }

                    html += '</div>';
                    html += '<div class="item-acciones">';
                    html += '<button type="button" class="btn-insertar" data-index="' + i + '" title="Insertar después"><i class="fas fa-plus-circle"></i></button>';
                    html += '<button type="button" class="btn-eliminar-item" data-index="' + i + '" title="Eliminar"><i class="fas fa-trash"></i></button>';
                    html += '</div>';
                    html += '</div>';
                }
                html += '</div>';
                container.innerHTML = html;

                var textInputs = container.querySelectorAll('.item-input-titulo, .item-input-subitem');
                for (var t = 0; t < textInputs.length; t++) {
                    (function(input) {
                        var index = parseInt(input.dataset.index);
                        input.addEventListener('input', function() {
                            if (index >= 0 && index < items.length) {
                                items[index][input.dataset.campo] = this.value;
                                calcularTotales();
                            }
                        });
                    })(textInputs[t]);
                }

                var cantInputs = container.querySelectorAll('.apu-cantidad');
                for (var c = 0; c < cantInputs.length; c++) {
                    (function(input) {
                        var index = parseInt(input.dataset.index);
                        input.addEventListener('change', function() {
                            var cantidad = parseFloat(this.value) || 1;
                            if (cantidad < 0.1) cantidad = 0.1;
                            if (index >= 0 && index < items.length) {
                                items[index].cantidad = cantidad;
                                guardarEstado();
                                renderizarItems();
                            }
                        });
                    })(cantInputs[c]);
                }

                var btnIns = container.querySelectorAll('.btn-insertar');
                for (var b = 0; b < btnIns.length; b++) {
                    (function(btn) {
                        var index = parseInt(btn.dataset.index);
                        btn.addEventListener('click', function() { mostrarMenuInsertar(index); });
                    })(btnIns[b]);
                }

                var btnDel = container.querySelectorAll('.btn-eliminar-item');
                for (var d = 0; d < btnDel.length; d++) {
                    (function(btn) {
                        var index = parseInt(btn.dataset.index);
                        btn.addEventListener('click', function() { eliminarItem(index); });
                    })(btnDel[d]);
                }

                calcularTotales();
                actualizarBotonUndo();
            }

            // ===== MENÚ INSERTAR =====
            function mostrarMenuInsertar(index) {
                if (index < 0 || index >= items.length) return;
                var tipoActual = items[index].tipo;
                var opciones = [];

                if (tipoActual === 'titulo') {
                    opciones.push({ tipo: 'apu', label: 'Agregar APU' });
                } else if (tipoActual === 'apu' || tipoActual === 'subitem') {
                    opciones.push({ tipo: 'titulo', label: 'Agregar Título' });
                    opciones.push({ tipo: 'apu', label: 'Agregar APU' });
                    opciones.push({ tipo: 'subitem', label: 'Agregar Subitem' });
                }
                if (opciones.length === 0) return;

                var menuHTML = '<div class="insert-menu-overlay" id="insertMenu"><div class="insert-menu-box"><h3>Insertar después</h3>';
                for (var i = 0; i < opciones.length; i++) {
                    menuHTML += '<button type="button" class="btn-insert-option" data-tipo="' + opciones[i].tipo + '">' + opciones[i].label + '</button>';
                }
                menuHTML += '<button type="button" class="btn-secondary" id="btnCancelarInsert">Cancelar</button></div></div>';

                var existing = document.getElementById('insertMenu');
                if (existing) existing.remove();
                document.body.insertAdjacentHTML('beforeend', menuHTML);

                var options = document.querySelectorAll('#insertMenu .btn-insert-option');
                for (var j = 0; j < options.length; j++) {
                    (function(btn) {
                        var tipo = btn.dataset.tipo;
                        btn.addEventListener('click', function() {
                            if (tipo === 'apu') {
                                cerrarInsertMenu();
                                posicionInsertarAPU = index + 1;
                                abrirSelectorAPU();
                            } else {
                                insertarItemTipo(index, tipo);
                            }
                        });
                    })(options[j]);
                }
                document.getElementById('btnCancelarInsert').addEventListener('click', cerrarInsertMenu);
            }

            function cerrarInsertMenu() {
                var menu = document.getElementById('insertMenu');
                if (menu) menu.remove();
            }

            function insertarItemTipo(index, tipo) {
                cerrarInsertMenu();

                if (tipo === 'titulo') {
                    items.splice(index + 1, 0, { id: ++counterId, tipo: 'titulo', descripcion: '', numero: '' });
                    guardarEstado();
                    renderizarItems();
                    setTimeout(function() {
                        var inputs = document.querySelectorAll('.item-input-titulo');
                        if (inputs.length > 0) inputs[inputs.length - 1].focus();
                    }, 200);
                } else if (tipo === 'subitem') {
                    var padreAPU = null;
                    for (var k = index; k >= 0; k--) {
                        if (items[k].tipo === 'apu') { padreAPU = items[k].numero || ''; break; }
                    }
                    if (!padreAPU) {
                        for (var l = items.length - 1; l >= 0; l--) {
                            if (items[l].tipo === 'apu') { padreAPU = items[l].numero || ''; break; }
                        }
                    }
                    if (!padreAPU) { alert('Debe haber un APU antes del Subitem'); return; }
                    items.splice(index + 1, 0, { id: ++counterId, tipo: 'subitem', descripcion: '', numero: '', padreAPU: padreAPU });
                    guardarEstado();
                    renderizarItems();
                    setTimeout(function() {
                        var inputs = document.querySelectorAll('.item-input-subitem');
                        if (inputs.length > 0) inputs[inputs.length - 1].focus();
                    }, 200);
                }
            }

            // ===== SELECTOR APU =====
            function abrirSelectorAPU() {
                apusSeleccionadosTemp = [];
                apusFiltradosSelector = apusData.slice();
                renderizarListaAPUSelector();
                document.getElementById('modalSeleccionarAPU').style.display = 'flex';
            }

            function cerrarSelectorAPU() {
                document.getElementById('modalSeleccionarAPU').style.display = 'none';
                posicionInsertarAPU = null;
            }

            function filtrarAPUSelector() {
                var b = document.getElementById('buscarAPUSelector').value.toLowerCase().trim();
                apusFiltradosSelector = b === ''
                    ? apusData.slice()
                    : apusData.filter(function(a) {
                        return a.codigo.toLowerCase().indexOf(b) !== -1 || a.nombre.toLowerCase().indexOf(b) !== -1 || (a.categoria && a.categoria.toLowerCase().indexOf(b) !== -1);
                    });
                renderizarListaAPUSelector();
            }

            function renderizarListaAPUSelector() {
                var container = document.getElementById('listaAPUSelector');
                if (apusFiltradosSelector.length === 0) {
                    container.innerHTML = '<div class="selector-vacio">No hay APU disponibles</div>';
                } else {
                    var html = '';
                    for (var i = 0; i < apusFiltradosSelector.length; i++) {
                        var a = apusFiltradosSelector[i];
                        var seleccionado = apusSeleccionadosTemp.some(function(s) { return s.id === a.id; });
                        var valorFormateado = '$' + Number(a.valor || 0).toLocaleString('es-CO');
                        html += '<div class="apu-item-selector ' + (seleccionado ? 'seleccionado' : '') + '" data-id="' + a.id + '" onclick="toggleAPUSeleccionado(' + a.id + ')">';
                        html += '<input type="checkbox" ' + (seleccionado ? 'checked' : '') + ' onclick="event.stopPropagation(); toggleAPUSeleccionado(' + a.id + ')">';
                        html += '<div class="apu-info">';
                        html += '<span class="apu-codigo">' + escapeHTML(a.codigo) + '</span>';
                        html += '<span class="apu-nombre">' + escapeHTML(a.nombre) + '</span>';
                        if (a.categoria) html += '<span class="apu-categoria">' + escapeHTML(a.categoria) + '</span>';
                        html += '<span class="apu-valor">' + valorFormateado + '</span>';
                        html += '</div></div>';
                    }
                    container.innerHTML = html;
                }
                document.getElementById('apuContadorSelector').textContent = apusFiltradosSelector.length + ' APU';
                document.getElementById('apuSeleccionadosContador').textContent = apusSeleccionadosTemp.length + ' APU seleccionados';
            }

            function toggleAPUSeleccionado(id) {
                var index = -1;
                for (var i = 0; i < apusSeleccionadosTemp.length; i++) {
                    if (apusSeleccionadosTemp[i].id === id) { index = i; break; }
                }
                if (index === -1) {
                    var apu = null;
                    for (var j = 0; j < apusData.length; j++) {
                        if (apusData[j].id === id) { apu = apusData[j]; break; }
                    }
                    if (apu) {
                        apusSeleccionadosTemp.push({
                            id: apu.id, codigo: apu.codigo || '', nombre: apu.nombre || '',
                            unidad: apu.unidad || 'und', valorUnitario: apu.valor || 0, cantidad: 1
                        });
                    }
                } else {
                    apusSeleccionadosTemp.splice(index, 1);
                }
                renderizarListaAPUSelector();
            }

            function seleccionarTodosAPU() {
                apusSeleccionadosTemp = [];
                for (var i = 0; i < apusFiltradosSelector.length; i++) {
                    var a = apusFiltradosSelector[i];
                    apusSeleccionadosTemp.push({
                        id: a.id, codigo: a.codigo || '', nombre: a.nombre || '',
                        unidad: a.unidad || 'und', valorUnitario: a.valor || 0, cantidad: 1
                    });
                }
                renderizarListaAPUSelector();
            }

            function deseleccionarTodosAPU() {
                apusSeleccionadosTemp = [];
                renderizarListaAPUSelector();
            }

            function agregarAPUSeleccionados() {
                if (apusSeleccionadosTemp.length === 0) { alert('Selecciona al menos un APU'); return; }
                var posicion = posicionInsertarAPU !== null ? posicionInsertarAPU : items.length;

                for (var i = 0; i < apusSeleccionadosTemp.length; i++) {
                    var apu = apusSeleccionadosTemp[i];
                    items.splice(posicion + i, 0, {
                        id: ++counterId, tipo: 'apu', apuId: apu.id, codigo: apu.codigo,
                        nombre: apu.nombre, unidad: apu.unidad, valorUnitario: apu.valorUnitario,
                        cantidad: apu.cantidad || 1, numero: '', padreTitulo: null
                    });
                }
                guardarEstado();
                renderizarItems();
                cerrarSelectorAPU();
                posicionInsertarAPU = null;
                mostrarNotificacion('✅ ' + apusSeleccionadosTemp.length + ' APU(s) agregados');
            }

            function eliminarItem(index) {
                if (index >= 0 && index < items.length) {
                    if (confirm('¿Eliminar este item?')) {
                        items.splice(index, 1);
                        guardarEstado();
                        renderizarItems();
                    }
                }
            }

            // ===== CARGAR COTIZACIONES =====
            async function cargarCotizaciones() {
                try {
                    const r = await fetch('/api/cotizaciones');
                    if (!r.ok) throw new Error('Error');
                    cotizaciones = await r.json();
                    renderizarTabla();
                } catch (e) {
                    cotizaciones = [];
                    renderizarTabla();
                }
            }

            function renderizarTabla() {
                var tbody = document.getElementById('cuerpoTabla');
                var sinDatos = document.getElementById('sinDatos');
                var tabla = document.getElementById('tablaCotizaciones');

                if (!tbody) return;

                if (!cotizaciones || !Array.isArray(cotizaciones)) cotizaciones = [];

                if (cotizaciones.length === 0) {
                    tbody.innerHTML = '';
                    if (sinDatos) sinDatos.style.display = 'block';
                    if (tabla) tabla.style.display = 'none';
                    return;
                }

                if (sinDatos) sinDatos.style.display = 'none';
                if (tabla) tabla.style.display = 'table';

                var html = '';
                for (var i = 0; i < cotizaciones.length; i++) {
                    var c = cotizaciones[i];
                    var valorFormateado = '$' + Number(c.valorTotalFinal || c.valorTotal || 0).toLocaleString('es-CO');
                    html += '<tr>';
                    html += '<td><strong>' + escapeHTML(c.numero || '-') + '</strong></td>';
                    html += '<td>' + escapeHTML(c.cliente || '-') + '</td>';
                    html += '<td>' + escapeHTML(c.tipo || '-') + '</td>';
                    html += '<td>' + escapeHTML(c.proyecto || '-') + '</td>';
                    var obj = c.objetivo || '';
                    html += '<td>' + escapeHTML(obj.substring(0, 30) + (obj.length > 30 ? '...' : '')) + '</td>';
                    html += '<td>' + valorFormateado + '</td>';
                    html += '<td>';
                    html += '<button class="btn-edit" onclick="editarCotizacion(' + c.id + ')"><i class="fas fa-edit"></i></button>';
                    html += '<button class="btn-delete" onclick="eliminarCotizacion(' + c.id + ')"><i class="fas fa-trash"></i></button>';
                    html += '<button class="btn-pdf" onclick="exportarPDF(' + c.id + ')"><i class="fas fa-file-pdf"></i></button>';
                    html += '</td>';
                    html += '</tr>';
                }
                tbody.innerHTML = html;
            }

            // ============================================================
            // ===== EXPORTAR PDF (con logo) =====
            // ============================================================
            async function exportarPDF(id) {
                mostrarNotificacion('⏳ Generando PDF...');

                var cotizacion = null;
                for (var i = 0; i < cotizaciones.length; i++) {
                    if (cotizaciones[i].id === id) { cotizacion = cotizaciones[i]; break; }
                }
                if (!cotizacion) { mostrarNotificacion('❌ Cotización no encontrada'); return; }

                // Cargar datos de la empresa (incluye logo)
                let empresaData = null;
                try {
                    const r = await fetch('/api/empresa-info');
                    if (r.ok) empresaData = await r.json();
                    console.log('🏢 Empresa cargada:', empresaData ? 'SÍ' : 'NO');
                    console.log('🖼️ Logo presente:', empresaData && empresaData.logo ? 'SÍ (' + empresaData.logo.length + ' chars)' : 'NO');
                } catch (e) {
                    console.error('Error al cargar empresa:', e);
                }

                if (!empresaData) {
                    empresaData = { nombre: 'Mi Empresa', nit: '', telefono: '', email: '', direccion: '', web: '', logo: '' };
                }

                fetch('/api/cotizacion-pdf', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        cotizacion: cotizacion,
                        empresa: empresaData,
                        fecha: new Date().toISOString()
                    })
                })
                .then(function(r) {
                    if (!r.ok) return r.json().then(function(err) { throw new Error(err.error || 'Error'); });
                    return r.blob();
                })
                .then(function(blob) {
                    var url = window.URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = 'Cotizacion_' + (cotizacion.numero || 'COT-' + cotizacion.id) + '_' + new Date().toISOString().slice(0,10) + '.pdf';
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    a.remove();
                    mostrarNotificacion('✅ PDF generado');
                })
                .catch(function(err) {
                    console.error('Error PDF:', err);
                    mostrarNotificacion('❌ Error: ' + err.message);
                });
            }

            // ===== MODAL =====
            async function abrirModal(cotizacion) {
                var modal = document.getElementById('modalCotizacion');
                var form = document.getElementById('formCotizacion');
                var titulo = document.getElementById('modalTitulo');
                if (!modal) return;

                items = [];
                counterId = 0;
                historial = [];
                renderizarItems();

                await cargarAPUs();

                var ultimo = obtenerUltimoNumero();
                document.getElementById('ultimoNumero').textContent = ultimo;

                document.getElementById('adminPorcentaje').value = 0;
                document.getElementById('imprevistosPorcentaje').value = 0;
                document.getElementById('utilidadPorcentaje').value = 0;
                document.getElementById('ivaPorcentaje').value = 0;
                document.querySelectorAll('.toggle-ajuste').forEach(function(el) { el.checked = true; });

                if (!cotizacion) {
                    items.push({ id: ++counterId, tipo: 'titulo', descripcion: '', numero: '' });
                    guardarEstado();
                    renderizarItems();
                    setTimeout(function() {
                        var inputs = document.querySelectorAll('.item-input-titulo');
                        if (inputs.length > 0) inputs[0].focus();
                    }, 200);
                }

                if (cotizacion) {
                    titulo.textContent = 'Editar Cotización';
                    document.getElementById('numero').value = cotizacion.numero || '';
                    document.getElementById('cliente').value = cotizacion.cliente || '';
                    document.getElementById('tipo').value = cotizacion.tipo || '';
                    document.getElementById('proyecto').value = cotizacion.proyecto || '';
                    document.getElementById('objetivo').value = cotizacion.objetivo || '';
                    document.getElementById('direccion').value = cotizacion.direccion || '';
                    editandoId = cotizacion.id;

                    if (cotizacion.ajustes) {
                        var a = cotizacion.ajustes;
                        document.getElementById('adminPorcentaje').value = a.adminPorc || 0;
                        document.getElementById('imprevistosPorcentaje').value = a.imprevistosPorc || 0;
                        document.getElementById('utilidadPorcentaje').value = a.utilidadPorc || 0;
                        document.getElementById('ivaPorcentaje').value = a.ivaPorc || 0;
                        if (a.adminActivo !== undefined) document.querySelector('.toggle-ajuste[data-ajuste="admin"]').checked = a.adminActivo;
                        if (a.imprevistosActivo !== undefined) document.querySelector('.toggle-ajuste[data-ajuste="imprevistos"]').checked = a.imprevistosActivo;
                        if (a.utilidadActivo !== undefined) document.querySelector('.toggle-ajuste[data-ajuste="utilidad"]').checked = a.utilidadActivo;
                        if (a.ivaActivo !== undefined) document.querySelector('.toggle-ajuste[data-ajuste="iva"]').checked = a.ivaActivo;
                    }

                    if (cotizacion.items && cotizacion.items.length > 0) {
                        items = cotizacion.items;
                        for (var i = 0; i < items.length; i++) {
                            if (!items[i].id) items[i].id = ++counterId;
                            if (counterId < items[i].id) counterId = items[i].id;
                        }
                        guardarEstado();
                        renderizarItems();
                    }
                } else {
                    titulo.textContent = 'Nueva Cotización';
                    form.reset();
                    document.getElementById('numero').value = '';
                    editandoId = null;
                }

                document.querySelectorAll('.toggle-ajuste').forEach(function(el) {
                    el.addEventListener('change', function() { calcularTotales(); });
                });

                calcularTotales();
                modal.style.display = 'flex';
                actualizarBotonUndo();
            }

            function cerrarModal() {
                var modal = document.getElementById('modalCotizacion');
                if (modal) modal.style.display = 'none';
                var form = document.getElementById('formCotizacion');
                if (form) form.reset();
                editandoId = null;
                items = [];
                historial = [];
                renderizarItems();
                cerrarSelectorAPU();
                cerrarInsertMenu();
                actualizarBotonUndo();
            }

            // ===== CRUD =====
            document.addEventListener('DOMContentLoaded', async function() {
                await cargarCotizaciones();
                await cargarAPUs();

                var form = document.getElementById('formCotizacion');
                if (form) {
                    form.addEventListener('submit', async function(e) {
                        e.preventDefault();

                        var numero = document.getElementById('numero').value.trim();
                        var cliente = document.getElementById('cliente').value.trim();
                        var tipo = document.getElementById('tipo').value;
                        var proyecto = document.getElementById('proyecto').value.trim();
                        var objetivo = document.getElementById('objetivo').value.trim();
                        var direccion = document.getElementById('direccion').value.trim();

                        if (!cliente || !tipo || !proyecto) {
                            alert('Completa todos los campos obligatorios (*)');
                            return;
                        }
                        if (items.length === 0) { alert('Debes agregar al menos un Título'); return; }

                        var ajustes = window._ajustes || {
                            adminPorc: 0, imprevistosPorc: 0, utilidadPorc: 0, ivaPorc: 0,
                            adminActivo: true, imprevistosActivo: true, utilidadActivo: true, ivaActivo: true,
                            adminValor: 0, imprevistosValor: 0, utilidadValor: 0, ivaValor: 0,
                            subtotal: 0, totalFinal: 0
                        };

                        var numeroFinal = numero;
                        if (!numeroFinal) {
                            var ultimo = obtenerUltimoNumero();
                            if (ultimo !== '-') {
                                var match = ultimo.match(/(\d+)$/);
                                if (match) {
                                    var num = parseInt(match[1]) + 1;
                                    var prefijo = ultimo.replace(/\d+$/, '');
                                    numeroFinal = prefijo + String(num).padStart(3, '0');
                                } else {
                                    numeroFinal = 'COT-001';
                                }
                            } else {
                                numeroFinal = 'COT-001';
                            }
                        }

                        var cotizacionData = {
                            numero: numeroFinal, cliente: cliente, tipo: tipo, proyecto: proyecto,
                            objetivo: objetivo, direccion: direccion,
                            valorTotal: ajustes.subtotal || 0,
                            valorTotalFinal: ajustes.totalFinal || 0,
                            items: items, ajustes: ajustes
                        };

                        try {
                            var url = editandoId !== null ? '/api/cotizaciones/' + editandoId : '/api/cotizaciones';
                            var method = editandoId !== null ? 'PUT' : 'POST';

                            var response = await fetch(url, {
                                method: method,
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(cotizacionData)
                            });

                            if (!response.ok) {
                                var err = await response.json();
                                throw new Error(err.error || 'Error al guardar');
                            }

                            await cargarCotizaciones();
                            cerrarModal();
                            mostrarNotificacion(editandoId !== null ? 'Cotización actualizada' : 'Cotización creada');
                            editandoId = null;
                        } catch (error) {
                            console.error('Error:', error);
                            mostrarNotificacion('Error: ' + error.message);
                        }
                    });
                }
            });

            function editarCotizacion(id) {
                var c = null;
                for (var i = 0; i < cotizaciones.length; i++) {
                    if (cotizaciones[i].id === id) { c = cotizaciones[i]; break; }
                }
                if (c) abrirModal(c);
            }

            async function eliminarCotizacion(id) {
                if (!confirm('¿Estás seguro de eliminar esta cotización?')) return;
                try {
                    const r = await fetch('/api/cotizaciones/' + id, { method: 'DELETE' });
                    if (!r.ok) throw new Error('Error');
                    await cargarCotizaciones();
                    mostrarNotificacion('Cotización eliminada');
                } catch (e) {
                    mostrarNotificacion('Error al eliminar');
                }
            }

            function borrarCache() {
                if (!cotizaciones || cotizaciones.length === 0) { alert('No hay cotizaciones para borrar'); return; }
                if (!confirm('⚠️ ¿Borrar TODAS tus cotizaciones? Esta acción no se puede deshacer.')) return;

                Promise.all(cotizaciones.map(function(c) {
                    return fetch('/api/cotizaciones/' + c.id, { method: 'DELETE' });
                }))
                .then(function() { return cargarCotizaciones(); })
                .then(function() { mostrarNotificacion('Todas las cotizaciones fueron eliminadas'); });
            }

            function mostrarNotificacion(mensaje) {
                var n = document.createElement('div');
                n.className = 'notification';
                n.textContent = mensaje;
                document.body.appendChild(n);
                setTimeout(function() { n.classList.add('show'); }, 100);
                setTimeout(function() {
                    n.classList.remove('show');
                    setTimeout(function() { n.remove(); }, 300);
                }, 3000);
            }

            window.onclick = function(event) {
                var modal = document.getElementById('modalCotizacion');
                if (event.target === modal) cerrarModal();
                var selector = document.getElementById('modalSeleccionarAPU');
                if (event.target === selector) cerrarSelectorAPU();
                var menu = document.getElementById('insertMenu');
                if (event.target === menu) cerrarInsertMenu();
            };
        </script>
    `
}) %>