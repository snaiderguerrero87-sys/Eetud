<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- ===== FAVICON ===== -->
    <link rel="icon" href="/assets/logo.jpg" type="image/jpeg">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/landing.css">
</head>
<body>
    <!-- ===== NAVBAR ===== -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="nav-logo">
                <img src="/assets/logo.jpg" alt="Eetud" style="height: 40px; width: auto; border-radius: 8px;">
                <span style="font-size:20px; font-weight:700; color:var(--gray-900);">Eetud</span>
            </div>
            <div class="nav-links">
                <a href="#features">Características</a>
                <a href="#plans">Planes</a>
                <a href="#testimonials">Testimonios</a>
                <a href="/login" class="btn-nav-login">Iniciar Sesión</a>
                <a href="/registro" class="btn-nav-register">Registrarse</a>
            </div>
            <button class="nav-toggle" onclick="toggleMenu()">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </nav>

    <!-- ===== HERO ===== -->
    <section class="hero">
        <div class="hero-container">
            <div class="hero-content">
                <div class="hero-badge">
                    <i class="fas fa-rocket"></i>
                    Project-Based ERP · Cotizaciones · APU · Proyectos
                </div>
                <h1>El <span>software de Planificación de Recursos Empresariales</span> que tu empresa necesita</h1>
                <p>Organiza, mide y controla tus proyectos con una plataforma todo-en-uno. Ideal para empresas de construcción, servicios eléctricos, mecánicos y más.</p>
                <div class="hero-buttons">
                    <a href="/registro" class="btn-primary">
                        <i class="fas fa-play"></i> Probar Gratis - 1 cotización
                    </a>
                    <a href="#plans" class="btn-secondary">
                        <i class="fas fa-arrow-down"></i> Ver Planes
                    </a>
                </div>
                <div class="hero-stats">
                    <div class="stat-item">
                        <span class="stat-number">500+</span>
                        <span class="stat-label">Empresas confían en nosotros</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">1000+</span>
                        <span class="stat-label">Proyectos gestionados con éxito</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">98%</span>
                        <span class="stat-label">de usuarios recomiendan Eetud</span>
                    </div>
                </div>
            </div>
            <div class="hero-image">
                <div class="hero-dashboard-mockup">
                    <div class="mockup-header">
                        <div class="mockup-dots">
                            <span></span><span></span><span></span>
                        </div>
                        <span>Eetud Dashboard</span>
                    </div>
                    <div class="mockup-content">
                        <div class="mockup-card">
                            <div class="mockup-card-icon blue"><i class="fas fa-project-diagram"></i></div>
                            <div>
                                <div class="mockup-card-value">47</div>
                                <div class="mockup-card-label">Proyectos Activos</div>
                            </div>
                        </div>
                        <div class="mockup-card">
                            <div class="mockup-card-icon green"><i class="fas fa-dollar-sign"></i></div>
                            <div>
                                <div class="mockup-card-value">$45.8M</div>
                                <div class="mockup-card-label">Ingresos</div>
                            </div>
                        </div>
                        <div class="mockup-chart">
                            <div class="mockup-chart-bar" style="height:60%"></div>
                            <div class="mockup-chart-bar" style="height:80%"></div>
                            <div class="mockup-chart-bar" style="height:45%"></div>
                            <div class="mockup-chart-bar" style="height:90%"></div>
                            <div class="mockup-chart-bar" style="height:55%"></div>
                            <div class="mockup-chart-bar" style="height:70%"></div>
                            <div class="mockup-chart-bar" style="height:85%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== FEATURES ===== -->
    <section id="features" class="features">
        <div class="container">
            <div class="section-header">
                <span class="section-badge">Características</span>
                <h2>Todo lo que necesitas para <span>gestionar tu negocio por proyectos</span></h2>
                <p>Desde la planificación hasta la ejecución, Eetud te acompaña en cada paso del camino.</p>
            </div>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon blue"><i class="fas fa-file-invoice"></i></div>
                    <h3>Cotizaciones Profesionales</h3>
                    <p>Crea presupuestos detallados con Análisis de Precios Unitarios (APU), materiales y mano de obra. Control total de tus costos.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon green"><i class="fas fa-project-diagram"></i></div>
                    <h3>Gestión de Proyectos</h3>
                    <p>Convierte cotizaciones en proyectos, haz seguimiento de avance, costos ejecutados y saldos en tiempo real.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon purple"><i class="fas fa-tools"></i></div>
                    <h3>Control de Equipos y Herramientas</h3>
                    <p>Gestiona tu inventario de herramientas y asigna ubicación en cada proyecto. Sabrás siempre dónde está cada equipo.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon orange"><i class="fas fa-users"></i></div>
                    <h3>Gestión de Personal</h3>
                    <p>Administra empleados, controla asistencia y gestiona costos de mano de obra. Calcula costos por día, mes y hora.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon red"><i class="fas fa-cubes"></i></div>
                    <h3>Inventario de Materiales</h3>
                    <p>Gestiona proveedores, precios unitarios y disponibilidad de materiales. Base de datos para tus cotizaciones.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon cyan"><i class="fas fa-table"></i></div>
                    <h3>Análisis de Precios Unitarios</h3>
                    <p>Construye APU detallados con materiales, mano de obra y costos indirectos. La base de tu presupuestación.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== PLANS ===== -->
    <section id="plans" class="plans">
        <div class="container">
            <div class="section-header">
                <span class="section-badge">Planes</span>
                <h2>Elige el plan que mejor se adapte a <span>tu empresa</span></h2>
                <p>Comienza con una prueba gratuita y escala a medida que tu negocio crece.</p>
            </div>
            <div class="plans-grid">
                <!-- Plan Gratuito -->
                <div class="plan-card plan-free">
                    <div class="plan-badge">Prueba Gratuita</div>
                    <div class="plan-header">
                        <h3>Gratuito</h3>
                        <div class="plan-price">$0 <span>/ mes</span></div>
                        <p>Prueba Eetud con un proyecto real</p>
                    </div>
                    <ul class="plan-features">
                        <li><i class="fas fa-check"></i> 1 Cotización de prueba</li>
                        <li><i class="fas fa-check"></i> 3 APU en total</li>
                        <li><i class="fas fa-check"></i> 3 Herramientas</li>
                        <li><i class="fas fa-check"></i> 3 Empleados</li>
                        <li><i class="fas fa-check"></i> 1 Proyecto de prueba</li>
                        <li><i class="fas fa-times"></i> <span class="disabled">Soporte prioritario</span></li>
                        <li><i class="fas fa-times"></i> <span class="disabled">Exportación de datos</span></li>
                    </ul>
                    <a href="/registro" class="plan-btn plan-btn-free">Comenzar prueba</a>
                </div>

                <!-- Plan Mensual -->
                <div class="plan-card plan-monthly popular">
                    <div class="plan-badge popular-badge">Más Popular</div>
                    <div class="plan-header">
                        <h3>Mensual</h3>
                        <div class="plan-price">$49.900 <span>/ mes</span></div>
                        <p>Flexibilidad para tu negocio</p>
                    </div>
                    <ul class="plan-features">
                        <li><i class="fas fa-check"></i> Todo desbloqueado</li>
                        <li><i class="fas fa-check"></i> Cotizaciones ilimitadas</li>
                        <li><i class="fas fa-check"></i> APU ilimitados</li>
                        <li><i class="fas fa-check"></i> Herramientas ilimitadas</li>
                        <li><i class="fas fa-check"></i> Empleados ilimitados</li>
                        <li><i class="fas fa-check"></i> Proyectos ilimitados</li>
                        <li><i class="fas fa-check"></i> Soporte prioritario</li>
                        <li><i class="fas fa-check"></i> Exportación de datos</li>
                    </ul>
                    <a href="/registro" class="plan-btn plan-btn-monthly">Suscribirse</a>
                </div>

                <!-- Plan Trimestral -->
                <div class="plan-card plan-quarterly">
                    <div class="plan-badge">Ahorra 15%</div>
                    <div class="plan-header">
                        <h3>Trimestral</h3>
                        <div class="plan-price">$127.300 <span>/ trimestre</span></div>
                        <p>Ahorra con el pago trimestral</p>
                    </div>
                    <ul class="plan-features">
                        <li><i class="fas fa-check"></i> Todo desbloqueado</li>
                        <li><i class="fas fa-check"></i> Cotizaciones ilimitadas</li>
                        <li><i class="fas fa-check"></i> APU ilimitados</li>
                        <li><i class="fas fa-check"></i> Herramientas ilimitadas</li>
                        <li><i class="fas fa-check"></i> Empleados ilimitados</li>
                        <li><i class="fas fa-check"></i> Proyectos ilimitados</li>
                        <li><i class="fas fa-check"></i> Soporte prioritario</li>
                        <li><i class="fas fa-check"></i> Exportación de datos</li>
                        <li class="plan-savings"><i class="fas fa-tag"></i> Ahorra 15% vs mensual</li>
                    </ul>
                    <a href="/registro" class="plan-btn plan-btn-quarterly">Suscribirse</a>
                </div>

                <!-- Plan Anual -->
                <div class="plan-card plan-yearly">
                    <div class="plan-badge">Mejor Valor</div>
                    <div class="plan-header">
                        <h3>Anual</h3>
                        <div class="plan-price">$419.200 <span>/ año</span></div>
                        <p>El máximo ahorro para tu empresa</p>
                    </div>
                    <ul class="plan-features">
                        <li><i class="fas fa-check"></i> Todo desbloqueado</li>
                        <li><i class="fas fa-check"></i> Cotizaciones ilimitadas</li>
                        <li><i class="fas fa-check"></i> APU ilimitados</li>
                        <li><i class="fas fa-check"></i> Herramientas ilimitadas</li>
                        <li><i class="fas fa-check"></i> Empleados ilimitados</li>
                        <li><i class="fas fa-check"></i> Proyectos ilimitados</li>
                        <li><i class="fas fa-check"></i> Soporte prioritario 24/7</li>
                        <li><i class="fas fa-check"></i> Exportación de datos</li>
                        <li><i class="fas fa-check"></i> 2 meses gratis</li>
                        <li class="plan-savings"><i class="fas fa-tag"></i> Ahorra 30% vs mensual</li>
                    </ul>
                    <a href="/registro" class="plan-btn plan-btn-yearly">Suscribirse</a>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== TESTIMONIALS ===== -->
    <section id="testimonials" class="testimonials">
        <div class="container">
            <div class="section-header">
                <span class="section-badge">Testimonios</span>
                <h2>Lo que dicen <span>nuestros clientes</span></h2>
                <p>Empresas que ya confían en Eetud para su gestión diaria.</p>
            </div>
            <div class="testimonials-grid">
                <div class="testimonial-card">
                    <div class="testimonial-stars">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                    </div>
                    <p>"Eetud nos permitió tener control total sobre nuestros proyectos. Los APU nos ayudan a presupuestar con precisión y el seguimiento de avance es clave para la toma de decisiones."</p>
                    <div class="testimonial-author">
                        <div class="author-avatar">JG</div>
                        <div>
                            <strong>Juan Gómez</strong>
                            <span>CEO Constructora ABC</span>
                        </div>
                    </div>
                </div>
                <div class="testimonial-card">
                    <div class="testimonial-stars">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                    </div>
                    <p>"Como empresa de servicios eléctricos, Eetud nos ayuda a gestionar costos y personal en cada obra. La asignación de herramientas nos ha reducido pérdidas significativamente."</p>
                    <div class="testimonial-author">
                        <div class="author-avatar">MR</div>
                        <div>
                            <strong>María Rodríguez</strong>
                            <span>Directora General</span>
                        </div>
                    </div>
                </div>
                <div class="testimonial-card">
                    <div class="testimonial-stars">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                    </div>
                    <p>"La gestión de materiales y proveedores nos ha permitido optimizar nuestras compras. Eetud es la herramienta que toda empresa por proyectos necesita."</p>
                    <div class="testimonial-author">
                        <div class="author-avatar">CP</div>
                        <div>
                            <strong>Carlos Pérez</strong>
                            <span>Director de Operaciones</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="cta">
        <div class="container">
            <div class="cta-content">
                <h2>¿Listo para organizar, medir y controlar <span>tus proyectos</span>?</h2>
                <p>Únete a las empresas que ya optimizan su gestión con Eetud.</p>
                <div class="cta-buttons">
                    <a href="/registro" class="btn-primary btn-large">
                        <i class="fas fa-play"></i> Probar Gratis - 1 cotización
                    </a>
                    <a href="/login" class="btn-secondary btn-large">
                        <i class="fas fa-sign-in-alt"></i> Iniciar Sesión
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== FOOTER ===== -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <div class="footer-logo">
                        <img src="/assets/logo.jpg" alt="Eetud" style="height: 36px; width: auto; border-radius: 8px;">
                        <span style="font-size:20px; font-weight:700; color:white;">Eetud</span>
                    </div>
                    <p style="margin-top:8px;">Software de Planificación de Recursos Empresariales para empresas por proyectos. Cotizaciones, APU, proyectos, inventario y personal en una sola plataforma.</p>
                </div>
                <div class="footer-links">
                    <div class="footer-column">
                        <h4>Producto</h4>
                        <a href="#features">Características</a>
                        <a href="#plans">Planes</a>
                        <a href="/registro">Registrarse</a>
                    </div>
                    <div class="footer-column">
                        <h4>Empresa</h4>
                        <a href="#">Electitud</a>
                        <a href="#">Contacto</a>
                        <a href="#">Blog</a>
                    </div>
                    <div class="footer-column">
                        <h4>Soporte</h4>
                        <a href="#">Ayuda</a>
                        <a href="#">Documentación</a>
                        <a href="#">Política de privacidad</a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Electitud - Eetud. Todos los derechos reservados.</p>
                <div class="footer-social">
                    <a href="#"><i class="fab fa-linkedin"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        function toggleMenu() {
            const nav = document.querySelector('.nav-links');
            nav.classList.toggle('active');
        }

        document.querySelectorAll('.nav-links a').forEach(link => {
            link.addEventListener('click', () => {
                document.querySelector('.nav-links').classList.remove('active');
            });
        });

        window.addEventListener('scroll', function() {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });
    </script>
</body>
</html>