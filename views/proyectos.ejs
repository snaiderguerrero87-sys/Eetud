                        var nombreEmpleado = '';
                        var costoHora = 0;
                        for (var ee = 0; ee < empleadosData.length; ee++) {
                            if (empleadosData[ee].id === emp.empleadoId) {
                                nombreEmpleado = empleadosData[ee].nombre;
                                costoHora = empleadosData[ee].costoHora || 0;
                                break;
                            }
                        }
                        var fecha = emp.fecha ? new Date(emp.fecha).toLocaleDateString('es-CO') : '-';
                        var horaEntrada = emp.horaEntrada || '08:00';
                        var horaSalida = emp.horaSalida || '17:00';
                        var horasTrabajadas = calcularHorasTrabajadas(horaEntrada, horaSalida, emp.almuerzo || false);
                        var costo = horasTrabajadas * costoHora;
                        totalHoras += horasTrabajadas;
                        totalCosto += costo;
                        
                        var almuerzoText = emp.almuerzo ? '✅ Con almuerzo' : '❌ Sin almuerzo';
                        
                        html += '<div class="list-item">';
                        html += '<div class="info">';
                        html += '<strong>' + (nombreEmpleado || 'Empleado #' + emp.empleadoId) + '</strong>';
                        html += '<span class="detalle">' + fecha + ' | Entrada: ' + horaEntrada + ' | Salida: ' + horaSalida + ' | ' + almuerzoText + ' | Horas: ' + horasTrabajadas.toFixed(1) + 'h | Costo: $' + Number(costo).toLocaleString('es-CO') + '</span>';
                        html += '</div>';
                        html += '<span class="badge-status activo">En obra</span>';
                        html += '<button type="button" class="btn-remove" onclick="eliminarEmpleadoObra(' + e + ')"><i class="fas fa-times"></i></button>';
                        html += '</div>';
                    }
                    html += '<div class="list-item" style="background:var(--gray-100); font-weight:700;">';
                    html += '<span>Total Horas: ' + totalHoras.toFixed(1) + 'h | Costo Total: $' + Number(totalCosto).toLocaleString('es-CO') + '</span>';
                    html += '</div>';
                } else {
                    html += '<p class="empty-items">No hay empleados asignados a esta obra</p>';
                }
                html += '</div>';
                
                html += '</div>';
                return html;
            }

            function calcularHorasTrabajadas(horaEntrada, horaSalida, almuerzo) {
                var partsEntrada = horaEntrada.split(':');
                var partsSalida = horaSalida.split(':');
                var horas = (parseInt(partsSalida[0]) + parseInt(partsSalida[1]) / 60) - (parseInt(partsEntrada[0]) + parseInt(partsEntrada[1]) / 60);
                if (almuerzo) horas -= 1;
                return Math.max(0, horas);
            }

