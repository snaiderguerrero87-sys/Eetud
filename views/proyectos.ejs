                var proyecto = proyectoEnGestion;
                if (!proyecto) return;

                if (proyecto.herramientasObra && proyecto.herramientasObra.length > index) {
                    var fechaSalida = prompt('Ingresa la fecha de salida (YYYY-MM-DD):', new Date().toISOString().split('T')[0]);
                    if (fechaSalida) {
                        var horaSalida = prompt('Ingresa la hora de salida (HH:MM):', '17:00');
