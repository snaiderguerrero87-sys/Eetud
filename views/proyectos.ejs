            // ============================================================
            // ===== RENDER TOTALES =====
            // ============================================================
            
            function renderTotales() {
                var proyecto = proyectoEnGestion;
                var totalAPUs = 0;
                var totalCompletados = 0;
                var totalPendientes = 0;
                var totalValorTotal = 0;
                var totalValorRealizado = 0;
                var totalValorPendiente = 0;

                for (var i = 0; i < proyecto.items.length; i++) {
                    if (proyecto.items[i].tipo === 'apu') {
                        totalAPUs++;
                        var cantTotal = proyecto.items[i].cantidad || 0;
                        var cantReal = proyecto.items[i].cantidadRealizada || 0;
                        if (cantReal >= cantTotal && cantTotal > 0) totalCompletados++;
                        else if (cantTotal > 0) totalPendientes++;
                        totalValorTotal += proyecto.items[i].valorTotalItem || 0;
                        totalValorRealizado += proyecto.items[i].valorEjecutado || 0;
                        totalValorPendiente += proyecto.items[i].valorPendiente || 0;
                    }
                }

                var herramientasEnObra = proyecto.herramientasObra ? proyecto.herramientasObra.filter(function(h) { return !h.fechaSalida; }).length : 0;
                var totalHorasEmpleados = 0;
                var totalCostoEmpleados = 0;
                if (proyecto.empleadosObra) {
                    for (var e = 0; e < proyecto.empleadosObra.length; e++) {
                        var emp = proyecto.empleadosObra[e];
                        var costoHora = 0;
                        for (var ee = 0; ee < empleadosData.length; ee++) {
                            if (empleadosData[ee].id === emp.empleadoId) { costoHora = empleadosData[ee].costoHora || 0; break; }
                        }
                        var horas = calcularHorasTrabajadas(emp.horaEntrada || '08:00', emp.horaSalida || '17:00', emp.almuerzo || false);
                        totalHorasEmpleados += horas;
                        totalCostoEmpleados += horas * costoHora;
                    }
                }

                var totalComprasValor = 0;
                var totalCompras = proyecto.compras ? proyecto.compras.length : 0;
                if (proyecto.compras) {
                    for (var c = 0; c < proyecto.compras.length; c++) {
                        totalComprasValor += proyecto.compras[c].valor || 0;
                    }
                }

                var avanceTotal = Math.round(proyecto.avanceTotal || 0);

                var html = '<div class="tab-content active">';
                html += '<h4><i class="fas fa-chart-pie"></i> Resumen del Proyecto</h4>';
                html += '<div class="totales-grid">';
                html += '<div class="total-card blue"><div class="icon"><i class="fas fa-list"></i></div><div class="numero">' + totalAPUs + '</div><div class="label">Total APUs</div>';
                html += '<div class="sub-info">✅ Completados: <span class="destacado">' + totalCompletados + '</span> | ⏳ Pendientes: <span class="destacado">' + totalPendientes + '</span></div>';
                html += '<div class="sub-info" style="border-top: 2px solid var(--gray-200); margin-top:8px; padding-top:8px;">📊 Avance: <span class="destacado">' + avanceTotal + '%</span></div></div>';
                html += '<div class="total-card green"><div class="icon"><i class="fas fa-tools"></i></div><div class="numero">' + herramientasEnObra + '</div><div class="label">Herramientas en Obra</div>';
                html += '<div class="sub-info">Total asignadas: ' + (proyecto.herramientasObra ? proyecto.herramientasObra.length : 0) + '</div></div>';
                html += '<div class="total-card orange"><div class="icon"><i class="fas fa-users"></i></div><div class="numero">' + totalHorasEmpleados.toFixed(1) + 'h</div><div class="label">Horas Trabajadas</div>';
                html += '<div class="sub-info">Costo: <span class="destacado">$' + Number(totalCostoEmpleados).toLocaleString('es-CO') + '</span></div></div>';
                html += '<div class="total-card purple"><div class="icon"><i class="fas fa-shopping-cart"></i></div><div class="numero">' + totalCompras + '</div><div class="label">Compras</div>';
                html += '<div class="sub-info">Total: <span class="destacado">$' + Number(totalComprasValor).toLocaleString('es-CO') + '</span></div></div>';
                html += '</div>';

                html += '<div class="totales-detalle"><div class="columna">';
                html += '<h5><i class="fas fa-dollar-sign"></i> Resumen de Costos</h5>';
                html += '<div class="total-item-detalle"><span class="label">Mano de Obra</span><span class="valor primary">$' + Number(totalCostoEmpleados).toLocaleString('es-CO') + '</span></div>';
                html += '<div class="total-item-detalle"><span class="label">Horas Trabajadas</span><span class="valor">' + totalHorasEmpleados.toFixed(1) + 'h</span></div>';
                html += '<div class="total-item-detalle"><span class="label">Compras</span><span class="valor primary">$' + Number(totalComprasValor).toLocaleString('es-CO') + '</span></div>';
                html += '<div class="total-item-detalle"><span class="label">Herramientas en Obra</span><span class="valor">' + herramientasEnObra + '</span></div>';
                html += '<div class="total-item-detalle total-row"><span class="label">Total Costos</span><span class="valor">$' + Number(totalCostoEmpleados + totalComprasValor).toLocaleString('es-CO') + '</span></div>';
                html += '<div style="margin-top:12px; padding-top:12px; border-top:2px solid var(--gray-200);">';
                html += '<div class="total-item-detalle"><span class="label">Valor Total Proyecto</span><span class="valor primary">$' + Number(totalValorTotal).toLocaleString('es-CO') + '</span></div>';
                html += '<div class="total-item-detalle"><span class="label">Valor Realizado</span><span class="valor success">$' + Number(totalValorRealizado).toLocaleString('es-CO') + '</span></div>';
                html += '<div class="total-item-detalle"><span class="label">Valor Pendiente</span><span class="valor warning">$' + Number(totalValorPendiente).toLocaleString('es-CO') + '</span></div>';
                html += '</div></div></div></div>';
                return html;
            }

            // ============================================================
            // ===== FUNCIONES DE HERRAMIENTAS =====
            // ============================================================
            
            function agregarHerramientaObra() {
                var proyecto = proyectoEnGestion;
                if (!proyecto) return;

                var selectHerramienta = document.getElementById('selectHerramientaObra');
                var selectResponsable = document.getElementById('selectResponsableObra');
                var fechaEntrada = document.getElementById('fechaEntradaHerramienta');
                var horaEntrada = document.getElementById('horaEntradaHerramienta');
                var fechaSalida = document.getElementById('fechaSalidaHerramienta');
                var horaSalida = document.getElementById('horaSalidaHerramienta');

                var herramientaId = parseInt(selectHerramienta.value);
                var responsableId = parseInt(selectResponsable.value);

                if (!herramientaId || !responsableId) { alert('Selecciona una herramienta y un responsable'); return; }

                if (!proyecto.herramientasObra) proyecto.herramientasObra = [];

                proyecto.herramientasObra.push({
                    herramientaId: herramientaId,
                    responsableId: responsableId,
                    fechaEntrada: fechaEntrada ? fechaEntrada.value : new Date().toISOString().split('T')[0],
                    horaEntrada: horaEntrada ? horaEntrada.value : '08:00',
                    fechaSalida: fechaSalida ? fechaSalida.value : '',
                    horaSalida: horaSalida ? horaSalida.value : '',
                    fechaAsignacion: new Date().toISOString()
                });

                guardarGestionProyecto().then(function() {
                    cargarContenidoPestana('herramientas');
                });
                mostrarNotificacion('✅ Herramienta asignada a la obra');
            }

            function registrarSalidaHerramienta(index) {
                var proyecto = proyectoEnGestion;
                if (!proyecto) return;
                if (proyecto.herramientasObra && proyecto.herramientasObra.length > index) {
                    var fechaSalida = prompt('Fecha de salida (YYYY-MM-DD):', new Date().toISOString().split('T')[0]);
                    if (fechaSalida) {
                        var horaSalida = prompt('Hora de salida (HH:MM):', '17:00');
                        if (horaSalida) {
                            proyecto.herramientasObra[index].fechaSalida = fechaSalida;
                            proyecto.herramientasObra[index].horaSalida = horaSalida;
                            guardarGestionProyecto().then(function() {
                                cargarContenidoPestana('herramientas');
                            });
                        }
                    }
                }
            }

            function eliminarHerramientaObra(index) {
                if (!confirm('¿Eliminar esta herramienta de la obra?')) return;
                var proyecto = proyectoEnGestion;
                if (!proyecto) return;
                if (proyecto.herramientasObra && proyecto.herramientasObra.length > index) {
                    proyecto.herramientasObra.splice(index, 1);
                    guardarGestionProyecto().then(function() {
                        cargarContenidoPestana('herramientas');
                    });
                }
            }

            // ============================================================
            // ===== FUNCIONES DE EMPLEADOS =====
            // ============================================================
            
            function agregarEmpleadoObra() {
                var proyecto = proyectoEnGestion;
                if (!proyecto) return;

                var selectEmpleado = document.getElementById('selectEmpleadoObra');
                var fecha = document.getElementById('fechaEmpleado');
                var horaEntrada = document.getElementById('horaEntradaEmpleado');
                var horaSalida = document.getElementById('horaSalidaEmpleado');
                var almuerzo = document.getElementById('almuerzoEmpleado');

                var empleadoId = parseInt(selectEmpleado.value);

                if (!empleadoId) { alert('Selecciona un empleado'); return; }

                if (!proyecto.empleadosObra) proyecto.empleadosObra = [];

                proyecto.empleadosObra.push({
                    empleadoId: empleadoId,
                    fecha: fecha ? fecha.value : new Date().toISOString().split('T')[0],
                    horaEntrada: horaEntrada ? horaEntrada.value : '08:00',
                    horaSalida: horaSalida ? horaSalida.value : '17:00',
                    almuerzo: almuerzo ? almuerzo.checked : false
                });

                guardarGestionProyecto().then(function() {
                    cargarContenidoPestana('empleados');
                });
                mostrarNotificacion('✅ Empleado asignado a la obra');
            }

            function eliminarEmpleadoObra(index) {
                if (!confirm('¿Eliminar este empleado de la obra?')) return;
                var proyecto = proyectoEnGestion;
                if (!proyecto) return;
                if (proyecto.empleadosObra && proyecto.empleadosObra.length > index) {
                    proyecto.empleadosObra.splice(index, 1);
                    guardarGestionProyecto().then(function() {
                        cargarContenidoPestana('empleados');
                    });
                }
            }

            // ============================================================
            // ===== FUNCIONES DE COMPRAS =====
            // ============================================================
            
            function agregarCompra() {
                var proyecto = proyectoEnGestion;
                if (!proyecto) return;

                var factura = document.getElementById('facturaCompra');
                var proveedor = document.getElementById('proveedorCompra');
                var fecha = document.getElementById('fechaCompra');
                var responsable = document.getElementById('responsableCompra');
                var valor = document.getElementById('valorCompra');

                var facturaVal = factura.value.trim();
                var proveedorVal = proveedor.value.trim();
                var fechaVal = fecha.value;
                var responsableId = parseInt(responsable.value);
                var valorVal = parseFloat(valor.value) || 0;

                if (!facturaVal || !proveedorVal || !fechaVal || !responsableId || valorVal <= 0) {
                    alert('Completa todos los campos de la compra');
                    return;
                }

                if (!proyecto.compras) proyecto.compras = [];

                proyecto.compras.push({
                    factura: facturaVal,
                    proveedor: proveedorVal,
                    fecha: fechaVal,
                    responsableId: responsableId,
                    valor: valorVal
                });

                guardarGestionProyecto().then(function() {
                    cargarContenidoPestana('compras');
                });
                mostrarNotificacion('✅ Compra agregada');
            }

            function eliminarCompra(index) {
                if (!confirm('¿Eliminar esta compra?')) return;
                var proyecto = proyectoEnGestion;
                if (!proyecto) return;
                if (proyecto.compras && proyecto.compras.length > index) {
                    proyecto.compras.splice(index, 1);
                    guardarGestionProyecto().then(function() {
                        cargarContenidoPestana('compras');
                    });
                }
            }

            // ============================================================
            // ===== ACTUALIZAR CANTIDAD REALIZADA =====
            // ============================================================
            
            function actualizarCantidadRealizada(itemIndex, valor) {
                var cantidad = parseFloat(valor) || 0;
                if (cantidad < 0) cantidad = 0;

                if (!proyectoEnGestion) return;
                var item = proyectoEnGestion.items[itemIndex];
                if (!item || item.tipo !== 'apu') return;

                var cantidadTotal = item.cantidad || 0;
                if (cantidad > cantidadTotal) {
                    alert('La cantidad realizada no puede ser mayor que la cantidad total (' + cantidadTotal + ')');
                    cargarContenidoPestana('actividades');
                    return;
                }

                item.cantidadRealizada = cantidad;
                item.cantidadPendiente = cantidadTotal - cantidad;
                item.porcentajeAvance = cantidadTotal > 0 ? (cantidad / cantidadTotal * 100) : 0;
                item.valorEjecutado = (item.valorUnitario || 0) * cantidad;
                item.valorPendiente = item.valorTotalItem - item.valorEjecutado;

                calcularValoresProyecto(proyectoEnGestion);
                guardarGestionProyecto().then(function() {
                    cargarContenidoPestana(pestanaActual);
                });
            }

            // ============================================================
            // ===== MODAL PROYECTO =====
            // ============================================================
            
            function abrirModalProyecto() {
                var modal = document.getElementById('modalProyecto');
                if (!modal) return;
                cargarCotizaciones().then(function() {
                    modal.style.display = 'flex';
                });
            }

            function cerrarModalProyecto() {
                var modal = document.getElementById('modalProyecto');
                if (modal) modal.style.display = 'none';
            }

            // ============================================================
            // ===== MODAL GESTIÓN =====
            // ============================================================
            
            async function abrirGestionProyecto(id) {
                var proyecto = null;
                for (var i = 0; i < proyectos.length; i++) {
                    if (proyectos[i].id === id) { proyecto = proyectos[i]; break; }
                }
                if (!proyecto) { alert('Proyecto no encontrado'); return; }

                proyectoEnGestion = JSON.parse(JSON.stringify(proyecto));
                proyectoIdEnGestion = id;

                await cargarHerramientas();
                await cargarEmpleados();

                var modal = document.getElementById('modalGestion');
                var titulo = document.getElementById('modalTituloGestion');
                titulo.textContent = 'Gestión de Proyecto: ' + (proyecto.nombre || 'Proyecto #' + proyecto.id);

                pestanaActual = 'actividades';
                var btns = document.querySelectorAll('.tab-btn');
                for (var j = 0; j < btns.length; j++) {
                    btns[j].classList.remove('active');
                    if (btns[j].dataset.tab === 'actividades') btns[j].classList.add('active');
                }

                cargarContenidoPestana('actividades');
                modal.style.display = 'flex';
            }

            function cerrarModalGestion() {
                var modal = document.getElementById('modalGestion');
                if (modal) modal.style.display = 'none';
                proyectoEnGestion = null;
                proyectoIdEnGestion = null;
            }

            // ============================================================
            // ===== BORRAR TODOS =====
            // ============================================================
            
            function borrarTodos() {
                if (!proyectos || proyectos.length === 0) { alert('No hay proyectos para borrar'); return; }
                if (!confirm('⚠️ ¿Borrar TODOS tus proyectos? Esta acción no se puede deshacer.')) return;

                var promesas = [];
                for (var i = 0; i < proyectos.length; i++) {
                    promesas.push(fetch('/api/proyectos/' + proyectos[i].id, { method: 'DELETE' }));
                }
                Promise.all(promesas)
                    .then(function() { return cargarProyectos(); })
                    .then(function() { mostrarNotificacion('Todos los proyectos fueron eliminados'); });
            }

            // ============================================================
            // ===== NOTIFICACIONES =====
            // ============================================================
            
            function mostrarNotificacion(mensaje) {
                var notificacion = document.createElement('div');
                notificacion.className = 'notification';
                notificacion.textContent = mensaje;
                document.body.appendChild(notificacion);
                setTimeout(function() { notificacion.classList.add('show'); }, 100);
                setTimeout(function() {
                    notificacion.classList.remove('show');
                    setTimeout(function() { notificacion.remove(); }, 300);
                }, 3000);
            }

            // ============================================================
            // ===== INICIALIZAR =====
            // ============================================================
            
            document.addEventListener('DOMContentLoaded', function() {
                cargarProyectos();
                cargarCotizaciones();
                cargarHerramientas();
                cargarEmpleados();
            });

            window.onclick = function(event) {
                var modalProyecto = document.getElementById('modalProyecto');
                if (event.target === modalProyecto) cerrarModalProyecto();
                var modalGestion = document.getElementById('modalGestion');
                if (event.target === modalGestion) cerrarModalGestion();
            };
        </script>
