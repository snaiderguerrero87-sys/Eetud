            // ===== FUNCIONES DE COMPRAS =====
            function agregarCompra() {
                var proyecto = proyectoEnGestion;
                if (!proyecto) return;

                var factura = document.getElementById('facturaCompra');
                var proveedor = document.getElementById('proveedorCompra');
                var fecha = document.getElementById('fechaCompra');
                var responsable = document.getElementById('responsableCompra');
                var valor = document.getElementById('valorCompra');

                if (!factura || !proveedor || !fecha || !responsable || !valor) return;

                var facturaVal = factura.value.trim();
                var proveedorVal = proveedor.value.trim();
                var fechaVal = fecha.value;
                var responsableId = parseInt(responsable.value);
                var valorVal = parseFloat(valor.value) || 0;

                if (!facturaVal || !proveedorVal || !fechaVal || !responsableId || valorVal <= 0) {
                    alert('Completa todos los campos de la compra');
                    return;
                }

                if (!proyecto.compras) {
                    proyecto.compras = [];
                }

                proyecto.compras.push({
                    factura: facturaVal,
                    proveedor: proveedorVal,
                    fecha: fechaVal,
                    responsableId: responsableId,
                    valor: valorVal
                });

                guardarProyectos();
                cargarContenidoPestana('compras');
                mostrarNotificacion('✅ Compra agregada');
                
                factura.value = '';
                proveedor.value = '';
                valor.value = '';
                responsable.value = '';
            }

            function eliminarCompra(index) {
                if (confirm('¿Eliminar esta compra?')) {
                    var proyecto = proyectoEnGestion;
                    if (!proyecto) return;

                    if (proyecto.compras && proyecto.compras.length > index) {
                        proyecto.compras.splice(index, 1);
                        guardarProyectos();
                        cargarContenidoPestana('compras');
                        mostrarNotificacion('Compra eliminada');
                    }
                }
            }

            // ===== ACTUALIZAR CANTIDAD REALIZADA =====
            function actualizarCantidadRealizada(proyectoId, itemIndex, valor) {
                var cantidad = parseFloat(valor) || 0;
                if (cantidad < 0) cantidad = 0;

                var proyecto = null;
                for (var i = 0; i < proyectos.length; i++) {
                    if (proyectos[i].id === proyectoId) {
                        proyecto = proyectos[i];
                        break;
                    }
                }

                if (!proyecto) return;

                var item = proyecto.items[itemIndex];
                if (!item || item.tipo !== 'apu') return;

                var cantidadTotal = item.cantidad || 0;
                if (cantidad > cantidadTotal) {
                    alert('La cantidad realizada no puede ser mayor que la cantidad total (' + cantidadTotal + ')');
                    var inputs = document.querySelectorAll('.cantidad-input');
                    for (var j = 0; j < inputs.length; j++) {
                        if (inputs[j].value === String(valor)) {
                            inputs[j].value = item.cantidadRealizada || 0;
                            break;
                        }
                    }
                    return;
                }

                item.cantidadRealizada = cantidad;
                item.cantidadPendiente = cantidadTotal - cantidad;
                item.porcentajeAvance = cantidadTotal > 0 ? (cantidad / cantidadTotal * 100) : 0;
                item.valorEjecutado = (item.valorUnitario || 0) * cantidad;
                item.valorPendiente = item.valorTotalItem - item.valorEjecutado;

                calcularValoresProyecto(proyecto);
                cargarContenidoPestana(pestanaActual);
            }

            // ===== MODAL PROYECTO =====
            function abrirModalProyecto() {
                var modal = document.getElementById('modalProyecto');
                if (!modal) return;
                cargarCotizaciones();
                modal.style.display = 'flex';
            }

            function cerrarModalProyecto() {
                var modal = document.getElementById('modalProyecto');
                if (modal) modal.style.display = 'none';
            }

            // ===== MODAL GESTIÓN =====
            function abrirGestionProyecto(id) {
                var proyecto = null;
                for (var i = 0; i < proyectos.length; i++) {
                    if (proyectos[i].id === id) {
                        proyecto = proyectos[i];
                        break;
                    }
                }
                if (!proyecto) {
                    alert('Proyecto no encontrado');
                    return;
                }

                proyectoEnGestion = proyecto;
                proyectoIdEnGestion = id;

                cargarHerramientas();
                cargarEmpleados();

                var modal = document.getElementById('modalGestion');
                var titulo = document.getElementById('modalTituloGestion');
                titulo.textContent = 'Gestión de Proyecto: ' + (proyecto.nombre || 'Proyecto #' + proyecto.id);

                pestanaActual = 'actividades';
                var btns = document.querySelectorAll('.tab-btn');
                btns.forEach(function(btn) {
                    btn.classList.remove('active');
                    if (btn.dataset.tab === 'actividades') {
                        btn.classList.add('active');
                    }
                });

                cargarContenidoPestana('actividades');
                modal.style.display = 'flex';
            }

            function cerrarModalGestion() {
                var modal = document.getElementById('modalGestion');
                if (modal) modal.style.display = 'none';
                proyectoEnGestion = null;
                proyectoIdEnGestion = null;
            }

            // ===== BORRAR CACHÉ =====
            function borrarCache() {
                if (confirm('⚠️ ¿Estás seguro de borrar TODOS los datos guardados? Esta acción no se puede deshacer.')) {
                    localStorage.clear();
                    proyectos = [];
                    cotizaciones = [];
                    guardarProyectos();
                    mostrarNotificacion('🗑️ Caché borrada correctamente');
                    renderizarTablaProyectos();
                }
            }

            // ===== NOTIFICACIONES =====
            function mostrarNotificacion(mensaje) {
                var notificacion = document.createElement('div');
                notificacion.className = 'notification';
                notificacion.textContent = mensaje;
                document.body.appendChild(notificacion);
                setTimeout(function() {
                    notificacion.classList.add('show');
                }, 100);
                setTimeout(function() {
                    notificacion.classList.remove('show');
                    setTimeout(function() {
                        notificacion.remove();
                    }, 300);
                }, 3000);
            }

            // ===== CERRAR MODALES AL HACER CLIC FUERA =====
            window.onclick = function(event) {
                var modalProyecto = document.getElementById('modalProyecto');
                if (event.target === modalProyecto) {
                    cerrarModalProyecto();
                }
                var modalGestion = document.getElementById('modalGestion');
                if (event.target === modalGestion) {
                    cerrarModalGestion();
                }
            };

            // ===== INICIALIZAR =====
            document.addEventListener('DOMContentLoaded', function() {
                cargarProyectos();
                cargarCotizaciones();
                cargarHerramientas();
                cargarEmpleados();
            });
        </script>
