            // ===== RENDERIZAR COTIZACIONES DISPONIBLES =====
            function renderizarCotizacionesDisponibles() {
                var container = document.getElementById('listaCotizacionesDisponibles');
                if (!container) return;

                var idsEnProyectos = [];
                for (var i = 0; i < proyectos.length; i++) {
                    if (proyectos[i].cotizacionId) {
                        idsEnProyectos.push(proyectos[i].cotizacionId);
                    }
                }

                var disponibles = [];
                for (var j = 0; j < cotizaciones.length; j++) {
                    if (idsEnProyectos.indexOf(cotizaciones[j].id) === -1) {
                        disponibles.push(cotizaciones[j]);
                    }
                }

                if (disponibles.length === 0) {
                    container.innerHTML = '<p class="empty-items">No hay cotizaciones disponibles para convertir en proyectos.</p>';
                    return;
                }

                var html = '';
                for (var k = 0; k < disponibles.length; k++) {
                    var c = disponibles[k];
                    html += '<div class="cotizacion-item">';
                    html += '<label class="checkbox-label">';
                    html += '<input type="checkbox" class="cotizacion-checkbox" value="' + c.id + '">';
                    html += '<span class="checkmark"></span>';
                    html += '<span class="cotizacion-info">';
                    html += '<strong>' + (c.numero || 'COT-XXX') + '</strong> - ';
                    html += c.cliente || 'Sin cliente';
                    html += ' ($' + Number(c.valorTotalFinal || c.valorTotal || 0).toLocaleString('es-CO') + ')';
                    html += '</span>';
                    html += '</label>';
                    html += '</div>';
                }
                container.innerHTML = html;
            }

            // ===== CREAR PROYECTO DESDE COTIZACIONES =====
            function crearProyectoDesdeCotizaciones() {
                var checkboxes = document.querySelectorAll('.cotizacion-checkbox:checked');
                if (checkboxes.length === 0) {
                    alert('Selecciona al menos una cotización');
                    return;
                }

                var ids = [];
                for (var i = 0; i < checkboxes.length; i++) {
                    ids.push(parseInt(checkboxes[i].value));
                }

                var cotizacionesSeleccionadas = [];
                for (var j = 0; j < cotizaciones.length; j++) {
                    if (ids.indexOf(cotizaciones[j].id) !== -1) {
                        cotizacionesSeleccionadas.push(cotizaciones[j]);
                    }
                }

                var nuevoId = 1;
                if (proyectos.length > 0) {
                    var maxId = 0;
                    for (var m = 0; m < proyectos.length; m++) {
                        if (proyectos[m].id > maxId) {
                            maxId = proyectos[m].id;
                        }
                    }
                    nuevoId = maxId + 1;
                }

                var cotizacion = cotizacionesSeleccionadas[0];
                var proyecto = {
                    id: nuevoId,
                    nombre: 'Proyecto #' + nuevoId,
                    cliente: cotizacion.cliente || 'Sin cliente',
                    tipo: cotizacion.tipo || '',
                    proyectoNombre: cotizacion.proyecto || '',
                    objetivo: cotizacion.objetivo || '',
                    direccion: cotizacion.direccion || '',
                    cotizacionId: cotizacion.id,
                    cotizacionNumero: cotizacion.numero || 'COT-XXX',
                    cotizacionData: cotizacion,
                    fechaCreacion: new Date().toISOString(),
                    items: JSON.parse(JSON.stringify(cotizacion.items || [])),
                    ajustes: cotizacion.ajustes || {},
                    valorTotal: 0,
                    avanceItems: [],
                    avanceTotal: 0,
                    valorEjecutado: 0,
                    saldo: 0,
                    herramientasObra: [],
                    empleadosObra: [],
                    compras: []
                };

                if (proyecto.items) {
                    for (var k = 0; k < proyecto.items.length; k++) {
                        if (proyecto.items[k].tipo === 'apu') {
                            var valorUnitario = proyecto.items[k].valorUnitario || 0;
                            var cantidad = proyecto.items[k].cantidad || 0;
                            proyecto.items[k].cantidadRealizada = 0;
                            proyecto.items[k].cantidadPendiente = cantidad;
                            proyecto.items[k].porcentajeAvance = 0;
                            proyecto.items[k].valorEjecutado = 0;
                            proyecto.items[k].valorTotalItem = valorUnitario * cantidad;
                            proyecto.items[k].valorPendiente = proyecto.items[k].valorTotalItem;
                        }
                    }
                }

                calcularValoresProyecto(proyecto);
                proyectos.push(proyecto);
                guardarProyectos();
                cerrarModalProyecto();
                mostrarNotificacion('✅ Proyecto creado exitosamente');
            }

            // ===== CALCULAR VALORES DEL PROYECTO =====
            function calcularValoresProyecto(proyecto) {
                var totalAPUs = 0;
                var totalAvance = 0;
                var valorTotal = 0;
                var valorEjecutado = 0;

                if (!proyecto.items) return;

                for (var i = 0; i < proyecto.items.length; i++) {
                    if (proyecto.items[i].tipo === 'apu') {
                        totalAPUs++;
                        var cantidadTotal = proyecto.items[i].cantidad || 0;
                        var cantidadRealizada = proyecto.items[i].cantidadRealizada || 0;
                        var valorUnitario = proyecto.items[i].valorUnitario || 0;
                        
                        proyecto.items[i].valorTotalItem = valorUnitario * cantidadTotal;
                        proyecto.items[i].valorEjecutado = valorUnitario * cantidadRealizada;
                        proyecto.items[i].valorPendiente = proyecto.items[i].valorTotalItem - proyecto.items[i].valorEjecutado;
                        proyecto.items[i].porcentajeAvance = cantidadTotal > 0 ? (cantidadRealizada / cantidadTotal * 100) : 0;
                        
                        totalAvance += proyecto.items[i].porcentajeAvance;
                        valorEjecutado += proyecto.items[i].valorEjecutado;
                        valorTotal += proyecto.items[i].valorTotalItem;
                    }
                }

                proyecto.avanceTotal = totalAPUs > 0 ? (totalAvance / totalAPUs) : 0;
                proyecto.valorEjecutado = valorEjecutado;
                proyecto.valorTotal = valorTotal;
                proyecto.saldo = valorTotal - valorEjecutado;
            }

            // ===== RENDERIZAR TABLA DE PROYECTOS =====
            function renderizarTablaProyectos() {
                var tbody = document.getElementById('cuerpoTabla');
                var sinDatos = document.getElementById('sinDatos');
                var tabla = document.getElementById('tablaProyectos');

                if (!tbody) return;

                if (!proyectos || proyectos.length === 0) {
                    tbody.innerHTML = '';
                    if (sinDatos) sinDatos.style.display = 'block';
                    if (tabla) tabla.style.display = 'none';
                    return;
                }

                if (sinDatos) sinDatos.style.display = 'none';
                if (tabla) tabla.style.display = 'table';

                var html = '';
                for (var i = 0; i < proyectos.length; i++) {
                    var p = proyectos[i];
                    var avance = p.avanceTotal || 0;
                    var valorFormateado = '$' + Number(p.valorTotal || 0).toLocaleString('es-CO');
                    
                    html += '<tr>';
                    html += '<td><strong>' + p.id + '</strong></td>';
                    html += '<td>' + (p.nombre || 'Proyecto #' + p.id) + '</td>';
                    html += '<td>' + (p.cliente || '-') + '</td>';
                    html += '<td>' + (p.cotizacionNumero || '-') + '</td>';
                    html += '<td>';
                    html += '<div class="progress-bar-mini">';
                    html += '<div class="progress-fill-mini" style="width:' + avance + '%;"></div>';
                    html += '<span class="progress-text-mini">' + Math.round(avance) + '%</span>';
                    html += '</div>';
                    html += '</td>';
                    html += '<td>' + valorFormateado + '</td>';
                    html += '<td>';
                    html += '<button class="btn-edit" onclick="abrirGestionProyecto(' + p.id + ')">';
                    html += '<i class="fas fa-tasks"></i> Gestión</button>';
                    html += '<button class="btn-delete" onclick="eliminarProyecto(' + p.id + ')">';
                    html += '<i class="fas fa-trash"></i>';
                    html += '</button>';
                    html += '</td>';
                    html += '</tr>';
                }
                tbody.innerHTML = html;
            }

            // ===== GUARDAR PROYECTOS =====
            function guardarProyectos() {
                localStorage.setItem('proyectos', JSON.stringify(proyectos));
                renderizarTablaProyectos();
                if (window.actualizarUbicacionesHerramientas) {
                    window.actualizarUbicacionesHerramientas();
                }
            }

            // ===== ELIMINAR PROYECTO =====
            function eliminarProyecto(id) {
                if (confirm('¿Estás seguro de eliminar este proyecto?')) {
                    var nuevosProyectos = [];
                    for (var i = 0; i < proyectos.length; i++) {
                        if (proyectos[i].id !== id) {
                            nuevosProyectos.push(proyectos[i]);
                        }
                    }
                    proyectos = nuevosProyectos;
                    guardarProyectos();
                    mostrarNotificacion('Proyecto eliminado');
                }
            }

            // ===== GUARDAR GESTIÓN =====
            function guardarGestionProyecto() {
                if (proyectoEnGestion) {
                    calcularValoresProyecto(proyectoEnGestion);
                    guardarProyectos();
                    mostrarNotificacion('✅ Cambios guardados exitosamente');
                }
            }

            // ===== CAMBIAR PESTAÑA =====
            function cambiarPestana(tab) {
                pestanaActual = tab;
                
                var btns = document.querySelectorAll('.tab-btn');
                btns.forEach(function(btn) {
                    btn.classList.remove('active');
                    if (btn.dataset.tab === tab) {
                        btn.classList.add('active');
                    }
                });
                
                cargarContenidoPestana(tab);
            }

            // ===== CARGAR CONTENIDO DE PESTAÑA =====
            function cargarContenidoPestana(tab) {
                if (!proyectoEnGestion) return;
                
                var contenido = document.getElementById('gestionContenido');
                
                switch(tab) {
                    case 'actividades':
                        contenido.innerHTML = renderActividades();
                        break;
                    case 'herramientas':
                        contenido.innerHTML = renderHerramientas();
                        break;
                    case 'empleados':
                        contenido.innerHTML = renderEmpleados();
                        break;
                    case 'compras':
                        contenido.innerHTML = renderCompras();
                        break;
                    case 'totales':
                        contenido.innerHTML = renderTotales();
                        break;
                }
