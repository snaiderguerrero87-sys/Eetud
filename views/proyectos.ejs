            // ===== RENDER TOTALES =====
            function renderTotales() {
                var proyecto = proyectoEnGestion;
                
                // Contar solo APUs
                var totalAPUs = 0;
                var totalCompletados = 0;
                var totalPendientes = 0;
                var totalCantidades = 0;
                var totalRealizado = 0;
                var totalPendiente = 0;
                var totalValorTotal = 0;
                var totalValorRealizado = 0;
                var totalValorPendiente = 0;
                
                for (var i = 0; i < proyecto.items.length; i++) {
                    if (proyecto.items[i].tipo === 'apu') {
                        totalAPUs++;
                        var cantTotal = proyecto.items[i].cantidad || 0;
                        var cantReal = proyecto.items[i].cantidadRealizada || 0;
                        if (cantReal >= cantTotal && cantTotal > 0) {
                            totalCompletados++;
                        } else if (cantTotal > 0) {
                            totalPendientes++;
                        }
                        totalCantidades += cantTotal;
                        totalRealizado += cantReal;
                        totalPendiente += (cantTotal - cantReal);
                        totalValorTotal += proyecto.items[i].valorTotalItem || 0;
                        totalValorRealizado += proyecto.items[i].valorEjecutado || 0;
                        totalValorPendiente += proyecto.items[i].valorPendiente || 0;
                    }
                }
                
                // Si no hay APUs, no contar pendientes
                if (totalAPUs === 0) {
                    totalCompletados = 0;
                    totalPendientes = 0;
                }
                
                var herramientasEnObra = proyecto.herramientasObra ? proyecto.herramientasObra.filter(function(h) { return !h.fechaSalida; }).length : 0;
                
                var totalHorasEmpleados = 0;
                var totalCostoEmpleados = 0;
                if (proyecto.empleadosObra) {
                    for (var e = 0; e < proyecto.empleadosObra.length; e++) {
                        var emp = proyecto.empleadosObra[e];
                        var costoHora = 0;
                        for (var ee = 0; ee < empleadosData.length; ee++) {
                            if (empleadosData[ee].id === emp.empleadoId) {
                                costoHora = empleadosData[ee].costoHora || 0;
                                break;
                            }
                        }
                        var horas = calcularHorasTrabajadas(emp.horaEntrada || '08:00', emp.horaSalida || '17:00', emp.almuerzo || false);
                        totalHorasEmpleados += horas;
                        totalCostoEmpleados += horas * costoHora;
                    }
                }
                
                var totalComprasValor = 0;
                var totalCompras = proyecto.compras ? proyecto.compras.length : 0;
                if (proyecto.compras) {
                    for (var c = 0; c < proyecto.compras.length; c++) {
                        totalComprasValor += proyecto.compras[c].valor || 0;
                    }
                }
                
                var avanceTotal = Math.round(proyecto.avanceTotal || 0);
                
                var html = '<div class="tab-content active">';
                html += '<h4><i class="fas fa-chart-pie"></i> Resumen del Proyecto</h4>';
                
                // Tarjetas
                html += '<div class="totales-grid">';
                
                // Total APUs
                html += '<div class="total-card blue">';
                html += '<div class="icon"><i class="fas fa-list"></i></div>';
                html += '<div class="numero">' + totalAPUs + '</div>';
                html += '<div class="label">Total APUs</div>';
                html += '<div class="sub-info">';
                html += '✅ Completados: <span class="destacado">' + totalCompletados + '</span> | ';
                html += '⏳ Pendientes: <span class="destacado">' + totalPendientes + '</span>';
                html += '</div>';
                html += '<div class="sub-info" style="border-top: 2px solid var(--gray-200); margin-top:8px; padding-top:8px;">';
                html += '📊 Avance: <span class="destacado">' + avanceTotal + '%</span>';
                html += '</div>';
                html += '</div>';
                
                // Herramientas
                html += '<div class="total-card green">';
                html += '<div class="icon"><i class="fas fa-tools"></i></div>';
                html += '<div class="numero">' + herramientasEnObra + '</div>';
                html += '<div class="label">Herramientas en Obra</div>';
                html += '<div class="sub-info">Total asignadas: ' + (proyecto.herramientasObra ? proyecto.herramientasObra.length : 0) + '</div>';
                html += '</div>';
                
                // Empleados
                html += '<div class="total-card orange">';
                html += '<div class="icon"><i class="fas fa-users"></i></div>';
                html += '<div class="numero">' + totalHorasEmpleados.toFixed(1) + 'h</div>';
                html += '<div class="label">Horas Trabajadas</div>';
                html += '<div class="sub-info">Costo: <span class="destacado">$' + Number(totalCostoEmpleados).toLocaleString('es-CO') + '</span></div>';
                html += '</div>';
                
                // Compras
                html += '<div class="total-card purple">';
                html += '<div class="icon"><i class="fas fa-shopping-cart"></i></div>';
                html += '<div class="numero">' + totalCompras + '</div>';
                html += '<div class="label">Compras</div>';
                html += '<div class="sub-info">Total: <span class="destacado">$' + Number(totalComprasValor).toLocaleString('es-CO') + '</span></div>';
                html += '</div>';
                
                html += '</div>';
                
                // Resumen de Costos
                html += '<div class="totales-detalle">';
                html += '<div class="columna">';
                html += '<h5><i class="fas fa-dollar-sign"></i> Resumen de Costos</h5>';
                html += '<div class="total-item-detalle"><span class="label">Mano de Obra</span><span class="valor primary">$' + Number(totalCostoEmpleados).toLocaleString('es-CO') + '</span></div>';
                html += '<div class="total-item-detalle"><span class="label">Horas Trabajadas</span><span class="valor">' + totalHorasEmpleados.toFixed(1) + 'h</span></div>';
                html += '<div class="total-item-detalle"><span class="label">Compras</span><span class="valor primary">$' + Number(totalComprasValor).toLocaleString('es-CO') + '</span></div>';
