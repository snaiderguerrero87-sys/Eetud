                            html += '<div class="campo"><label>Valor Total</label><span class="valor precio">$' + Number(valorTotal).toLocaleString('es-CO') + '</span></div>';
                            html += '<div class="campo"><label>Valor Realizado</label><span class="valor precio-realizada">$' + Number(valorRealizado).toLocaleString('es-CO') + '</span></div>';
                            html += '<div class="campo"><label>Valor Pendiente</label><span class="valor precio-pendiente">$' + Number(valorPendiente).toLocaleString('es-CO') + '</span></div>';
                            html += '</div>';
                            html += '<div class="apu-progress">';
                            html += '<div class="progress-bar"><div class="progress-fill" style="width:' + porcentaje + '%;"></div></div>';
