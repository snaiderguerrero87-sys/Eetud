            // ============================================================
            // ===== RENDER EMPLEADOS =====
            // ============================================================
            
            function renderEmpleados() {
                var proyecto = proyectoEnGestion;
                var html = '<div class="tab-content active">';
                html += '<h4><i class="fas fa-users"></i> Empleados en Obra</h4>';
                html += '<div class="fila-form">';
                html += '<div class="form-group half"><label>Seleccionar Empleado:</label><select id="selectEmpleadoObra" class="form-select"><option value="">-- Seleccionar --</option>';
                for (var i = 0; i < empleadosData.length; i++) {
                    html += '<option value="' + empleadosData[i].id + '">' + escapeHTML(empleadosData[i].nombre) + ' (' + escapeHTML(empleadosData[i].cargo || 'Sin cargo') + ') - $' + Number(empleadosData[i].costoHora || 0).toLocaleString('es-CO') + '/hora</option>';
                }
                html += '</select></div>';
                html += '<div class="form-group small"><label>Fecha:</label><input type="date" id="fechaEmpleado" class="form-control" value="' + new Date().toISOString().split('T')[0] + '"></div>';
                html += '<div class="form-group small"><label>Hora Entrada:</label><input type="time" id="horaEntradaEmpleado" class="form-control" value="08:00"></div>';
                html += '<div class="form-group small"><label>Hora Salida:</label><input type="time" id="horaSalidaEmpleado" class="form-control" value="17:00"></div>';
                html += '<div class="form-group check"><label><input type="checkbox" id="almuerzoEmpleado"> Almuerzo (1h)</label></div>';
                html += '<div class="form-group small" style="display:flex; align-items:flex-end;"><button type="button" class="btn-add" onclick="agregarEmpleadoObra()"><i class="fas fa-plus"></i> Agregar</button></div>';
                html += '</div>';

                html += '<div class="list-container">';
                if (proyecto.empleadosObra && proyecto.empleadosObra.length > 0) {
                    var totalHoras = 0;
                    var totalCosto = 0;
                    for (var e = 0; e < proyecto.empleadosObra.length; e++) {
                        var emp = proyecto.empleadosObra[e];
                        var nombreEmpleado = '';
                        var costoHora = 0;
                        for (var ee = 0; ee < empleadosData.length; ee++) {
                            if (empleadosData[ee].id === emp.empleadoId) {
                                nombreEmpleado = empleadosData[ee].nombre;
                                costoHora = empleadosData[ee].costoHora || 0;
                                break;
                            }
                        }
                        var fecha = emp.fecha ? new Date(emp.fecha).toLocaleDateString('es-CO') : '-';
                        var horaEntrada = emp.horaEntrada || '08:00';
                        var horaSalida = emp.horaSalida || '17:00';
                        var horasTrabajadas = calcularHorasTrabajadas(horaEntrada, horaSalida, emp.almuerzo || false);
                        var costo = horasTrabajadas * costoHora;
                        totalHoras += horasTrabajadas;
                        totalCosto += costo;
                        var almuerzoText = emp.almuerzo ? '✅ Con almuerzo' : '❌ Sin almuerzo';

                        html += '<div class="list-item">';
                        html += '<div class="info"><strong>' + escapeHTML(nombreEmpleado || 'Empleado #' + emp.empleadoId) + '</strong>';
                        html += '<span class="detalle">' + fecha + ' | Entrada: ' + horaEntrada + ' | Salida: ' + horaSalida + ' | ' + almuerzoText + ' | Horas: ' + horasTrabajadas.toFixed(1) + 'h | Costo: $' + Number(costo).toLocaleString('es-CO') + '</span></div>';
                        html += '<span class="badge-status activo">En obra</span>';
                        html += '<button type="button" class="btn-remove" onclick="eliminarEmpleadoObra(' + e + ')"><i class="fas fa-times"></i></button>';
                        html += '</div>';
                    }
                    html += '<div class="list-item" style="background:var(--gray-100); font-weight:700;"><span>Total Horas: ' + totalHoras.toFixed(1) + 'h | Costo Total: $' + Number(totalCosto).toLocaleString('es-CO') + '</span></div>';
                } else {
                    html += '<p class="empty-items">No hay empleados asignados a esta obra</p>';
                }
                html += '</div></div>';
                return html;
            }

            function calcularHorasTrabajadas(horaEntrada, horaSalida, almuerzo) {
                var partsEntrada = horaEntrada.split(':');
                var partsSalida = horaSalida.split(':');
                var horas = (parseInt(partsSalida[0]) + parseInt(partsSalida[1]) / 60) - (parseInt(partsEntrada[0]) + parseInt(partsEntrada[1]) / 60);
                if (almuerzo) horas -= 1;
                return Math.max(0, horas);
            }

