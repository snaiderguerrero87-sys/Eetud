            function obtenerValorBase(origen) {
                if (origen === 'materiales') {
                    return obtenerSubtotalMateriales();
                } else if (origen === 'manoDeObra') {
                    return obtenerSubtotalManoObra();
                } else if (origen === 'total') {
                    return obtenerValorTotalGeneral();
                }
                return 0;
            }

