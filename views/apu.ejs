            // ============================================================
            // ===== FUNCIONES APU =====
            // ============================================================
            
            function cargarAPU() {
                fetch('/api/apus')
                    .then(function(response) {
                        if (!response.ok) { throw new Error('Error al cargar APUs'); }
                        return response.json();
                    })
                    .then(function(data) {
                        if (data && data.length > 0) {
                            apus = data;
                            localStorage.setItem('apu', JSON.stringify(apus));
                            renderizarTablasAgrupadas();
                        } else {
                            cargarAPULocal();
                        }
                    })
                    .catch(function(error) { cargarAPULocal(); });
            }

            function cargarAPULocal() {
                var data = localStorage.getItem('apu');
                if (data) {
                    try { apus = JSON.parse(data); } catch (e) { apus = []; }
                } else { apus = []; }
                renderizarTablasAgrupadas();
            }

            function guardarAPU() {
                localStorage.setItem('apu', JSON.stringify(apus));
                fetch('/api/guardar-apus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(apus)
                }).catch(function(e) { console.log('Error al sincronizar', e); });
                renderizarTablasAgrupadas();
            }

            // ============================================================
            // ===== RENDERIZAR TABLAS AGRUPADAS POR CATEGORÍA =====
            // ============================================================
            
            function renderizarTablasAgrupadas() {
                var container = document.getElementById('contenedorTablas');
                var sinDatos = document.getElementById('sinDatos');
                
                var todasLasCategorias = [];
                
                for (var i = 0; i < categoriasGuardadas.length; i++) {
                    if (todasLasCategorias.indexOf(categoriasGuardadas[i]) === -1) {
                        todasLasCategorias.push(categoriasGuardadas[i]);
                    }
                }
                
                for (var j = 0; j < apus.length; j++) {
                    if (apus[j].categoria && todasLasCategorias.indexOf(apus[j].categoria) === -1) {
                        todasLasCategorias.push(apus[j].categoria);
                    }
                }
                
                todasLasCategorias.sort();
                
                if (todasLasCategorias.length === 0) {
                    container.innerHTML = '';
                    sinDatos.style.display = 'block';
                    return;
                }
                sinDatos.style.display = 'none';
                
                var html = '';
                
                for (var c = 0; c < todasLasCategorias.length; c++) {
                    var categoria = todasLasCategorias[c];
                    var items = apus.filter(function(a) {
                        return a.categoria === categoria;
                    });
                    var letra = obtenerLetraCategoria(categoria);
                    var tieneAPUs = items.length > 0;
                    
                    html += '<div class="categoria-tabla">';
                    html += '<div class="categoria-header">';
                    html += '<span class="letra">' + letra + '</span>';
                    html += categoria.toUpperCase();
                    html += ' <span style="font-weight:400; font-size:14px; opacity:0.8;">(' + items.length + ' APUs)</span>';
                    html += ' <span class="categoria-acciones">';
                    html += '<button class="btn-edit-categoria" data-categoria="' + categoria + '" title="Editar categoría"><i class="fas fa-edit"></i></button>';
                    html += '<button class="btn-delete-categoria" data-categoria="' + categoria + '" title="Eliminar categoría"><i class="fas fa-trash"></i></button>';
                    html += '</span>';
                    html += '</div>';
                    html += '<div class="categoria-body">';
                    
                    html += '<table>';
                    html += '<thead><tr>';
                    html += '<th>Código</th>';
                    html += '<th>Nombre</th>';
                    html += '<th>Unidad</th>';
                    html += '<th>Valor Unitario</th>';
                    html += '<th>Acciones</th>';
                    html += '</tr></thead>';
                    html += '<tbody>';
                    
                    if (tieneAPUs) {
                        for (var j = 0; j < items.length; j++) {
                            var apu = items[j];
                            var valorFormateado = formatearMoneda(apu.valor);
                            html += '<tr>';
                            html += '<td><strong>' + apu.codigo + '</strong></td>';
                            html += '<td>' + apu.nombre + '</td>';
                            html += '<td>' + apu.unidad + '</td>';
                            html += '<td>' + valorFormateado + '</td>';
                            html += '<td>';
                            html += '<button class="btn-edit" data-id="' + apu.id + '"><i class="fas fa-edit"></i></button>';
                            html += '<button class="btn-delete" data-id="' + apu.id + '"><i class="fas fa-trash"></i></button>';
                            html += '<button class="btn-print" data-id="' + apu.id + '"><i class="fas fa-file-pdf"></i></button>';
                            html += '</td>';
                            html += '</tr>';
                        }
                    } else {
                        html += '<tr>';
                        html += '<td colspan="5" style="text-align:center; color:var(--gray-500); padding:20px;">';
                        html += '<i class="fas fa-info-circle"></i> No hay APUs en esta categoría';
                        html += '</td>';
                        html += '</tr>';
                    }
                    
                    html += '</tbody></table>';
                    html += '</div>';
                    html += '</div>';
                }
                
                container.innerHTML = html;
                
                var editBtns = container.querySelectorAll('.btn-edit');
                for (var e = 0; e < editBtns.length; e++) {
                    (function(btn) {
                        btn.addEventListener('click', function() {
                            var id = parseInt(this.getAttribute('data-id'));
                            editarAPU(id);
                        });
                    })(editBtns[e]);
                }
                
                var deleteBtns = container.querySelectorAll('.btn-delete');
                for (var d = 0; d < deleteBtns.length; d++) {
                    (function(btn) {
                        btn.addEventListener('click', function() {
                            var id = parseInt(this.getAttribute('data-id'));
                            eliminarAPU(id);
                        });
                    })(deleteBtns[d]);
                }
                
                var printBtns = container.querySelectorAll('.btn-print');
                for (var p = 0; p < printBtns.length; p++) {
                    (function(btn) {
                        btn.addEventListener('click', function() {
                            var id = parseInt(this.getAttribute('data-id'));
                            imprimirAPU(id);
                        });
                    })(printBtns[p]);
                }
                
                var editCategoriaBtns = container.querySelectorAll('.btn-edit-categoria');
                for (var ec = 0; ec < editCategoriaBtns.length; ec++) {
                    (function(btn) {
                        btn.addEventListener('click', function() {
                            var categoria = this.getAttribute('data-categoria');
                            editarCategoria(categoria);
                        });
                    })(editCategoriaBtns[ec]);
                }
                
                var deleteCategoriaBtns = container.querySelectorAll('.btn-delete-categoria');
                for (var dc = 0; dc < deleteCategoriaBtns.length; dc++) {
                    (function(btn) {
                        btn.addEventListener('click', function() {
                            var categoria = this.getAttribute('data-categoria');
                            eliminarCategoria(categoria);
                        });
                    })(deleteCategoriaBtns[dc]);
                }
            }

            // ============================================================
            // ===== IMPRIMIR APU =====
            // ============================================================
            
            function imprimirAPU(id) {
                var notificacion = document.createElement('div');
                notificacion.className = 'notification';
                notificacion.textContent = 'Generando PDF...';
                document.body.appendChild(notificacion);
                setTimeout(function() { notificacion.classList.add('show'); }, 100);
                fetch('/api/apu-pdf/' + id)
                    .then(function(response) {
                        if (!response.ok) {
                            return response.json().then(function(err) {
                                throw new Error(err.error || 'Error al generar PDF');
                            });
                        }
                        return response.blob();
                    })
                    .then(function(blob) {
                        var url = window.URL.createObjectURL(blob);
                        var a = document.createElement('a');
                        a.href = url;
                        a.download = 'APU_' + id + '_' + new Date().toISOString().slice(0,10) + '.pdf';
                        document.body.appendChild(a);
                        a.click();
                        window.URL.revokeObjectURL(url);
                        a.remove();
                        notificacion.classList.remove('show');
                        setTimeout(function() { notificacion.remove(); }, 300);
                        mostrarNotificacion('PDF generado correctamente');
                    })
                    .catch(function(error) {
                        notificacion.classList.remove('show');
                        setTimeout(function() { notificacion.remove(); }, 300);
                        mostrarNotificacion('Error: ' + error.message);
                    });
            }

