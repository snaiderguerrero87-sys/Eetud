            function agregarItemEquipo() {
                if (ignorarItems) { alert('Los items están ignorados'); return; }
                var nombre = document.getElementById('nombreEquipo').value.trim();
                var porcentaje = parseFloat(document.getElementById('porcentajeEquipo').value) || 0;
                var valorBase = parsearMoneda(document.getElementById('valorBaseEquipo').value);
                var origen = document.getElementById('valorBaseOrigenEquipo').value;

                if (!nombre) return alert('Ingresa el nombre del equipo');

                if (origen !== 'manual') {
                    valorBase = origen === 'materiales' ? obtenerSubtotalMateriales()
                        : origen === 'manoDeObra' ? obtenerSubtotalManoObra()
                        : obtenerValorTotalGeneral();
                    document.getElementById('valorBaseEquipo').value = formatearMoneda(valorBase);
                }
                if (valorBase <= 0) return alert('Valor base debe ser mayor a 0');

                var subtotal = (porcentaje / 100) * valorBase;
                itemsEquipos.push({ nombre, unidad: '%', porcentaje, valorBase, valorBaseOrigen: origen, subtotal });
                renderizarItemsEquipos();
                limpiarCamposEquipo();
                actualizarSubtotales();
                actualizarTotalGeneral();
            }

