            function editarAPU(id) {
                var apu = null;
                for (var i = 0; i < apus.length; i++) {
                    if (apus[i].id === id) { apu = apus[i]; break; }
                }
                if (apu) { 
                    modoPlantilla = false;
                    document.getElementById('btnGuardarPlantilla').style.display = 'none';
                    document.getElementById('btnGuardarAPU').style.display = 'inline-flex';
                    document.getElementById('modalTitulo').textContent = 'Editar APU';
                    abrirModal(apu); 
                }
            }

            function eliminarAPU(id) {
                if (confirm('Eliminar este APU?')) {
                    var nuevosApus = [];
                    for (var i = 0; i < apus.length; i++) {
                        if (apus[i].id !== id) nuevosApus.push(apus[i]);
                    }
                    apus = nuevosApus;
                    guardarAPU();
                    mostrarNotificacion('APU eliminado');
                }
            }

            // ===== SUBMIT FORMULARIO =====
