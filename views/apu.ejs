            function agregarItemEquipo() {
                if (ignorarItems) {
                    alert('Los items estan ignorados');
                    return;
                }
                var nombre = document.getElementById('nombreEquipo').value.trim();
                var porcentaje = parseFloat(document.getElementById('porcentajeEquipo').value) || 0;
                var valorBase = parsearMoneda(document.getElementById('valorBaseEquipo').value);
                var origen = document.getElementById('valorBaseOrigenEquipo').value;
                
                if (!nombre) {
                    alert('Ingresa el nombre del equipo');
                    return;
                }
                
                if (origen !== 'manual') {
                    valorBase = obtenerValorBase(origen);
                    document.getElementById('valorBaseEquipo').value = formatearMoneda(valorBase);
                }
                
                if (valorBase <= 0 && origen !== 'manual') {
                    alert('El valor base del origen seleccionado es 0. Agrega materiales o mano de obra primero.');
                    return;
                }
                
                if (valorBase <= 0 && origen === 'manual') {
                    alert('Ingresa un valor base mayor a 0');
                    return;
                }
                
                var subtotal = (porcentaje / 100) * valorBase;
                
                var item = {
                    nombre: nombre,
                    unidad: '%',
                    porcentaje: porcentaje,
                    valorBase: valorBase,
                    valorBaseOrigen: origen,
                    subtotal: subtotal
                };
