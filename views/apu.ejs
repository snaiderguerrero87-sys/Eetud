        <script>
            // ===== VARIABLES GLOBALES =====
            var apus = [];
            var editandoId = null;
            var materialesData = [];
            var itemsMateriales = [];
            var itemsCargos = [];
            var itemsEquipos = [];
            var itemsTransporte = [];
            var ignorarItems = false;

            var categoriasGuardadas = [];  // Ahora son objetos {id, nombre}
            var unidadesGuardadas = [];    // Ahora son objetos {id, nombre}
            var letrasDisponibles = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
            var mapaLetras = {};

            var materialesSelector = [];
            var materialesFiltradosSelector = [];
            var materialesSeleccionadosTemp = [];
            var paginaActualMateriales = 1;
            var itemsPorPagina = 10;

            // ===== PLANTILLA =====
            var plantillaAPU = null;
            var modoPlantilla = false;

            // ===== CONTROL DE RECURSIVIDAD =====
            var actualizando = false;

            console.log('🚀 APU.JS INICIALIZADO');

            document.addEventListener('DOMContentLoaded', async function() {
                console.log('📄 DOM cargado');
                await cargarCategoriasDesdeServidor();
                await cargarUnidadesDesdeServidor();
                await cargarAPU();
                await cargarMateriales();
                cargarPlantilla();
                inicializarPlantilla();
                setupCategoriaAutocomplete();
                setupUnidadAutocomplete();
                setupPaginacionMateriales();
                setupEventListeners();
                setupPlantillaListeners();
                
                document.getElementById('btnToggleInfo').addEventListener('click', function() {
                    alert('⚠️ Al activar esta opción, se ignoran los campos de materiales, equipos, transporte y mano de obra y solo se usa el valor manual.');
                });
            });

            // ============================================================
            // ===== CATEGORÍAS (MYSQL) =====
            // ============================================================
            
            async function cargarCategoriasDesdeServidor() {
                try {
                    const response = await fetch('/api/apus/categorias');
                    if (!response.ok) throw new Error('Error al cargar categorías');
                    categoriasGuardadas = await response.json();
                    generarMapaLetras();
                    setupCategoriaAutocomplete();
                } catch (e) {
                    console.error('Error cargando categorías:', e);
                    categoriasGuardadas = [];
                }
            }

            function generarMapaLetras() {
                mapaLetras = {};
                var categoriasOrdenadas = categoriasGuardadas.slice().sort((a, b) => a.nombre.localeCompare(b.nombre));
                for (var i = 0; i < categoriasOrdenadas.length; i++) {
                    if (i < letrasDisponibles.length) {
                        mapaLetras[categoriasOrdenadas[i].nombre.toLowerCase()] = letrasDisponibles[i];
                    }
                }
            }

            function obtenerLetraCategoria(categoria) {
                var catLower = categoria.toLowerCase().trim();
                if (mapaLetras[catLower]) return mapaLetras[catLower];
                var letrasUsadas = Object.values(mapaLetras);
                for (var i = 0; i < letrasDisponibles.length; i++) {
                    if (letrasUsadas.indexOf(letrasDisponibles[i]) === -1) {
                        mapaLetras[catLower] = letrasDisponibles[i];
                        return letrasDisponibles[i];
                    }
                }
                return 'Z';
            }

            function setupCategoriaAutocomplete() {
                var input = document.getElementById('categoriaInput');
                var sugerencias = document.getElementById('sugerenciasCategorias');

                var newInput = input.cloneNode(true);
                input.parentNode.replaceChild(newInput, input);
                input = document.getElementById('categoriaInput');

                input.addEventListener('input', function() {
                    var texto = this.value.trim();
                    var catLower = texto.toLowerCase();

                    var existe = categoriasGuardadas.some(function(c) {
                        return c.nombre.toLowerCase() === catLower;
                    });

                    if (texto.length > 0) {
                        var coincidencias = categoriasGuardadas.filter(function(c) {
                            return c.nombre.toLowerCase().includes(catLower);
                        });

                        if (coincidencias.length > 0) {
                            sugerencias.style.display = 'block';
                            var html = '';
                            for (var i = 0; i < coincidencias.length; i++) {
                                var categoria = coincidencias[i];
                                var letra = obtenerLetraCategoria(categoria.nombre);
                                html += '<div class="sugerencia-item" data-categoria="' + categoria.nombre + '">' + letra + '. ' + categoria.nombre + '</div>';
                            }
                            sugerencias.innerHTML = html;

                            var items = sugerencias.querySelectorAll('.sugerencia-item');
                            for (var j = 0; j < items.length; j++) {
                                (function(item) {
                                    item.addEventListener('click', function() {
                                        seleccionarCategoria(this.getAttribute('data-categoria'));
                                    });
                                })(items[j]);
                            }

                            document.getElementById('btnAgregarCategoria').style.display = 'none';
                        } else if (!existe) {
                            sugerencias.style.display = 'none';
                            var btn = document.getElementById('btnAgregarCategoria');
                            btn.style.display = 'inline-flex';
                            btn.textContent = 'Agregar "' + texto + '"';
                        } else {
                            sugerencias.style.display = 'none';
                            document.getElementById('btnAgregarCategoria').style.display = 'none';
                        }
                    } else {
                        sugerencias.style.display = 'none';
                        document.getElementById('btnAgregarCategoria').style.display = 'none';
                    }

                    document.getElementById('categoriaSeleccionada').value = existe ? texto : '';
                });

                document.addEventListener('click', function(e) {
                    var container = document.getElementById('campo_categoria_container');
                    if (container && !container.contains(e.target)) {
                        sugerencias.style.display = 'none';
                        document.getElementById('btnAgregarCategoria').style.display = 'none';
                    }
                });
            }

            function seleccionarCategoria(categoria) {
                document.getElementById('categoriaInput').value = categoria;
                document.getElementById('categoriaSeleccionada').value = categoria;
                document.getElementById('sugerenciasCategorias').style.display = 'none';
                document.getElementById('btnAgregarCategoria').style.display = 'none';
            }

            async function agregarCategoria() {
                var texto = document.getElementById('categoriaInput').value.trim();
                if (!texto) return;

                var existe = categoriasGuardadas.some(function(c) {
                    return c.nombre.toLowerCase() === texto.toLowerCase();
                });

                if (!existe) {
                    try {
                        await fetch('/api/apus/categorias', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ nombre: texto })
                        });
                        await cargarCategoriasDesdeServidor();
                        seleccionarCategoria(texto);
                        mostrarNotificacion('Categoría "' + texto + '" agregada');
                    } catch (e) {
                        mostrarNotificacion('Error al agregar categoría');
                    }
                }
            }

            async function editarCategoria(id, nombreActual) {
                var nuevo = prompt('Editar categoría:', nombreActual);
                if (!nuevo || nuevo.trim() === '' || nuevo.trim() === nombreActual) return;

                try {
                    await fetch('/api/apus/categorias/' + id, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ nombre: nuevo.trim() })
                    });
                    await cargarCategoriasDesdeServidor();
                    await cargarAPU();
                    mostrarNotificacion('Categoría actualizada');
                } catch (e) {
                    mostrarNotificacion('Error al actualizar');
                }
            }

            async function eliminarCategoria(id, nombre) {
                if (!confirm('¿Eliminar la categoría "' + nombre + '"?')) return;

                try {
                    await fetch('/api/apus/categorias/' + id, { method: 'DELETE' });
                    await cargarCategoriasDesdeServidor();
                    mostrarNotificacion('Categoría eliminada');
                } catch (e) {
                    mostrarNotificacion('Error al eliminar');
                }
            }

            // ============================================================
            // ===== UNIDADES (MYSQL) =====
            // ============================================================

            async function cargarUnidadesDesdeServidor() {
                try {
                    const response = await fetch('/api/apus/unidades');
                    if (!response.ok) throw new Error('Error al cargar unidades');
                    unidadesGuardadas = await response.json();
                } catch (e) {
                    console.error('Error cargando unidades:', e);
                    unidadesGuardadas = [];
                }
            }

            function setupUnidadAutocomplete() {
                var input = document.getElementById('unidadInput');
                var sugerencias = document.getElementById('sugerenciasUnidades');
                var btnAgregar = document.getElementById('btnAgregarUnidad');

                input.addEventListener('input', function() {
                    var texto = this.value.trim().toUpperCase();
                    var existe = unidadesGuardadas.some(function(u) {
                        return u.nombre.toUpperCase() === texto;
                    });

                    if (texto.length > 0) {
                        var coincidencias = unidadesGuardadas.filter(function(u) {
                            return u.nombre.toUpperCase().includes(texto);
                        });

                        if (coincidencias.length > 0) {
                            sugerencias.style.display = 'block';
                            var html = '';
                            for (var i = 0; i < coincidencias.length; i++) {
                                html += '<div class="sugerencia-item" data-unidad="' + coincidencias[i].nombre + '">' + coincidencias[i].nombre + '</div>';
                            }
                            sugerencias.innerHTML = html;

                            var items = sugerencias.querySelectorAll('.sugerencia-item');
                            for (var j = 0; j < items.length; j++) {
                                (function(item) {
                                    item.addEventListener('click', function() {
                                        seleccionarUnidad(this.getAttribute('data-unidad'));
                                    });
                                })(items[j]);
                            }

                            btnAgregar.style.display = 'none';
                        } else if (!existe) {
                            sugerencias.style.display = 'none';
                            btnAgregar.style.display = 'inline-flex';
                            btnAgregar.textContent = 'Agregar "' + texto + '"';
                        } else {
                            sugerencias.style.display = 'none';
                            btnAgregar.style.display = 'none';
                        }
                    } else {
                        sugerencias.style.display = 'none';
                        btnAgregar.style.display = 'none';
                    }

                    document.getElementById('unidadSeleccionada').value = existe ? texto : '';
                    document.getElementById('unidad').value = texto;
                });

                document.addEventListener('click', function(e) {
                    var container = document.getElementById('campo_unidad_container');
                    if (!container.contains(e.target)) {
                        sugerencias.style.display = 'none';
                        btnAgregar.style.display = 'none';
                    }
                });
            }

            function seleccionarUnidad(unidad) {
                document.getElementById('unidadInput').value = unidad;
                document.getElementById('unidadSeleccionada').value = unidad;
                document.getElementById('unidad').value = unidad;
                document.getElementById('sugerenciasUnidades').style.display = 'none';
                document.getElementById('btnAgregarUnidad').style.display = 'none';
            }

            async function agregarUnidad() {
                var texto = document.getElementById('unidadInput').value.trim().toUpperCase();
                if (!texto) return;

                var existe = unidadesGuardadas.some(function(u) {
                    return u.nombre.toUpperCase() === texto;
                });

                if (!existe) {
                    try {
                        await fetch('/api/apus/unidades', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ nombre: texto })
                        });
                        await cargarUnidadesDesdeServidor();
                        seleccionarUnidad(texto);
                        mostrarNotificacion('Unidad "' + texto + '" agregada');
                    } catch (e) {
                        mostrarNotificacion('Error al agregar unidad');
                    }
                }
            }

            // ============================================================
            // ===== APUs (CRUD MYSQL) =====
            // ============================================================

            async function cargarAPU() {
                try {
                    const response = await fetch('/api/apus');
                    if (!response.ok) throw new Error('Error al cargar APUs');
                    apus = await response.json();
                    renderizarTablasAgrupadas();
                } catch (error) {
                    console.error('Error:', error);
                    apus = [];
                    renderizarTablasAgrupadas();
                }
            }

            function renderizarTablasAgrupadas() {
                var container = document.getElementById('contenedorTablas');
                var sinDatos = document.getElementById('sinDatos');

                var todasLasCategorias = [];
                for (var i = 0; i < categoriasGuardadas.length; i++) {
                    if (todasLasCategorias.indexOf(categoriasGuardadas[i].nombre) === -1) {
                        todasLasCategorias.push(categoriasGuardadas[i].nombre);
                    }
                }
                for (var j = 0; j < apus.length; j++) {
                    if (apus[j].categoria && todasLasCategorias.indexOf(apus[j].categoria) === -1) {
                        todasLasCategorias.push(apus[j].categoria);
                    }
                }
                todasLasCategorias.sort();

                if (todasLasCategorias.length === 0) {
                    container.innerHTML = '';
                    sinDatos.style.display = 'block';
                    return;
                }
                sinDatos.style.display = 'none';

                var html = '';
                for (var c = 0; c < todasLasCategorias.length; c++) {
                    var categoria = todasLasCategorias[c];
                    var items = apus.filter(function(a) { return a.categoria === categoria; });
                    var letra = obtenerLetraCategoria(categoria);
                    var tieneAPUs = items.length > 0;
                    var catObj = categoriasGuardadas.find(function(x) { return x.nombre === categoria; });
                    var catId = catObj ? catObj.id : null;

                    html += '<div class="categoria-tabla">';
                    html += '<div class="categoria-header">';
                    html += '<span class="letra">' + letra + '</span>';
                    html += categoria.toUpperCase();
                    html += ' <span style="font-weight:400; font-size:14px; opacity:0.8;">(' + items.length + ' APUs)</span>';
                    html += ' <span class="categoria-acciones">';
                    if (catId) {
                        html += '<button class="btn-edit-categoria" onclick="editarCategoria(' + catId + ', \'' + categoria.replace(/'/g, "\\\\'") + '\')" title="Editar"><i class="fas fa-edit"></i></button>';
                        html += '<button class="btn-delete-categoria" onclick="eliminarCategoria(' + catId + ', \'' + categoria.replace(/'/g, "\\\\'") + '\')" title="Eliminar"><i class="fas fa-trash"></i></button>';
                    }
                    html += '</span>';
                    html += '</div>';
                    html += '<div class="categoria-body">';
                    html += '<table>';
                    html += '<thead><tr>';
                    html += '<th>Código</th><th>Nombre</th><th>Unidad</th><th>Valor Unitario</th><th>Acciones</th>';
                    html += '</tr></thead><tbody>';

                    if (tieneAPUs) {
                        for (var k = 0; k < items.length; k++) {
                            var apu = items[k];
                            var valorFormateado = '$' + Number(apu.valor || 0).toLocaleString('es-CO');
                            html += '<tr>';
                            html += '<td><strong>' + escapeHtml(apu.codigo) + '</strong></td>';
                            html += '<td>' + escapeHtml(apu.nombre) + '</td>';
                            html += '<td>' + escapeHtml(apu.unidad) + '</td>';
                            html += '<td>' + valorFormateado + '</td>';
                            html += '<td>';
                            html += '<button class="btn-edit" onclick="editarAPU(' + apu.id + ')"><i class="fas fa-edit"></i></button>';
                            html += '<button class="btn-delete" onclick="eliminarAPU(' + apu.id + ')"><i class="fas fa-trash"></i></button>';
                            html += '<button class="btn-print" onclick="imprimirAPU(' + apu.id + ')"><i class="fas fa-file-pdf"></i></button>';
                            html += '</td>';
                            html += '</tr>';
                        }
                    } else {
                        html += '<tr><td colspan="5" style="text-align:center; color:var(--gray-500); padding:20px;">';
                        html += '<i class="fas fa-info-circle"></i> No hay APUs en esta categoría';
                        html += '</td></tr>';
                    }

                    html += '</tbody></table>';
                    html += '</div>';
                    html += '</div>';
                }

                container.innerHTML = html;
            }

            function escapeHtml(text) {
                if (text === undefined || text === null) return '';
                return String(text)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            // ============================================================
            // ===== FORMATEO MONEDA =====
            // ============================================================
            
            function formatearMoneda(valor) {
                if (valor === undefined || valor === null || isNaN(valor)) return '$0';
                return '$' + Number(valor).toLocaleString('es-CO');
            }

            function parsearMoneda(texto) {
                if (!texto) return 0;
                var limpio = texto.replace(/[$,.]/g, '').trim();
                var num = parseFloat(limpio);
                return isNaN(num) ? 0 : num;
            }

            function validarNumero(event, input) {
                var key = event.key;
                if (key === 'Backspace' || key === 'Delete' || key === 'Tab' || key === 'ArrowLeft' || key === 'ArrowRight' || key === 'Home' || key === 'End' || key === 'Enter') return true;
                if (!/^[0-9]$/.test(key)) {
                    event.preventDefault();
                    mostrarNotificacion('⚠️ Solo números');
                    return false;
                }
                return true;
            }

            function ajustarAnchoInput(input) {
                if (!input) return;
                var valor = input.value || '';
                var ancho = Math.max(90, valor.length * 9 + 20);
                input.style.width = ancho + 'px';
                input.style.minWidth = '90px';
            }

            function formatearYCalcularEquipo(input) {
                if (actualizando) return;
                actualizando = true;
                var soloNumeros = input.value.replace(/[^0-9]/g, '');
                if (soloNumeros === '' || soloNumeros === '0') {
                    input.value = '$0'; actualizando = false;
                    ajustarAnchoInput(input); calcularSubtotalEquipoPreview(); return;
                }
                var num = parseInt(soloNumeros, 10);
                input.value = isNaN(num) || num < 0 ? '$0' : formatearMoneda(num);
                ajustarAnchoInput(input);
                calcularSubtotalEquipoPreview();
                actualizando = false;
            }

            function formatearYCalcularTransporte(input) {
                if (actualizando) return;
                actualizando = true;
                var soloNumeros = input.value.replace(/[^0-9]/g, '');
                if (soloNumeros === '' || soloNumeros === '0') {
                    input.value = '$0'; actualizando = false;
                    ajustarAnchoInput(input); calcularSubtotalTransportePreview(); return;
                }
                var num = parseInt(soloNumeros, 10);
                input.value = isNaN(num) || num < 0 ? '$0' : formatearMoneda(num);
                ajustarAnchoInput(input);
                calcularSubtotalTransportePreview();
                actualizando = false;
            }

            function formatearYCalcularCargo(input) {
                if (actualizando) return;
                actualizando = true;
                var soloNumeros = input.value.replace(/[^0-9]/g, '');
                if (soloNumeros === '' || soloNumeros === '0') {
                    input.value = '$0'; actualizando = false;
                    ajustarAnchoInput(input); calcularSubtotalCargoPreview(); return;
                }
                var num = parseInt(soloNumeros, 10);
                input.value = isNaN(num) || num < 0 ? '$0' : formatearMoneda(num);
                ajustarAnchoInput(input);
                calcularSubtotalCargoPreview();
                actualizando = false;
            }

            // ============================================================
            // ===== CÁLCULOS =====
            // ============================================================
            
            function obtenerValorManoObraActual() {
                var valorUnitario = parsearMoneda(document.getElementById('valorUnitarioCargo').value);
                var cantidad = parseFloat(document.getElementById('cantidadCargo').value) || 0;
                return valorUnitario * cantidad;
            }

            function obtenerSubtotalManoObra() {
                var total = 0;
                for (var i = 0; i < itemsCargos.length; i++) total += itemsCargos[i].subtotal || 0;
                var valorActual = obtenerValorManoObraActual();
                if (valorActual > 0) {
                    var descripcion = document.getElementById('descripcionCargo').value.trim();
                    var existe = descripcion ? itemsCargos.some(function(c) { return c.descripcion === descripcion; }) : false;
                    if (!existe) total += valorActual;
                }
                return total;
            }

            function obtenerSubtotalMateriales() {
                var total = 0;
                for (var i = 0; i < itemsMateriales.length; i++) total += itemsMateriales[i].subtotal || 0;
                return total;
            }

            function obtenerSubtotalEquipos() {
                var total = 0;
                for (var i = 0; i < itemsEquipos.length; i++) total += itemsEquipos[i].subtotal || 0;
                return total;
            }

            function obtenerSubtotalTransporte() {
                var total = 0;
                for (var i = 0; i < itemsTransporte.length; i++) total += itemsTransporte[i].subtotal || 0;
                return total;
            }

            function obtenerValorTotalGeneral() {
                return obtenerSubtotalMateriales() + obtenerSubtotalManoObra() + obtenerSubtotalEquipos() + obtenerSubtotalTransporte();
            }

            function calcularSubtotalEquipoPreview() {
                if (actualizando) return;
                var porcentaje = parseFloat(document.getElementById('porcentajeEquipo').value) || 0;
                var valorBase = parsearMoneda(document.getElementById('valorBaseEquipo').value);
                var subtotal = (porcentaje / 100) * valorBase;
                var preview = document.getElementById('previewSubtotalEquipo');
                if (subtotal > 0 || (porcentaje > 0 && valorBase > 0)) {
                    preview.style.display = 'block';
                    preview.textContent = 'Subtotal: ' + formatearMoneda(subtotal);
                } else preview.style.display = 'none';
                setTimeout(actualizarTotalGeneral, 10);
            }

            function calcularSubtotalTransportePreview() {
                if (actualizando) return;
                var porcentaje = parseFloat(document.getElementById('porcentajeTransporte').value) || 0;
                var valorBase = parsearMoneda(document.getElementById('valorBaseTransporte').value);
                var subtotal = (porcentaje / 100) * valorBase;
                var preview = document.getElementById('previewSubtotalTransporte');
                if (subtotal > 0 || (porcentaje > 0 && valorBase > 0)) {
                    preview.style.display = 'block';
                    preview.textContent = 'Subtotal: ' + formatearMoneda(subtotal);
                } else preview.style.display = 'none';
                setTimeout(actualizarTotalGeneral, 10);
            }

            function calcularSubtotalCargoPreview() {
                if (actualizando) return;
                var cantidad = parseFloat(document.getElementById('cantidadCargo').value) || 0;
                var valorUnitario = parsearMoneda(document.getElementById('valorUnitarioCargo').value);
                var subtotal = cantidad * valorUnitario;
                document.getElementById('subtotalCargo').value = formatearMoneda(subtotal);
                var preview = document.getElementById('previewSubtotalCargo');
                if (subtotal > 0) {
                    preview.style.display = 'block';
                    preview.textContent = 'Subtotal: ' + formatearMoneda(subtotal);
                } else preview.style.display = 'none';
                setTimeout(function() {
                    actualizarValorBaseEquipoManual();
                    actualizarValorBaseTransporteManual();
                    actualizarTotalGeneral();
                }, 10);
            }

            function actualizarValorBaseEquipoManual() {
                if (actualizando) return;
                var origen = document.getElementById('valorBaseOrigenEquipo').value;
                var valorBase = 0;
                if (origen === 'manual') valorBase = parsearMoneda(document.getElementById('valorBaseEquipo').value);
                else if (origen === 'materiales') { valorBase = obtenerSubtotalMateriales(); document.getElementById('valorBaseEquipo').value = formatearMoneda(valorBase); }
                else if (origen === 'manoDeObra') { valorBase = obtenerSubtotalManoObra(); document.getElementById('valorBaseEquipo').value = formatearMoneda(valorBase); }
                else if (origen === 'total') { valorBase = obtenerValorTotalGeneral(); document.getElementById('valorBaseEquipo').value = formatearMoneda(valorBase); }
                ajustarAnchoInput(document.getElementById('valorBaseEquipo'));
                calcularSubtotalEquipoPreview();
                return valorBase;
            }

            function actualizarValorBaseTransporteManual() {
                if (actualizando) return;
                var origen = document.getElementById('valorBaseOrigenTransporte').value;
                var valorBase = 0;
                if (origen === 'manual') valorBase = parsearMoneda(document.getElementById('valorBaseTransporte').value);
                else if (origen === 'materiales') { valorBase = obtenerSubtotalMateriales(); document.getElementById('valorBaseTransporte').value = formatearMoneda(valorBase); }
                else if (origen === 'manoDeObra') { valorBase = obtenerSubtotalManoObra(); document.getElementById('valorBaseTransporte').value = formatearMoneda(valorBase); }
                else if (origen === 'total') { valorBase = obtenerValorTotalGeneral(); document.getElementById('valorBaseTransporte').value = formatearMoneda(valorBase); }
                ajustarAnchoInput(document.getElementById('valorBaseTransporte'));
                calcularSubtotalTransportePreview();
                return valorBase;
            }

            function actualizarTotalGeneral() {
                if (actualizando) return;
                actualizando = true;
                var total = ignorarItems
                    ? (parseFloat(document.getElementById('valorManual').value) || 0)
                    : obtenerValorTotalGeneral();
                document.getElementById('valorTotal').textContent = formatearMoneda(total);
                actualizarSubtotales();
                actualizando = false;
            }

            function actualizarSubtotales() {
                document.getElementById('subtotalMateriales').textContent = 'Subtotal Materiales: ' + formatearMoneda(obtenerSubtotalMateriales());
                document.getElementById('subtotalEquipos').textContent = 'Subtotal Equipos y Herramientas: ' + formatearMoneda(obtenerSubtotalEquipos());
                document.getElementById('subtotalTransporte').textContent = 'Subtotal Transporte: ' + formatearMoneda(obtenerSubtotalTransporte());
                document.getElementById('subtotalManoObra').textContent = 'Subtotal Mano de Obra: ' + formatearMoneda(obtenerSubtotalManoObra());
            }

            document.getElementById('valorManual').addEventListener('input', function() {
                if (ignorarItems) actualizarTotalGeneral();
            });

            // ============================================================
            // ===== PLANTILLA (localStorage, sin cambios) =====
            // ============================================================
            
            function cargarPlantilla() {
                try {
                    var data = localStorage.getItem('plantillaAPU');
                    plantillaAPU = data ? JSON.parse(data) : null;
                } catch (e) { plantillaAPU = null; }
            }

            function guardarPlantillaEnStorage() {
                try {
                    localStorage.setItem('plantillaAPU', JSON.stringify(plantillaAPU));
                    return true;
                } catch (e) { return false; }
            }

            function inicializarPlantilla() {
                if (!plantillaAPU) {
                    plantillaAPU = {
                        codigo: '', nombre: '', categoria: '', unidad: '',
                        ignorarItems: false, valorManual: 0,
                        nombreEquipo: '', porcentajeEquipo: 0, valorBaseEquipo: 0, origenEquipo: 'manual',
                        nombreTransporte: '', porcentajeTransporte: 0, valorBaseTransporte: 0, origenTransporte: 'manual',
                        descripcionCargo: '', unidadCargo: 'und', cantidadCargo: 0, valorUnitarioCargo: 0,
                        items: { materiales: [], equipos: [], transporte: [], cargos: [] }
                    };
                    guardarPlantillaEnStorage();
                }
            }

            function setupPlantillaListeners() {
                document.getElementById('btnPlantillaAPU').addEventListener('click', abrirModalPlantilla);
                document.getElementById('btnGuardarPlantilla').addEventListener('click', function(e) {
                    e.preventDefault();
                    guardarPlantillaActual();
                });
            }

            function abrirModalPlantilla() {
                modoPlantilla = true;
                document.getElementById('modalTitulo').textContent = 'Editar Plantilla APU';
                document.getElementById('btnGuardarPlantilla').style.display = 'inline-flex';
                document.getElementById('btnGuardarAPU').style.display = 'none';

                cargarPlantilla();
                var modal = document.getElementById('modalAPU');
                modal.style.display = 'flex';

                itemsMateriales = []; itemsCargos = []; itemsEquipos = []; itemsTransporte = [];
                ignorarItems = false;
                document.getElementById('ignorarItems').checked = false;
                document.getElementById('seccionValorManual').style.display = 'none';
                document.getElementById('valorManual').value = '';
                document.getElementById('seccionMateriales').style.display = 'block';
                document.getElementById('seccionEquipos').style.display = 'block';
                document.getElementById('seccionTransporte').style.display = 'block';
                document.getElementById('seccionCargos').style.display = 'block';
                document.getElementById('categoriaInput').value = '';
                document.getElementById('categoriaSeleccionada').value = '';
                document.getElementById('unidadInput').value = '';
                document.getElementById('unidadSeleccionada').value = '';
                document.getElementById('unidad').value = '';
                document.getElementById('descripcionCargo').value = '';
                document.getElementById('unidadCargo').value = 'und';
                document.getElementById('cantidadCargo').value = '1';
                document.getElementById('valorUnitarioCargo').value = '$0';
                document.getElementById('subtotalCargo').value = '';
                document.getElementById('nombreEquipo').value = '';
                document.getElementById('porcentajeEquipo').value = '0';
                document.getElementById('valorBaseEquipo').value = '$0';
                document.getElementById('valorBaseOrigenEquipo').value = 'manual';
                document.getElementById('nombreTransporte').value = '';
                document.getElementById('porcentajeTransporte').value = '0';
                document.getElementById('valorBaseTransporte').value = '$0';
                document.getElementById('valorBaseOrigenTransporte').value = 'manual';

                if (plantillaAPU) setTimeout(function() { cargarDatosPlantilla(plantillaAPU); }, 100);

                actualizarSubtotales();
                actualizarTotalGeneral();
                renderizarItemsMateriales();
                renderizarItemsEquipos();
                renderizarItemsTransporte();
                renderizarItemsCargos();
            }

            function cargarDatosPlantilla(plantilla) {
                document.getElementById('codigo').value = plantilla.codigo || '';
                document.getElementById('nombre').value = plantilla.nombre || '';
                document.getElementById('categoriaInput').value = plantilla.categoria || '';
                document.getElementById('categoriaSeleccionada').value = plantilla.categoria || '';
                document.getElementById('unidadInput').value = plantilla.unidad || '';
                document.getElementById('unidadSeleccionada').value = plantilla.unidad || '';
                document.getElementById('unidad').value = plantilla.unidad || '';

                if (plantilla.ignorarItems) {
                    document.getElementById('ignorarItems').checked = true;
                    toggleIgnorarItems();
                    document.getElementById('valorManual').value = plantilla.valorManual || 0;
                } else {
                    document.getElementById('ignorarItems').checked = false;
                    toggleIgnorarItems();
                }

                document.getElementById('nombreEquipo').value = plantilla.nombreEquipo || '';
                document.getElementById('porcentajeEquipo').value = plantilla.porcentajeEquipo || 0;
                document.getElementById('valorBaseEquipo').value = formatearMoneda(plantilla.valorBaseEquipo || 0);
                document.getElementById('valorBaseOrigenEquipo').value = plantilla.origenEquipo || 'manual';
                document.getElementById('nombreTransporte').value = plantilla.nombreTransporte || '';
                document.getElementById('porcentajeTransporte').value = plantilla.porcentajeTransporte || 0;
                document.getElementById('valorBaseTransporte').value = formatearMoneda(plantilla.valorBaseTransporte || 0);
                document.getElementById('valorBaseOrigenTransporte').value = plantilla.origenTransporte || 'manual';
                document.getElementById('descripcionCargo').value = plantilla.descripcionCargo || '';
                document.getElementById('unidadCargo').value = plantilla.unidadCargo || 'und';
                document.getElementById('cantidadCargo').value = plantilla.cantidadCargo || 0;
                document.getElementById('valorUnitarioCargo').value = formatearMoneda(plantilla.valorUnitarioCargo || 0);

                ajustarAnchoInput(document.getElementById('valorBaseEquipo'));
                ajustarAnchoInput(document.getElementById('valorBaseTransporte'));
                ajustarAnchoInput(document.getElementById('valorUnitarioCargo'));

                itemsMateriales = (plantilla.items && plantilla.items.materiales) ? JSON.parse(JSON.stringify(plantilla.items.materiales)) : [];
                itemsEquipos = (plantilla.items && plantilla.items.equipos) ? JSON.parse(JSON.stringify(plantilla.items.equipos)) : [];
                itemsTransporte = (plantilla.items && plantilla.items.transporte) ? JSON.parse(JSON.stringify(plantilla.items.transporte)) : [];
                itemsCargos = (plantilla.items && plantilla.items.cargos) ? JSON.parse(JSON.stringify(plantilla.items.cargos)) : [];

                renderizarItemsMateriales();
                renderizarItemsEquipos();
                renderizarItemsTransporte();
                renderizarItemsCargos();
                actualizarSubtotales();
                actualizarTotalGeneral();
            }

            function guardarPlantillaActual() {
                var nombre = document.getElementById('nombre').value.trim();
                var categoria = document.getElementById('categoriaSeleccionada').value.trim() || document.getElementById('categoriaInput').value.trim();
                var unidad = document.getElementById('unidadSeleccionada').value.trim().toUpperCase() || document.getElementById('unidadInput').value.trim().toUpperCase();
                var codigo = document.getElementById('codigo').value.trim();

                var plantilla = {
                    codigo: codigo,
                    nombre: nombre,
                    categoria: categoria,
                    unidad: unidad,
                    ignorarItems: ignorarItems,
                    valorManual: parseFloat(document.getElementById('valorManual').value) || 0,
                    nombreEquipo: document.getElementById('nombreEquipo').value.trim(),
                    porcentajeEquipo: parseFloat(document.getElementById('porcentajeEquipo').value) || 0,
                    valorBaseEquipo: parsearMoneda(document.getElementById('valorBaseEquipo').value),
                    origenEquipo: document.getElementById('valorBaseOrigenEquipo').value,
                    nombreTransporte: document.getElementById('nombreTransporte').value.trim(),
                    porcentajeTransporte: parseFloat(document.getElementById('porcentajeTransporte').value) || 0,
                    valorBaseTransporte: parsearMoneda(document.getElementById('valorBaseTransporte').value),
                    origenTransporte: document.getElementById('valorBaseOrigenTransporte').value,
                    descripcionCargo: document.getElementById('descripcionCargo').value.trim(),
                    unidadCargo: document.getElementById('unidadCargo').value.trim() || 'und',
                    cantidadCargo: parseFloat(document.getElementById('cantidadCargo').value) || 0,
                    valorUnitarioCargo: parsearMoneda(document.getElementById('valorUnitarioCargo').value),
                    items: {
                        materiales: JSON.parse(JSON.stringify(itemsMateriales)),
                        equipos: JSON.parse(JSON.stringify(itemsEquipos)),
                        transporte: JSON.parse(JSON.stringify(itemsTransporte)),
                        cargos: JSON.parse(JSON.stringify(itemsCargos))
                    }
                };

                plantillaAPU = plantilla;
                guardarPlantillaEnStorage();

                modoPlantilla = false;
                document.getElementById('btnGuardarPlantilla').style.display = 'none';
                document.getElementById('btnGuardarAPU').style.display = 'inline-flex';
                document.getElementById('modalTitulo').textContent = 'Nuevo APU';
                document.getElementById('modalAPU').style.display = 'none';

                mostrarNotificacion('✅ Plantilla guardada');
            }

            // ============================================================
            // ===== IMPORTAR =====
            // ============================================================

            function abrirModalImportar() {
                document.getElementById('modalImportarAPU').style.display = 'flex';
                document.getElementById('importarResultadoAPU').style.display = 'none';
                document.getElementById('importarProgresoAPU').style.display = 'none';
                document.getElementById('fileInputImportarAPU').value = '';
            }

            function cerrarModalImportar() {
                document.getElementById('modalImportarAPU').style.display = 'none';
            }

            function descargarFormatoAPU() {
                mostrarNotificacion('⏳ Generando formato...');
                fetch('/api/apus/exportar-formato')
                    .then(r => r.blob())
                    .then(blob => {
                        var url = window.URL.createObjectURL(blob);
                        var a = document.createElement('a');
                        a.href = url;
                        a.download = 'formato_apu.xlsx';
                        document.body.appendChild(a);
                        a.click();
                        window.URL.revokeObjectURL(url);
                        a.remove();
                        mostrarNotificacion('✅ Formato descargado');
                    })
                    .catch(err => mostrarNotificacion('❌ Error: ' + err.message));
            }

            function procesarImportacionAPU(event) {
                var file = event.target.files[0];
                if (!file) return;

                var progress = document.getElementById('importarProgresoAPU');
                var mensaje = document.getElementById('importarMensajeAPU');
                var resultado = document.getElementById('importarResultadoAPU');

                progress.style.display = 'block';
                mensaje.textContent = '⏳ Leyendo archivo...';
                resultado.style.display = 'none';

                var reader = new FileReader();
                reader.onload = function(e) {
                    try {
                        var base64 = e.target.result.split(',')[1];
                        mensaje.textContent = '⏳ Importando...';

                        fetch('/api/apus/importar', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ file: base64 })
                        })
                        .then(r => r.json())
                        .then(async data => {
                            if (data.success) {
                                resultado.style.display = 'block';
                                resultado.style.background = '#d1fae5';
                                resultado.style.color = '#065f46';
                                var msg = '<strong>✅ Importación exitosa!</strong><br>';
                                msg += 'Se importaron ' + (data.apusImportados || 0) + ' APUs.';
                                if (data.categoriasNuevas && data.categoriasNuevas.length > 0) {
                                    msg += '<br>📁 Categorías nuevas: ' + data.categoriasNuevas.join(', ');
                                }
                                resultado.innerHTML = msg;
                                progress.style.display = 'none';
                                await cargarCategoriasDesdeServidor();
                                await cargarAPU();
                                mostrarNotificacion('✅ APUs importados');
                                setTimeout(cerrarModalImportar, 3000);
                            } else {
                                resultado.style.display = 'block';
                                resultado.style.background = '#fee2e2';
                                resultado.style.color = '#991b1b';
                                var errMsg = '<strong>❌ Error:</strong> ' + (data.error || 'Desconocido');
                                if (data.detalles && data.detalles.length > 0) {
                                    errMsg += '<br><ul style="margin-top:8px; padding-left:20px;">';
                                    data.detalles.forEach(d => { errMsg += '<li>' + d + '</li>'; });
                                    errMsg += '</ul>';
                                }
                                resultado.innerHTML = errMsg;
                                progress.style.display = 'none';
                            }
                        })
                        .catch(err => {
                            resultado.style.display = 'block';
                            resultado.style.background = '#fee2e2';
                            resultado.style.color = '#991b1b';
                            resultado.innerHTML = '<strong>❌ Error:</strong> ' + err.message;
                            progress.style.display = 'none';
                        });
                    } catch (err) {
                        resultado.style.display = 'block';
                        resultado.style.background = '#fee2e2';
                        resultado.style.color = '#991b1b';
                        resultado.innerHTML = '<strong>❌ Error:</strong> ' + err.message;
                        progress.style.display = 'none';
                    }
                };
                reader.readAsDataURL(file);
            }

