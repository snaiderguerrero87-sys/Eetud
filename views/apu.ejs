            // ============================================================
            // ===== TOGGLE IGNORAR =====
            // ============================================================
            
            function toggleIgnorarItems() {
                var checkbox = document.getElementById('ignorarItems');
                ignorarItems = checkbox.checked;

                var secciones = ['seccionMateriales', 'seccionEquipos', 'seccionTransporte', 'seccionCargos'];
                var seccionManual = document.getElementById('seccionValorManual');

                if (ignorarItems) {
                    secciones.forEach(id => document.getElementById(id).style.display = 'none');
                    seccionManual.style.display = 'block';
                    itemsMateriales = []; itemsCargos = []; itemsEquipos = []; itemsTransporte = [];
                    renderizarItemsMateriales();
                    renderizarItemsCargos();
                    renderizarItemsEquipos();
                    renderizarItemsTransporte();
                } else {
                    secciones.forEach(id => document.getElementById(id).style.display = 'block');
                    seccionManual.style.display = 'none';
                    document.getElementById('valorManual').value = '';
                }
                actualizarSubtotales();
                actualizarTotalGeneral();
            }

            // ============================================================
            // ===== MODAL APU =====
            // ============================================================
            
            function abrirModal(apu) {
                var modal = document.getElementById('modalAPU');
                var titulo = document.getElementById('modalTitulo');

                if (!modoPlantilla) {
                    titulo.textContent = apu ? 'Editar APU' : 'Nuevo APU';
                    document.getElementById('btnGuardarPlantilla').style.display = 'none';
                    document.getElementById('btnGuardarAPU').style.display = 'inline-flex';
                }

                itemsMateriales = []; itemsCargos = []; itemsEquipos = []; itemsTransporte = [];
                ignorarItems = false;
                document.getElementById('ignorarItems').checked = false;
                document.getElementById('seccionValorManual').style.display = 'none';
                document.getElementById('valorManual').value = '';
                document.getElementById('seccionMateriales').style.display = 'block';
                document.getElementById('seccionEquipos').style.display = 'block';
                document.getElementById('seccionTransporte').style.display = 'block';
                document.getElementById('seccionCargos').style.display = 'block';

                document.getElementById('categoriaInput').value = '';
                document.getElementById('categoriaSeleccionada').value = '';
                document.getElementById('unidadInput').value = '';
                document.getElementById('unidadSeleccionada').value = '';
                document.getElementById('unidad').value = '';
                document.getElementById('descripcionCargo').value = '';
                document.getElementById('unidadCargo').value = 'und';
                document.getElementById('cantidadCargo').value = '1';
                document.getElementById('valorUnitarioCargo').value = '$0';
                document.getElementById('subtotalCargo').value = '';
                document.getElementById('nombreEquipo').value = '';
                document.getElementById('porcentajeEquipo').value = '0';
                document.getElementById('valorBaseEquipo').value = '$0';
                document.getElementById('valorBaseOrigenEquipo').value = 'manual';
                document.getElementById('nombreTransporte').value = '';
                document.getElementById('porcentajeTransporte').value = '0';
                document.getElementById('valorBaseTransporte').value = '$0';
                document.getElementById('valorBaseOrigenTransporte').value = 'manual';

                if (!apu && !modoPlantilla) {
                    cargarPlantilla();
                    if (plantillaAPU) setTimeout(function() { cargarDatosPlantilla(plantillaAPU); }, 50);
                }

                if (apu) {
                    document.getElementById('codigo').value = apu.codigo || '';
                    document.getElementById('nombre').value = apu.nombre || '';
                    document.getElementById('categoriaInput').value = apu.categoria || '';
                    document.getElementById('categoriaSeleccionada').value = apu.categoria || '';
                    document.getElementById('unidadInput').value = apu.unidad || '';
                    document.getElementById('unidadSeleccionada').value = apu.unidad || '';
                    document.getElementById('unidad').value = apu.unidad || '';
                    editandoId = apu.id;

                    if (apu.items) {
                        if (apu.items.materiales) { itemsMateriales = apu.items.materiales; renderizarItemsMateriales(); }
                        if (apu.items.equipos) { itemsEquipos = apu.items.equipos; renderizarItemsEquipos(); }
                        if (apu.items.transporte) { itemsTransporte = apu.items.transporte; renderizarItemsTransporte(); }
                        if (apu.items.cargos) { itemsCargos = apu.items.cargos; renderizarItemsCargos(); }
                    }
                    if (apu.ignorarItems) {
                        ignorarItems = true;
                        document.getElementById('ignorarItems').checked = true;
                        document.getElementById('seccionMateriales').style.display = 'none';
                        document.getElementById('seccionEquipos').style.display = 'none';
                        document.getElementById('seccionTransporte').style.display = 'none';
                        document.getElementById('seccionCargos').style.display = 'none';
                        document.getElementById('seccionValorManual').style.display = 'block';
                        document.getElementById('valorManual').value = apu.valorManual || apu.valor;
                    }
                }

                actualizarSubtotales();
                actualizarTotalGeneral();
                modal.style.display = 'flex';
            }

            function cerrarModal() {
                document.getElementById('modalAPU').style.display = 'none';
                document.getElementById('formAPU').reset();
                editandoId = null;
                itemsMateriales = []; itemsCargos = []; itemsEquipos = []; itemsTransporte = [];
                ignorarItems = false;
            }

            function editarAPU(id) {
                var apu = apus.find(a => a.id === id);
                if (apu) {
                    modoPlantilla = false;
                    document.getElementById('btnGuardarPlantilla').style.display = 'none';
                    document.getElementById('btnGuardarAPU').style.display = 'inline-flex';
                    abrirModal(apu);
                }
            }

            async function eliminarAPU(id) {
                if (!confirm('¿Eliminar este APU?')) return;

                try {
                    const response = await fetch('/api/apus/' + id, { method: 'DELETE' });
                    if (!response.ok) throw new Error('Error');
                    await cargarAPU();
                    mostrarNotificacion('APU eliminado');
                } catch (e) {
                    mostrarNotificacion('Error al eliminar');
                }
            }

            async function borrarTodos() {
                if (apus.length === 0) { alert('No hay APUs para borrar'); return; }
                if (!confirm('⚠️ ¿Borrar TODOS tus APUs?')) return;

                for (var i = 0; i < apus.length; i++) {
                    await fetch('/api/apus/' + apus[i].id, { method: 'DELETE' });
                }
                await cargarAPU();
                mostrarNotificacion('Todos los APUs fueron eliminados');
            }

            // ============================================================
            // ===== SUBMIT FORMULARIO =====
            // ============================================================
            
            document.getElementById('formAPU').addEventListener('submit', async function(e) {
                if (modoPlantilla) {
                    e.preventDefault();
                    guardarPlantillaActual();
                    return;
                }

                e.preventDefault();
                var codigo = document.getElementById('codigo').value.trim();
                var nombre = document.getElementById('nombre').value.trim();
                var categoria = document.getElementById('categoriaSeleccionada').value.trim() || document.getElementById('categoriaInput').value.trim();
                var unidad = (document.getElementById('unidadSeleccionada').value.trim() || document.getElementById('unidadInput').value.trim()).toUpperCase();

                if (!codigo || !nombre || !categoria || !unidad) {
                    alert('Completa todos los campos');
                    return;
                }

                var valorTotal = 0;
                if (ignorarItems) {
                    valorTotal = parseFloat(document.getElementById('valorManual').value) || 0;
                    if (valorTotal <= 0) { alert('Ingresa un valor manual válido'); return; }
                } else {
                    valorTotal = obtenerValorTotalGeneral();
                    if (valorTotal <= 0) { alert('Agrega al menos un item'); return; }
                }

                var apuData = {
                    codigo, nombre, categoria, unidad,
                    valor: valorTotal,
                    ignorarItems: ignorarItems,
                    valorManual: parseFloat(document.getElementById('valorManual').value) || 0,
                    items: {
                        materiales: itemsMateriales,
                        equipos: itemsEquipos,
                        transporte: itemsTransporte,
                        cargos: itemsCargos
                    }
                };

                try {
                    var url = editandoId !== null ? '/api/apus/' + editandoId : '/api/apus';
                    var method = editandoId !== null ? 'PUT' : 'POST';

                    var response = await fetch(url, {
                        method: method,
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(apuData)
                    });

                    if (!response.ok) {
                        var err = await response.json();
                        throw new Error(err.error || 'Error al guardar');
                    }

                    // Si la categoría o unidad son nuevas, guardarlas
                    if (categoria && !categoriasGuardadas.some(c => c.nombre.toLowerCase() === categoria.toLowerCase())) {
                        await fetch('/api/apus/categorias', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ nombre: categoria })
                        });
                    }
                    if (unidad && !unidadesGuardadas.some(u => u.nombre.toUpperCase() === unidad)) {
                        await fetch('/api/apus/unidades', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ nombre: unidad })
                        });
                    }

                    await cargarCategoriasDesdeServidor();
                    await cargarUnidadesDesdeServidor();
                    await cargarAPU();
                    cerrarModal();
                    mostrarNotificacion(editandoId !== null ? 'APU actualizado' : 'APU guardado');
                    editandoId = null;
                } catch (error) {
                    console.error('Error:', error);
                    mostrarNotificacion('Error: ' + error.message);
                }
            });

            // ============================================================
            // ===== IMPRIMIR PDF =====
            // ============================================================
            
            function imprimirAPU(id) {
                mostrarNotificacion('⏳ Generando PDF...');
                fetch('/api/apu-pdf/' + id)
                    .then(r => {
                        if (!r.ok) return r.json().then(err => { throw new Error(err.error || 'Error'); });
                        return r.blob();
                    })
                    .then(blob => {
                        var url = window.URL.createObjectURL(blob);
                        var a = document.createElement('a');
                        a.href = url;
                        a.download = 'APU_' + id + '_' + new Date().toISOString().slice(0,10) + '.pdf';
                        document.body.appendChild(a);
                        a.click();
                        window.URL.revokeObjectURL(url);
                        a.remove();
                        mostrarNotificacion('✅ PDF generado');
                    })
                    .catch(err => mostrarNotificacion('❌ Error: ' + err.message));
            }

            // ============================================================
            // ===== NOTIFICACIONES =====
            // ============================================================
            
            function mostrarNotificacion(mensaje) {
                var notificacion = document.createElement('div');
                notificacion.className = 'notification';
                notificacion.textContent = mensaje;
                document.body.appendChild(notificacion);
                setTimeout(function() { notificacion.classList.add('show'); }, 100);
                setTimeout(function() {
                    notificacion.classList.remove('show');
                    setTimeout(function() { notificacion.remove(); }, 300);
                }, 3000);
            }

            window.onclick = function(event) {
                var modal = document.getElementById('modalAPU');
                if (event.target === modal) {
                    modoPlantilla = false;
                    document.getElementById('btnGuardarPlantilla').style.display = 'none';
                    document.getElementById('btnGuardarAPU').style.display = 'inline-flex';
                    document.getElementById('modalTitulo').textContent = 'Nuevo APU';
                    cerrarModal();
                }
                var modalSelector = document.getElementById('modalSelectorMateriales');
                if (event.target === modalSelector) cerrarSelectorMateriales();
                var modalImportar = document.getElementById('modalImportarAPU');
                if (event.target === modalImportar) cerrarModalImportar();
            };
        </script>
