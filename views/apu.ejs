<%- include('layouts/main', { 
    title: 'Listado de APU',
    usuario: usuario,
    body: `
        <div class="page-header">
            <h1>Listado de APU</h1>
            <div style="display:flex; gap:12px; flex-wrap:wrap;">
                <button class="btn-primary" id="btnCrearAPU">
                    <i class="fas fa-plus"></i> Crear APU
                </button>
                <button class="btn-secondary" id="btnPlantillaAPU" style="background:var(--gray-100); border:1px solid var(--gray-200);">
                    <i class="fas fa-copy"></i> Plantilla APU
                </button>
                <button class="btn-secondary" onclick="abrirModalImportar()" style="background:var(--gray-100); border:1px solid var(--gray-200);">
                    <i class="fas fa-file-import"></i> Importar Listado
                </button>
            </div>
        </div>

        <section class="table-container">
            <div id="contenedorTablas">
            </div>
            <div id="sinDatos" class="empty-state">
                <i class="fas fa-file-invoice"></i>
                <p>No hay APU registrados</p>
                <button class="btn-primary" id="btnCrearPrimerAPU">
                    <i class="fas fa-plus"></i> Crear primer APU
                </button>
            </div>
        </section>

        <div id="modalAPU" class="modal modal-muy-grande">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 id="modalTitulo">Nuevo APU</h2>
                    <span class="close" id="btnCerrarModal">&times;</span>
                </div>
                <form id="formAPU">
                    <div class="form-row">
                        <div id="campo_codigo_container" class="form-group half">
                            <label for="codigo">Código</label>
                            <input type="text" id="codigo" placeholder="Ej: APU-001">
                        </div>
                        <div id="campo_unidad_container" class="form-group half" style="position:relative;">
                            <label for="unidad">Unidad</label>
                            <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                                <input type="text" id="unidadInput" placeholder="Escribe la unidad..." style="flex:1; padding:10px 14px; border:1px solid var(--gray-200); border-radius:8px; font-size:14px; font-family:inherit;" autocomplete="off">
                                <button type="button" id="btnAgregarUnidad" class="btn-primary" style="display:none; white-space:nowrap;">
                                    <i class="fas fa-plus"></i> Agregar Unidad
                                </button>
                            </div>
                            <div id="sugerenciasUnidades" style="display:none; position:absolute; background:white; border:1px solid var(--gray-200); border-radius:8px; max-height:150px; overflow-y:auto; width:calc(100% - 110px); z-index:1000; box-shadow:var(--shadow-lg); margin-top:4px;"></div>
                            <input type="hidden" id="unidadSeleccionada" value="">
                            <input type="hidden" id="unidad" value="">
                        </div>
                    </div>
                    <div id="campo_nombre_container" class="form-group">
                        <label for="nombre">Nombre del APU</label>
                        <input type="text" id="nombre" placeholder="Ej: Excavación Manual">
                    </div>
                    
                    <div id="campo_categoria_container" class="form-group" style="position:relative;">
                        <label for="categoria">Categoría</label>
                        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                            <input type="text" id="categoriaInput" placeholder="Escribe la categoría..." style="flex:1; padding:10px 14px; border:1px solid var(--gray-200); border-radius:8px; font-size:14px; font-family:inherit;" autocomplete="off">
                            <button type="button" id="btnAgregarCategoria" class="btn-primary" style="display:none; white-space:nowrap;">
                                <i class="fas fa-plus"></i> Agregar Categoría
                            </button>
                        </div>
                        <div id="sugerenciasCategorias" style="display:none; position:absolute; background:white; border:1px solid var(--gray-200); border-radius:8px; max-height:150px; overflow-y:auto; width:calc(100% - 120px); z-index:1000; box-shadow:var(--shadow-lg); margin-top:4px;"></div>
                        <input type="hidden" id="categoriaSeleccionada" value="">
                    </div>

                    <div class="form-group toggle-container" style="display:flex; align-items:center; gap:12px; padding:12px 16px; background:var(--gray-50); border-radius:8px; border:1px solid var(--gray-200);">
                        <label class="toggle-label" style="display:flex; align-items:center; gap:12px; cursor:pointer; margin:0; flex:1;">
                            <input type="checkbox" id="ignorarItems" onchange="toggleIgnorarItems()">
                            <span class="toggle-slider"></span>
                            <span class="toggle-text" style="font-size:14px; font-weight:500; color:var(--gray-900);">
                                <i class="fas fa-edit" style="color:var(--warning); margin-right:6px;"></i>
                                Ignorar items (editar valor manualmente)
                            </span>
                        </label>
                        <button type="button" id="btnToggleInfo" style="background:var(--warning); color:white; border:none; border-radius:50%; width:28px; height:28px; font-size:14px; font-weight:700; cursor:pointer; display:flex; align-items:center; justify-content:center; flex-shrink:0;" title="Al activar esta opción, se ignoran los campos de materiales, equipos, transporte y mano de obra y solo se usa el valor manual.">
                            <i class="fas fa-info"></i>
                        </button>
                    </div>

                    <hr class="form-divider">

                    <div id="seccionMateriales">
                        <h3 class="section-title"><i class="fas fa-cubes"></i> Materiales</h3>
                        <div style="display:flex; gap:12px; margin-bottom:12px;">
                            <button type="button" class="btn-primary" id="btnSeleccionarMaterial">
                                <i class="fas fa-search"></i> Seleccionar Material
                            </button>
                            <span id="contadorMateriales" style="display:flex; align-items:center; color:var(--gray-600); font-size:14px;">0 materiales seleccionados</span>
                        </div>
                        <div id="listaMateriales" class="item-list">
                            <p class="empty-items">No hay materiales agregados</p>
                        </div>
                        <div id="subtotalMateriales" style="text-align:right; margin-top:8px; font-weight:600; color:var(--primary);">
                            Subtotal Materiales: $0
                        </div>
                    </div>

                    <hr class="form-divider">

                    <div id="seccionEquipos">
                        <h3 class="section-title"><i class="fas fa-tools"></i> Equipos y Herramientas</h3>
                        <div class="item-row">
                            <div class="form-group half">
                                <label>Nombre del Equipo/Herramienta</label>
                                <input type="text" id="nombreEquipo" class="form-control" placeholder="Ej: Excavadora">
                            </div>
                            <div class="form-group small">
                                <label>Unidad (%)</label>
                                <input type="text" id="unidadEquipo" value="%" readonly style="background:var(--gray-100); width:60px;">
                            </div>
                            <div class="form-group small">
                                <label>Porcentaje (%)</label>
                                <input type="number" id="porcentajeEquipo" placeholder="0" value="0" min="0" step="0.1" style="width:80px;" oninput="calcularSubtotalEquipoPreview()">
                            </div>
                            <div class="form-group small" style="flex:1; min-width:120px;">
                                <label>Valor Base</label>
                                <div style="display:flex; gap:4px; align-items:center;">
                                    <input type="text" id="valorBaseEquipo" placeholder="$0" value="$0" style="min-width:90px; width:auto; text-align:right; font-family:monospace; padding:4px 6px;" onfocus="this.select()" onkeydown="validarNumero(event, this)" oninput="formatearYCalcularEquipo(this)">
                                    <select id="valorBaseOrigenEquipo" style="padding:4px; border:1px solid var(--gray-200); border-radius:4px; font-size:11px; background:white; cursor:pointer;" onchange="actualizarValorBaseEquipoManual()">
                                        <option value="manual">Manual</option>
                                        <option value="materiales">Subtotal Materiales</option>
                                        <option value="manoDeObra">Subtotal Mano de Obra</option>
                                        <option value="total">Valor Total</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group small">
                                <label>&nbsp;</label>
                                <button type="button" class="btn-add" onclick="agregarItemEquipo()">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div id="listaEquipos" class="item-list">
                            <p class="empty-items">No hay equipos o herramientas agregados</p>
                        </div>
                        <div id="subtotalEquipos" style="text-align:right; margin-top:8px; font-weight:600; color:var(--primary);">
                            Subtotal Equipos y Herramientas: $0
                        </div>
                        <div id="previewSubtotalEquipo" style="text-align:right; margin-top:4px; font-weight:600; color:var(--success); font-size:13px; display:none;">
                            Subtotal: $0
                        </div>
                    </div>

                    <hr class="form-divider">

                    <div id="seccionTransporte">
                        <h3 class="section-title"><i class="fas fa-truck"></i> Transporte de Materiales</h3>
                        <div class="item-row">
                            <div class="form-group half">
                                <label>Nombre del Transporte</label>
                                <input type="text" id="nombreTransporte" class="form-control" placeholder="Ej: Flete de materiales">
                            </div>
                            <div class="form-group small">
                                <label>Unidad (%)</label>
                                <input type="text" id="unidadTransporte" value="%" readonly style="background:var(--gray-100); width:60px;">
                            </div>
                            <div class="form-group small">
                                <label>Porcentaje (%)</label>
                                <input type="number" id="porcentajeTransporte" placeholder="0" value="0" min="0" step="0.1" style="width:80px;" oninput="calcularSubtotalTransportePreview()">
                            </div>
                            <div class="form-group small" style="flex:1; min-width:120px;">
                                <label>Valor Base</label>
                                <div style="display:flex; gap:4px; align-items:center;">
                                    <input type="text" id="valorBaseTransporte" placeholder="$0" value="$0" style="min-width:90px; width:auto; text-align:right; font-family:monospace; padding:4px 6px;" onfocus="this.select()" onkeydown="validarNumero(event, this)" oninput="formatearYCalcularTransporte(this)">
                                    <select id="valorBaseOrigenTransporte" style="padding:4px; border:1px solid var(--gray-200); border-radius:4px; font-size:11px; background:white; cursor:pointer;" onchange="actualizarValorBaseTransporteManual()">
                                        <option value="manual">Manual</option>
                                        <option value="materiales">Subtotal Materiales</option>
                                        <option value="manoDeObra">Subtotal Mano de Obra</option>
                                        <option value="total">Valor Total</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group small">
                                <label>&nbsp;</label>
                                <button type="button" class="btn-add" onclick="agregarItemTransporte()">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div id="listaTransporte" class="item-list">
                            <p class="empty-items">No hay transportes agregados</p>
                        </div>
                        <div id="subtotalTransporte" style="text-align:right; margin-top:8px; font-weight:600; color:var(--primary);">
                            Subtotal Transporte: $0
                        </div>
                        <div id="previewSubtotalTransporte" style="text-align:right; margin-top:4px; font-weight:600; color:var(--success); font-size:13px; display:none;">
                            Subtotal: $0
                        </div>
                    </div>

                    <hr class="form-divider">

                    <div id="seccionCargos">
                        <h3 class="section-title"><i class="fas fa-user-cog"></i> Mano de Obra</h3>
                        <div class="item-row">
                            <div class="form-group half">
                                <label>Descripcion</label>
                                <input type="text" id="descripcionCargo" class="form-control" placeholder="Ej: Ingeniero Civil">
                            </div>
                            <div class="form-group small">
                                <label>Unidad</label>
                                <input type="text" id="unidadCargo" placeholder="und" style="width:60px;">
                            </div>
                            <div class="form-group small">
                                <label>Cantidad</label>
                                <input type="number" id="cantidadCargo" placeholder="1" value="1" min="1" style="width:60px;" oninput="calcularSubtotalCargoPreview()">
                            </div>
                            <div class="form-group small" style="flex:1; min-width:120px;">
                                <label>Valor Unitario</label>
                                <input type="text" id="valorUnitarioCargo" placeholder="$0" value="$0" style="min-width:90px; width:auto; text-align:right; font-family:monospace; padding:4px 6px;" onfocus="this.select()" onkeydown="validarNumero(event, this)" oninput="formatearYCalcularCargo(this)">
                            </div>
                            <div class="form-group small">
                                <label>Subtotal</label>
                                <input type="text" id="subtotalCargo" readonly style="background:var(--gray-100); min-width:90px; width:auto; text-align:right; font-family:monospace; padding:4px 6px;">
                            </div>
                            <div class="form-group small">
                                <label>&nbsp;</label>
                                <button type="button" class="btn-add" onclick="agregarItemCargo()">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div id="listaCargos" class="item-list">
                            <p class="empty-items">No hay cargos agregados</p>
                        </div>
                        <div id="subtotalManoObra" style="text-align:right; margin-top:8px; font-weight:600; color:var(--primary);">
                            Subtotal Mano de Obra: $0
                        </div>
                        <div id="previewSubtotalCargo" style="text-align:right; margin-top:4px; font-weight:600; color:var(--success); font-size:13px; display:none;">
                            Subtotal: $0
                        </div>
                    </div>

                    <hr class="form-divider">

                    <div id="seccionValorManual" style="display: none;">
                        <div class="form-group">
                            <label for="valorManual">Valor Unitario Manual (COP)</label>
                            <input type="number" id="valorManual" placeholder="Ej: 50000" min="0" step="100" oninput="actualizarTotalGeneral()">
                        </div>
                    </div>

                    <div class="total-container">
                        <div class="total-label">Valor Unitario Total:</div>
                        <div class="total-value" id="valorTotal">$0</div>
                    </div>

                    <div class="form-actions" style="display:flex; gap:12px; flex-wrap:wrap; justify-content:flex-end;">
                        <button type="button" class="btn-primary" id="btnGuardarPlantilla" style="display:none;">
                            <i class="fas fa-save"></i> Guardar Plantilla
                        </button>
                        <button type="submit" class="btn-primary" id="btnGuardarAPU">
                            <i class="fas fa-save"></i> Guardar APU
                        </button>
                        <button type="button" class="btn-secondary" id="btnCancelarModal">Cancelar</button>
                    </div>
                </form>
            </div>
        </div>

        <div id="modalSelectorMateriales" class="modal modal-grande">
            <div class="modal-content" style="max-width:95vw; width:95vw; max-height:92vh;">
                <div class="modal-header">
                    <h2><i class="fas fa-cubes"></i> Seleccionar Materiales</h2>
                    <span class="close" id="btnCerrarSelectorMateriales">&times;</span>
                </div>
                <div style="display:flex; gap:20px; flex-wrap:wrap;">
                    <div style="flex:2; min-width:300px;">
                        <div style="display:flex; gap:10px; margin-bottom:12px;">
                            <input type="text" id="buscarMaterialSelector" placeholder="Buscar material por nombre..." style="flex:1; padding:8px 12px; border:1px solid var(--gray-200); border-radius:6px; font-size:14px;" oninput="filtrarMaterialesSelector()">
                            <span id="resultadosContador" style="display:flex; align-items:center; color:var(--gray-600); font-size:13px;">0 resultados</span>
                        </div>
                        <div id="listaMaterialesSelector" style="max-height:350px; overflow-y:auto; border:1px solid var(--gray-200); border-radius:6px; padding:4px;">
                            <p class="empty-items">Cargando materiales...</p>
                        </div>
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:12px; gap:10px; flex-wrap:wrap;">
                            <div style="display:flex; gap:6px;">
                                <button class="btn-sm" id="btnPaginaAnterior" disabled>Anterior</button>
                                <span id="paginacionInfo" style="display:flex; align-items:center; font-size:14px; color:var(--gray-600);">Página 1 de 1</span>
                                <button class="btn-sm" id="btnPaginaSiguiente" disabled>Siguiente</button>
                            </div>
                            <span id="seleccionadosContador" style="font-size:14px; color:var(--primary); font-weight:600;">0 materiales seleccionados</span>
                        </div>
                    </div>
                    <div style="flex:1; min-width:280px; border-left:1px solid var(--gray-200); padding-left:20px;">
                        <h4 style="margin-bottom:10px; color:var(--gray-900);">Seleccionados</h4>
                        <div id="materialesSeleccionadosLista" style="max-height:300px; overflow-y:auto;">
                            <p class="empty-items">No hay materiales seleccionados</p>
                        </div>
                        <div style="margin-top:12px; display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                            <button class="btn-primary" id="btnGuardarMateriales" style="flex:1;">
                                <i class="fas fa-check"></i> Guardar
                            </button>
                            <button class="btn-secondary" id="btnCancelarSelectorMateriales">Cancelar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="modalImportarAPU" class="modal">
            <div class="modal-content" style="max-width:600px;">
                <div class="modal-header">
                    <h2><i class="fas fa-file-import"></i> Importar APU</h2>
                    <span class="close" onclick="cerrarModalImportar()">&times;</span>
                </div>
                <div style="padding: 10px 0;">
                    <p style="color: var(--gray-600); margin-bottom: 16px;">
                        Descarga el formato Excel, completa los datos y luego impórtalo.
                        Las categorías nuevas se crearán automáticamente.
                    </p>
                    
                    <div style="display:flex; gap:12px; flex-wrap:wrap; justify-content:center;">
                        <button class="btn-primary" onclick="descargarFormatoAPU()" style="flex:1; min-width:150px;">
                            <i class="fas fa-download"></i> Descargar Formato
                        </button>
                        <button class="btn-secondary" onclick="document.getElementById('fileInputImportarAPU').click()" style="flex:1; min-width:150px; background:var(--gray-100); border:1px solid var(--gray-200);">
                            <i class="fas fa-upload"></i> Importar Archivo
                        </button>
                        <input type="file" id="fileInputImportarAPU" accept=".xlsx,.xls" style="display:none;" onchange="procesarImportacionAPU(event)">
                    </div>
                    
                    <div id="importarProgresoAPU" style="display:none; margin-top:16px; padding:12px; background:var(--gray-50); border-radius:8px; text-align:center;">
                        <span id="importarMensajeAPU">Procesando archivo...</span>
                    </div>
                    
                    <div id="importarResultadoAPU" style="display:none; margin-top:16px; padding:12px; border-radius:8px;">
                    </div>
                </div>
            </div>
        </div>

        <button class="btn-danger btn-cache" onclick="borrarTodos()">
            <i class="fas fa-trash"></i> Borrar Todos Mis APUs
        </button>

        <style>
            .modal-muy-grande .modal-content {
                max-width: 95vw;
                width: 95vw;
                max-height: 92vh;
                padding: 24px 32px;
            }
            
            @media (max-width: 768px) {
                .modal-muy-grande .modal-content {
                    max-width: 98vw;
                    width: 98vw;
                    padding: 16px;
                    max-height: 95vh;
                }
                .modal-muy-grande .modal-content .form-row {
                    flex-direction: column;
                    gap: 0;
                }
                .modal-muy-grande .modal-content .form-row .form-group.half {
                    flex: none;
                }
                .modal-muy-grande .modal-content .item-row {
                    flex-wrap: wrap;
                }
                .modal-muy-grande .modal-content .item-row .form-group {
                    flex: 1;
                    min-width: 100px;
                }
                #modalSelectorMateriales .modal-content {
                    max-width: 98vw;
                    width: 98vw;
                    padding: 16px;
                }
                #modalSelectorMateriales .modal-content > div {
                    flex-direction: column;
                }
                #modalSelectorMateriales .modal-content > div > div {
                    flex: none;
                    width: 100%;
                    border-left: none;
                    padding-left: 0;
                    border-top: 1px solid var(--gray-200);
                    padding-top: 16px;
                    margin-top: 12px;
                }
                .form-actions {
                    flex-direction: column;
                }
                .form-actions button {
                    width: 100%;
                }
                #modalSelectorMateriales .modal-content > div > div:last-child {
                    flex-direction: column;
                    align-items: stretch;
                }
                #modalSelectorMateriales .modal-content > div > div:last-child > div {
                    flex-wrap: wrap;
                }
            }

            .toggle-container {
                display: flex !important;
                align-items: center !important;
                gap: 12px !important;
                padding: 12px 16px !important;
                background: var(--gray-50) !important;
                border-radius: 8px !important;
                border: 1px solid var(--gray-200) !important;
            }

            .toggle-container .toggle-label {
                display: flex !important;
                align-items: center !important;
                gap: 12px !important;
                cursor: pointer !important;
                margin: 0 !important;
                flex: 1 !important;
            }

            .toggle-container .toggle-label .toggle-slider {
                position: relative !important;
                width: 44px !important;
                height: 24px !important;
                background: var(--gray-200) !important;
                border-radius: 12px !important;
                transition: all 0.3s !important;
                flex-shrink: 0 !important;
            }

            .toggle-container .toggle-label .toggle-slider::after {
                content: '' !important;
                position: absolute !important;
                top: 2px !important;
                left: 2px !important;
                width: 20px !important;
                height: 20px !important;
                background: white !important;
                border-radius: 50% !important;
                transition: all 0.3s !important;
                box-shadow: var(--shadow) !important;
            }

            .toggle-container .toggle-label input:checked + .toggle-slider {
                background: var(--primary) !important;
            }

            .toggle-container .toggle-label input:checked + .toggle-slider::after {
                transform: translateX(20px) !important;
            }

            .toggle-container .toggle-label .toggle-text {
                font-size: 14px !important;
                font-weight: 500 !important;
                color: var(--gray-900) !important;
            }

            .toggle-container .toggle-label .toggle-text i {
                color: var(--warning) !important;
                margin-right: 6px !important;
            }

            #btnToggleInfo {
                background: var(--warning) !important;
                color: white !important;
                border: none !important;
                border-radius: 50% !important;
                width: 28px !important;
                height: 28px !important;
                font-size: 14px !important;
                font-weight: 700 !important;
                cursor: pointer !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                flex-shrink: 0 !important;
                transition: all 0.3s !important;
            }

            #btnToggleInfo:hover {
                transform: scale(1.1) !important;
                background: #d97706 !important;
            }

            .item-row .form-group.small input[type="text"] {
                font-family: monospace !important;
                text-align: right !important;
                min-width: 90px !important;
                width: auto !important;
                padding: 4px 6px !important;
                border: 1px solid var(--gray-200) !important;
                border-radius: 4px !important;
                font-size: 14px !important;
                transition: width 0.1s ease !important;
            }

            .item-row .form-group.small input[type="text"]:focus {
                border-color: var(--primary) !important;
                box-shadow: 0 0 0 3px rgba(0, 39, 53, 0.15) !important;
                outline: none !important;
            }

            .item-row .form-group.small {
                flex: 0 0 auto !important;
            }

