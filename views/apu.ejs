                if (modoPlantilla) {
                    e.preventDefault();
                    guardarPlantillaActual();
                    return;
                }
                
                e.preventDefault();
                var codigo = document.getElementById('codigo').value.trim();
                var nombre = document.getElementById('nombre').value.trim();
                var categoria = document.getElementById('categoriaSeleccionada').value.trim();
                if (!categoria) {
                    categoria = document.getElementById('categoriaInput').value.trim();
                }
                var unidad = document.getElementById('unidadSeleccionada').value.trim().toUpperCase();
                if (!unidad) {
                    unidad = document.getElementById('unidadInput').value.trim().toUpperCase();
                }
                
                if (!codigo || !nombre || !categoria || !unidad) {
                    alert('Completa todos los campos');
                    return;
                }
                
                var valorTotal = 0;
                if (ignorarItems) {
                    valorTotal = parseFloat(document.getElementById('valorManual').value) || 0;
                    if (valorTotal <= 0) {
                        alert('Ingresa un valor manual valido');
                        return;
                    }
                } else {
                    valorTotal = obtenerValorTotalGeneral();
                    if (valorTotal <= 0) {
                        alert('Agrega al menos un item o activa Ignorar');
                        return;
                    }
                }
                
                var apuData = {
                    codigo: codigo,
                    nombre: nombre,
                    categoria: categoria,
                    unidad: unidad,
                    valor: valorTotal,
                    ignorarItems: ignorarItems,
                    valorManual: parseFloat(document.getElementById('valorManual').value) || 0,
                    items: {
                        materiales: itemsMateriales,
                        equipos: itemsEquipos,
                        transporte: itemsTransporte,
                        cargos: itemsCargos
                    }
                };
                
                if (editandoId !== null) {
                    for (var m = 0; m < apus.length; m++) {
                        if (apus[m].id === editandoId) {
                            apus[m] = { id: editandoId };
                            for (var key in apuData) { apus[m][key] = apuData[key]; }
                            break;
                        }
                    }
                } else {
                    var nuevoId = 1;
                    if (apus.length > 0) {
                        var maxId = 0;
                        for (var n = 0; n < apus.length; n++) { if (apus[n].id > maxId) maxId = apus[n].id; }
                        nuevoId = maxId + 1;
                    }
                    apus.push({ id: nuevoId });
                    var ultimoIndex = apus.length - 1;
                    for (var key2 in apuData) { apus[ultimoIndex][key2] = apuData[key2]; }
                    
                    cargarCategoriasGuardadas();
                }
                
                guardarAPU();
                cerrarModal();
                mostrarNotificacion('APU guardado');
                editandoId = null;
            });

            // ============================================================
            // ===== BORRAR CACHÉ =====
            // ============================================================

            function borrarCache() {
                if (confirm('Borrar todos los datos?')) {
                    localStorage.clear();
                    apus = [];
                    guardarAPU();
                    mostrarNotificacion('Cache borrada');
                }
            }

            function mostrarNotificacion(mensaje) {
                var notificacion = document.createElement('div');
                notificacion.className = 'notification';
                notificacion.textContent = mensaje;
                document.body.appendChild(notificacion);
                setTimeout(function() { notificacion.classList.add('show'); }, 100);
                setTimeout(function() {
                    notificacion.classList.remove('show');
                    setTimeout(function() { notificacion.remove(); }, 300);
                }, 3000);
            }

            window.onclick = function(event) {
                var modal = document.getElementById('modalAPU');
                if (event.target === modal) { 
                    modoPlantilla = false;
                    document.getElementById('btnGuardarPlantilla').style.display = 'none';
                    document.getElementById('btnGuardarAPU').style.display = 'inline-flex';
                    document.getElementById('modalTitulo').textContent = 'Nuevo APU';
                    cerrarModal(); 
                }
                var modalSelector = document.getElementById('modalSelectorMateriales');
                if (event.target === modalSelector) { cerrarSelectorMateriales(); }
                var modalImportar = document.getElementById('modalImportarAPU');
                if (event.target === modalImportar) { cerrarModalImportar(); }
            };
        </script>
