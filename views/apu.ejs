            function agregarItemCargo() {
                if (ignorarItems) { alert('Los items están ignorados'); return; }
                var descripcion = document.getElementById('descripcionCargo').value.trim();
                var unidad = document.getElementById('unidadCargo').value.trim() || 'und';
                var cantidad = parseFloat(document.getElementById('cantidadCargo').value) || 0;
                var valorUnitario = parsearMoneda(document.getElementById('valorUnitarioCargo').value);
                var subtotal = cantidad * valorUnitario;

                if (!descripcion) return alert('Ingresa la descripción');
                if (cantidad <= 0) return alert('Cantidad inválida');
                if (valorUnitario <= 0) return alert('Valor unitario inválido');

                itemsCargos.push({ descripcion, unidad, cantidad, valorUnitario, subtotal });
                renderizarItemsCargos();
                limpiarCamposCargo();
                actualizarSubtotales();
                actualizarTotalGeneral();
                actualizarValorBaseEquipoManual();
                actualizarValorBaseTransporteManual();
            }

            function eliminarItemCargo(index) {
                itemsCargos.splice(index, 1);
                renderizarItemsCargos();
                actualizarSubtotales();
                actualizarTotalGeneral();
                actualizarValorBaseEquipoManual();
                actualizarValorBaseTransporteManual();
            }

