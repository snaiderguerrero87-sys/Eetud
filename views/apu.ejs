            function cargarCategoriasGuardadas() {
                try {
                    var data = localStorage.getItem('categorias');
                    if (data) {
                        categoriasGuardadas = JSON.parse(data);
                    } else {
                        categoriasGuardadas = [];
                    }
                    generarMapaLetras();
                    // Actualizar el autocompletado
                    setupCategoriaAutocomplete();
                } catch (e) {
                    categoriasGuardadas = [];
                }
            }

            function guardarCategorias() {
                localStorage.setItem('categorias', JSON.stringify(categoriasGuardadas));
                generarMapaLetras();
            }

            function generarMapaLetras() {
                mapaLetras = {};
                var categoriasOrdenadas = categoriasGuardadas.slice().sort();
                for (var i = 0; i < categoriasOrdenadas.length; i++) {
                    if (i < letrasDisponibles.length) {
                        mapaLetras[categoriasOrdenadas[i].toLowerCase()] = letrasDisponibles[i];
                    }
                }
            }

            function obtenerLetraCategoria(categoria) {
                var catLower = categoria.toLowerCase().trim();
                if (mapaLetras[catLower]) {
                    return mapaLetras[catLower];
                }
                var letrasUsadas = Object.values(mapaLetras);
                for (var i = 0; i < letrasDisponibles.length; i++) {
                    if (letrasUsadas.indexOf(letrasDisponibles[i]) === -1) {
                        mapaLetras[catLower] = letrasDisponibles[i];
                        return letrasDisponibles[i];
                    }
                }
                return 'Z';
            }

            function setupCategoriaAutocomplete() {
                var input = document.getElementById('categoriaInput');
                var sugerencias = document.getElementById('sugerenciasCategorias');

                // Limpiar event listeners antiguos clonando el input
                var newInput = input.cloneNode(true);
                input.parentNode.replaceChild(newInput, input);
                input = document.getElementById('categoriaInput');

                input.addEventListener('input', function() {
                    var texto = this.value.trim();
                    var catLower = texto.toLowerCase();
                    
                    // Verificar si la categoría ya existe
                    var existe = categoriasGuardadas.some(function(c) {
                        return c.toLowerCase() === catLower;
                    });

                    if (texto.length > 0) {
                        // Buscar coincidencias en las categorías guardadas
                        var coincidencias = categoriasGuardadas.filter(function(c) {
                            return c.toLowerCase().includes(catLower);
                        });

                        if (coincidencias.length > 0) {
                            sugerencias.style.display = 'block';
                            var html = '';
                            for (var i = 0; i < coincidencias.length; i++) {
                                var categoria = coincidencias[i];
                                var letra = obtenerLetraCategoria(categoria);
                                html += '<div class="sugerencia-item" data-categoria="' + categoria + '">' + letra + '. ' + categoria + '</div>';
                            }
                            sugerencias.innerHTML = html;
                            
                            var items = sugerencias.querySelectorAll('.sugerencia-item');
                            for (var j = 0; j < items.length; j++) {
                                (function(item) {
                                    item.addEventListener('click', function() {
                                        var categoria = this.getAttribute('data-categoria');
                                        seleccionarCategoria(categoria);
                                    });
                                })(items[j]);
                            }
                            
                            document.getElementById('btnAgregarCategoria').style.display = 'none';
                        } else if (!existe) {
                            sugerencias.style.display = 'none';
                            document.getElementById('btnAgregarCategoria').style.display = 'inline-flex';
                            document.getElementById('btnAgregarCategoria').textContent = 'Agregar "' + texto + '"';
                        } else {
                            sugerencias.style.display = 'none';
                            document.getElementById('btnAgregarCategoria').style.display = 'none';
                        }
                    } else {
                        sugerencias.style.display = 'none';
                        document.getElementById('btnAgregarCategoria').style.display = 'none';
                    }

                    if (existe) {
                        document.getElementById('categoriaSeleccionada').value = texto;
                    } else {
                        document.getElementById('categoriaSeleccionada').value = '';
                    }
                });

                document.addEventListener('click', function(e) {
                    var container = document.getElementById('campo_categoria_container');
                    if (container && !container.contains(e.target)) {
                        sugerencias.style.display = 'none';
                        document.getElementById('btnAgregarCategoria').style.display = 'none';
                    }
                });
            }

            function seleccionarCategoria(categoria) {
                document.getElementById('categoriaInput').value = categoria;
                document.getElementById('categoriaSeleccionada').value = categoria;
                document.getElementById('sugerenciasCategorias').style.display = 'none';
                document.getElementById('btnAgregarCategoria').style.display = 'none';
            }

            function agregarCategoria() {
                var texto = document.getElementById('categoriaInput').value.trim();
                if (!texto) return;
                
                var catLower = texto.toLowerCase();
                var existe = categoriasGuardadas.some(function(c) {
                    return c.toLowerCase() === catLower;
                });

                if (!existe) {
                    categoriasGuardadas.push(texto);
                    guardarCategorias();
                    seleccionarCategoria(texto);
                    mostrarNotificacion('Categoría "' + texto + '" agregada');
                    // Recargar autocompletado
                    setupCategoriaAutocomplete();
                }
            }

            // ============================================================
            // ===== FUNCIONES PARA MANEJAR CATEGORÍAS DESDE EL LISTADO =====
            // ============================================================

            function editarCategoria(categoria) {
                var nuevaCategoria = prompt('Editar categoría:', categoria);
                if (nuevaCategoria && nuevaCategoria.trim() !== '' && nuevaCategoria.trim() !== categoria) {
                    var nuevaCategoriaTrim = nuevaCategoria.trim();
                    var existe = categoriasGuardadas.some(function(c) {
                        return c.toLowerCase() === nuevaCategoriaTrim.toLowerCase() && c !== categoria;
                    });
                    
                    if (existe) {
                        alert('Ya existe una categoría con ese nombre');
                        return;
                    }
                    
                    for (var i = 0; i < categoriasGuardadas.length; i++) {
                        if (categoriasGuardadas[i] === categoria) {
                            categoriasGuardadas[i] = nuevaCategoriaTrim;
                            break;
                        }
                    }
                    
                    for (var j = 0; j < apus.length; j++) {
                        if (apus[j].categoria === categoria) {
                            apus[j].categoria = nuevaCategoriaTrim;
                        }
                    }
                    
                    guardarCategorias();
                    guardarAPU();
                    renderizarTablasAgrupadas();
                    mostrarNotificacion('Categoría "' + categoria + '" actualizada a "' + nuevaCategoriaTrim + '"');
                    setupCategoriaAutocomplete();
                }
            }

            function eliminarCategoria(categoria) {
                var apusCategoria = apus.filter(function(a) {
                    return a.categoria === categoria;
                });
                
                var mensaje = '¿Eliminar la categoría "' + categoria + '"?';
                if (apusCategoria.length > 0) {
                    mensaje = mensaje + ' Esta categoría tiene ' + apusCategoria.length + ' APU(s). Si eliminas la categoría, los APUs quedarán sin categoría.';
                }
                
                if (confirm(mensaje)) {
                    categoriasGuardadas = categoriasGuardadas.filter(function(c) {
                        return c !== categoria;
                    });
                    
                    var eliminarAPUs = false;
                    if (apusCategoria.length > 0) {
                        eliminarAPUs = confirm('¿También quieres eliminar los ' + apusCategoria.length + ' APU(s) de esta categoría?');
                    }
                    
                    if (eliminarAPUs) {
                        apus = apus.filter(function(a) {
                            return a.categoria !== categoria;
                        });
                        guardarAPU();
                    } else {
                        for (var i = 0; i < apus.length; i++) {
                            if (apus[i].categoria === categoria) {
                                apus[i].categoria = '';
                            }
                        }
                        guardarAPU();
                    }
                    
                    guardarCategorias();
                    renderizarTablasAgrupadas();
                    mostrarNotificacion('Categoría "' + categoria + '" eliminada');
                    setupCategoriaAutocomplete();
                }
            }

            // ============================================================
            // ===== UNIDADES - AUTOCOMPLETADO =====
            // ============================================================

            function cargarUnidadesGuardadas() {
                try {
                    var data = localStorage.getItem('unidades');
                    if (data) {
                        unidadesGuardadas = JSON.parse(data);
                    } else {
                        unidadesGuardadas = [];
                    }
                } catch (e) {
                    unidadesGuardadas = [];
                }
            }

            function guardarUnidades() {
                localStorage.setItem('unidades', JSON.stringify(unidadesGuardadas));
            }

            function setupUnidadAutocomplete() {
                var input = document.getElementById('unidadInput');
                var sugerencias = document.getElementById('sugerenciasUnidades');
                var btnAgregar = document.getElementById('btnAgregarUnidad');

                input.addEventListener('input', function() {
                    var texto = this.value.trim().toUpperCase();
                    var existe = unidadesGuardadas.some(function(u) {
                        return u.toUpperCase() === texto;
                    });

                    if (texto.length > 0) {
                        var coincidencias = unidadesGuardadas.filter(function(u) {
                            return u.toUpperCase().includes(texto);
                        });

                        if (coincidencias.length > 0) {
                            sugerencias.style.display = 'block';
                            var html = '';
                            for (var i = 0; i < coincidencias.length; i++) {
                                var unidad = coincidencias[i];
                                html += '<div class="sugerencia-item" data-unidad="' + unidad + '">' + unidad + '</div>';
                            }
                            sugerencias.innerHTML = html;
                            
                            var items = sugerencias.querySelectorAll('.sugerencia-item');
                            for (var j = 0; j < items.length; j++) {
                                (function(item) {
                                    item.addEventListener('click', function() {
                                        var unidad = this.getAttribute('data-unidad');
                                        seleccionarUnidad(unidad);
                                    });
                                })(items[j]);
                            }
                            
                            btnAgregar.style.display = 'none';
                        } else if (!existe) {
                            sugerencias.style.display = 'none';
                            btnAgregar.style.display = 'inline-flex';
                            btnAgregar.textContent = 'Agregar "' + texto + '"';
                        } else {
                            sugerencias.style.display = 'none';
                            btnAgregar.style.display = 'none';
                        }
                    } else {
                        sugerencias.style.display = 'none';
                        btnAgregar.style.display = 'none';
                    }

                    if (existe) {
                        document.getElementById('unidadSeleccionada').value = texto;
                        document.getElementById('unidad').value = texto;
                    } else {
                        document.getElementById('unidadSeleccionada').value = '';
                        document.getElementById('unidad').value = texto;
                    }
                });

                document.addEventListener('click', function(e) {
                    var container = document.getElementById('campo_unidad_container');
                    if (!container.contains(e.target)) {
                        sugerencias.style.display = 'none';
                        btnAgregar.style.display = 'none';
                    }
                });
            }

            function seleccionarUnidad(unidad) {
                document.getElementById('unidadInput').value = unidad;
                document.getElementById('unidadSeleccionada').value = unidad;
                document.getElementById('unidad').value = unidad;
                document.getElementById('sugerenciasUnidades').style.display = 'none';
                document.getElementById('btnAgregarUnidad').style.display = 'none';
            }

            function agregarUnidad() {
                var texto = document.getElementById('unidadInput').value.trim().toUpperCase();
                if (!texto) return;
                
                var existe = unidadesGuardadas.some(function(u) {
                    return u.toUpperCase() === texto;
                });

                if (!existe) {
                    unidadesGuardadas.push(texto);
                    guardarUnidades();
                    seleccionarUnidad(texto);
                    mostrarNotificacion('Unidad "' + texto + '" agregada');
                }
            }

            // ============================================================
            // ===== TOGGLE IGNORAR ITEMS =====
            // ============================================================
            
            function toggleIgnorarItems() {
                var checkbox = document.getElementById('ignorarItems');
                ignorarItems = checkbox.checked;
                
                var seccionMateriales = document.getElementById('seccionMateriales');
                var seccionEquipos = document.getElementById('seccionEquipos');
                var seccionTransporte = document.getElementById('seccionTransporte');
                var seccionCargos = document.getElementById('seccionCargos');
                var seccionManual = document.getElementById('seccionValorManual');

                if (ignorarItems) {
                    seccionMateriales.style.display = 'none';
                    seccionEquipos.style.display = 'none';
                    seccionTransporte.style.display = 'none';
                    seccionCargos.style.display = 'none';
                    seccionManual.style.display = 'block';
                    itemsMateriales = [];
                    itemsCargos = [];
                    itemsEquipos = [];
                    itemsTransporte = [];
                    renderizarItemsMateriales();
                    renderizarItemsCargos();
                    renderizarItemsEquipos();
                    renderizarItemsTransporte();
                    actualizarSubtotales();
                    actualizarTotalGeneral();
                } else {
                    seccionMateriales.style.display = 'block';
                    seccionEquipos.style.display = 'block';
                    seccionTransporte.style.display = 'block';
                    seccionCargos.style.display = 'block';
                    seccionManual.style.display = 'none';
                    document.getElementById('valorManual').value = '';
                    actualizarSubtotales();
                    actualizarTotalGeneral();
                }
            }

            // ============================================================
            // ===== CARGAR DATOS =====
            // ============================================================
            
            function cargarMateriales() {
                var data = localStorage.getItem('materiales');
                if (data) {
                    materialesData = JSON.parse(data);
                } else {
                    materialesData = [];
                }
            }

            // ============================================================
            // ===== SELECTOR DE MATERIALES CON CANTIDAD INDIVIDUAL =====
            // ============================================================
            
            function abrirSelectorMateriales() {
                var modal = document.getElementById('modalSelectorMateriales');
                if (!modal) return;
                
                var data = localStorage.getItem('materiales');
                if (data) {
                    materialesSelector = JSON.parse(data);
                } else {
                    materialesSelector = [];
                }
                
                materialesSeleccionadosTemp = [];
                for (var i = 0; i < itemsMateriales.length; i++) {
                    materialesSeleccionadosTemp.push({
                        id: itemsMateriales[i].id,
                        cantidad: itemsMateriales[i].cantidad || 1
                    });
                }
                
                materialesFiltradosSelector = materialesSelector.slice();
                paginaActualMateriales = 1;
                renderizarListaMaterialesSelector();
                actualizarSeleccionadosContador();
                modal.style.display = 'flex';
            }

            function cerrarSelectorMateriales() {
                document.getElementById('modalSelectorMateriales').style.display = 'none';
            }

            function filtrarMaterialesSelector() {
                var busqueda = document.getElementById('buscarMaterialSelector').value.toLowerCase().trim();
                if (busqueda === '') {
                    materialesFiltradosSelector = materialesSelector.slice();
                } else {
                    materialesFiltradosSelector = materialesSelector.filter(function(m) {
                        return m.nombre.toLowerCase().includes(busqueda);
                    });
                }
                paginaActualMateriales = 1;
                renderizarListaMaterialesSelector();
            }

            function renderizarListaMaterialesSelector() {
                var container = document.getElementById('listaMaterialesSelector');
                if (!container) return;
                
                var totalItems = materialesFiltradosSelector.length;
                var totalPaginas = Math.ceil(totalItems / itemsPorPagina) || 1;
                
                if (paginaActualMateriales > totalPaginas) {
                    paginaActualMateriales = totalPaginas;
                }
                if (paginaActualMateriales < 1) {
                    paginaActualMateriales = 1;
                }
                
                var inicio = (paginaActualMateriales - 1) * itemsPorPagina;
                var fin = Math.min(inicio + itemsPorPagina, totalItems);
                var paginaItems = materialesFiltradosSelector.slice(inicio, fin);
                
                if (paginaItems.length === 0) {
                    container.innerHTML = '<div class="selector-vacio">No hay materiales disponibles</div>';
                } else {
                    var html = '';
                    for (var i = 0; i < paginaItems.length; i++) {
                        var m = paginaItems[i];
                        var seleccionado = materialesSeleccionadosTemp.some(function(s) {
                            return s.id === m.id;
                        });
                        var precioFormateado = '$' + Number(m.precio).toLocaleString('es-CO');
                        var cantidad = 1;
                        if (seleccionado) {
                            for (var s = 0; s < materialesSeleccionadosTemp.length; s++) {
                                if (materialesSeleccionadosTemp[s].id === m.id) {
                                    cantidad = materialesSeleccionadosTemp[s].cantidad || 1;
                                    break;
                                }
                            }
                        }
                        var btnClase = seleccionado ? 'btn-agregar agregado' : 'btn-agregar';
                        var btnText = seleccionado ? '✓ Agregado' : 'Agregar';
                        
                        html += '<div class="material-item-selector" data-id="' + m.id + '">';
                        html += '<div class="info">';
                        html += '<div class="nombre">' + m.nombre + '</div>';
                        html += '<div class="detalle">' + (m.proveedor || 'Sin proveedor') + ' - ' + precioFormateado + '</div>';
                        html += '</div>';
                        html += '<input type="number" class="cantidad-input" value="' + cantidad + '" min="0.1" step="0.1" data-id="' + m.id + '" ' + (seleccionado ? '' : 'disabled') + ' onchange="actualizarCantidadSeleccionada(' + m.id + ', this.value)">';
                        html += '<button class="' + btnClase + '" data-id="' + m.id + '" ' + (seleccionado ? 'disabled' : '') + '>';
                        html += btnText;
                        html += '</button>';
                        html += '</div>';
                    }
                    container.innerHTML = html;
                    
                    var btns = container.querySelectorAll('.btn-agregar:not(.agregado)');
                    for (var j = 0; j < btns.length; j++) {
                        (function(btn) {
                            btn.addEventListener('click', function() {
                                var id = parseInt(this.getAttribute('data-id'));
                                var cantidadInput = this.parentElement.querySelector('.cantidad-input');
                                var cantidad = parseFloat(cantidadInput.value) || 1;
                                if (cantidad <= 0) cantidad = 1;
                                toggleMaterialSeleccionadoTemp(id, cantidad);
                            });
                        })(btns[j]);
                    }
                }
                
                document.getElementById('resultadosContador').textContent = totalItems + ' resultados';
                document.getElementById('seleccionadosContador').textContent = materialesSeleccionadosTemp.length + ' materiales seleccionados';
                
                var pagInfo = document.getElementById('paginacionInfo');
                if (pagInfo) {
                    pagInfo.textContent = 'Página ' + paginaActualMateriales + ' de ' + totalPaginas;
                }
                
                document.getElementById('btnPaginaAnterior').disabled = paginaActualMateriales <= 1;
                document.getElementById('btnPaginaSiguiente').disabled = paginaActualMateriales >= totalPaginas;
            }

            function actualizarCantidadSeleccionada(id, valor) {
                var cantidad = parseFloat(valor) || 1;
                if (cantidad <= 0) cantidad = 1;
                for (var i = 0; i < materialesSeleccionadosTemp.length; i++) {
                    if (materialesSeleccionadosTemp[i].id === id) {
                        materialesSeleccionadosTemp[i].cantidad = cantidad;
                        break;
                    }
                }
                actualizarSeleccionadosContador();
            }

            function toggleMaterialSeleccionadoTemp(id, cantidad) {
                var index = -1;
                for (var i = 0; i < materialesSeleccionadosTemp.length; i++) {
                    if (materialesSeleccionadosTemp[i].id === id) {
                        index = i;
                        break;
                    }
                }
                if (index === -1) {
                    materialesSeleccionadosTemp.push({ id: id, cantidad: cantidad || 1 });
                } else {
                    materialesSeleccionadosTemp.splice(index, 1);
                }
                actualizarSeleccionadosContador();
                renderizarListaMaterialesSelector();
            }

            function actualizarSeleccionadosContador() {
                var span = document.getElementById('seleccionadosContador');
                if (span) {
                    span.textContent = materialesSeleccionadosTemp.length + ' materiales seleccionados';
                }
                var container = document.getElementById('materialesSeleccionadosLista');
                if (container) {
                    if (materialesSeleccionadosTemp.length === 0) {
                        container.innerHTML = '<p class="empty-items">No hay materiales seleccionados</p>';
                    } else {
                        var html = '';
                        for (var i = 0; i < materialesSeleccionadosTemp.length; i++) {
                            var sel = materialesSeleccionadosTemp[i];
                            var material = null;
                            for (var j = 0; j < materialesSelector.length; j++) {
                                if (materialesSelector[j].id === sel.id) {
                                    material = materialesSelector[j];
                                    break;
                                }
                            }
                            if (material) {
                                var precioFormateado = '$' + Number(material.precio).toLocaleString('es-CO');
                                html += '<div class="seleccionado-item">';
                                html += '<span class="info"><strong>' + material.nombre + '</strong> - ' + precioFormateado + '</span>';
                                html += '<span class="cantidad-info">Cant: ' + sel.cantidad + '</span>';
                                html += '<button class="btn-quitar" data-id="' + sel.id + '"><i class="fas fa-times"></i></button>';
                                html += '</div>';
                            }
                        }
                        container.innerHTML = html;
                        
                        var quitarBtns = container.querySelectorAll('.btn-quitar');
                        for (var k = 0; k < quitarBtns.length; k++) {
                            (function(btn) {
                                btn.addEventListener('click', function() {
                                    var id = parseInt(this.getAttribute('data-id'));
                                    toggleMaterialSeleccionadoTemp(id, 1);
                                });
                            })(quitarBtns[k]);
                        }
                    }
                }
            }

            function guardarMaterialesSeleccionados() {
                itemsMateriales = [];
                for (var i = 0; i < materialesSeleccionadosTemp.length; i++) {
                    var sel = materialesSeleccionadosTemp[i];
                    var material = null;
                    for (var j = 0; j < materialesSelector.length; j++) {
                        if (materialesSelector[j].id === sel.id) {
                            material = materialesSelector[j];
                            break;
                        }
                    }
                    if (material) {
                        var subtotal = material.precio * sel.cantidad;
                        itemsMateriales.push({
                            id: material.id,
                            nombre: material.nombre,
                            proveedor: material.proveedor,
                            precio: material.precio,
                            cantidad: sel.cantidad,
                            subtotal: subtotal
                        });
                    }
                }
                renderizarItemsMateriales();
                actualizarSubtotales();
                actualizarTotalGeneral();
                cerrarSelectorMateriales();
                mostrarNotificacion('Materiales guardados: ' + itemsMateriales.length);
            }

            function cambiarPaginaMateriales(direccion) {
                var totalItems = materialesFiltradosSelector.length;
                var totalPaginas = Math.ceil(totalItems / itemsPorPagina) || 1;
                
                if (direccion === 'anterior' && paginaActualMateriales > 1) {
                    paginaActualMateriales--;
                } else if (direccion === 'siguiente' && paginaActualMateriales < totalPaginas) {
                    paginaActualMateriales++;
                }
                renderizarListaMaterialesSelector();
            }

            // ============================================================
            // ===== RENDERIZAR MATERIALES AGREGADOS =====
            // ============================================================
            
            function renderizarItemsMateriales() {
                var container = document.getElementById('listaMateriales');
                if (!container) return;
                
                var contador = document.getElementById('contadorMateriales');
                if (contador) {
                    contador.textContent = itemsMateriales.length + ' materiales seleccionados';
                }
                
                if (itemsMateriales.length === 0) {
                    container.innerHTML = '<p class="empty-items">No hay materiales agregados</p>';
                    actualizarSubtotales();
                    return;
                }
                var html = '';
                for (var i = 0; i < itemsMateriales.length; i++) {
                    var item = itemsMateriales[i];
                    var subtotalFormateado = formatearMoneda(item.subtotal);
                    html += '<div class="item-tag">';
                    html += '<span><strong>' + item.nombre + '</strong> x ' + item.cantidad + ' = ' + subtotalFormateado + '</span>';
                    html += '<button type="button" class="btn-remove" data-index="' + i + '"><i class="fas fa-times"></i></button>';
                    html += '</div>';
                }
                container.innerHTML = html;
                
                var removeBtns = container.querySelectorAll('.btn-remove');
                for (var j = 0; j < removeBtns.length; j++) {
                    (function(btn) {
                        btn.addEventListener('click', function() {
                            var index = parseInt(this.getAttribute('data-index'));
                            eliminarItemMaterial(index);
                        });
                    })(removeBtns[j]);
                }
                
                actualizarSubtotales();
            }

            function eliminarItemMaterial(index) {
                itemsMateriales.splice(index, 1);
                renderizarItemsMateriales();
                actualizarSubtotales();
                actualizarTotalGeneral();
            }

            // ============================================================
            // ===== MANO DE OBRA =====
            // ============================================================

            function agregarItemCargo() {
                if (ignorarItems) {
                    alert('Los items estan ignorados');
                    return;
                }
                var descripcion = document.getElementById('descripcionCargo').value.trim();
                var unidad = document.getElementById('unidadCargo').value.trim() || 'und';
                var cantidad = parseFloat(document.getElementById('cantidadCargo').value) || 0;
                var valorUnitario = parsearMoneda(document.getElementById('valorUnitarioCargo').value);
                var subtotal = cantidad * valorUnitario;
                
                if (!descripcion) {
                    alert('Ingresa la descripción del cargo');
                    return;
                }
                if (cantidad <= 0) {
                    alert('Ingresa una cantidad válida');
                    return;
                }
                if (valorUnitario <= 0) {
                    alert('Ingresa un valor unitario válido');
                    return;
                }
                
                var item = {
                    descripcion: descripcion,
                    unidad: unidad,
                    cantidad: cantidad,
                    valorUnitario: valorUnitario,
                    subtotal: subtotal
                };
                itemsCargos.push(item);
                console.log('Cargo agregado:', item);
                renderizarItemsCargos();
                limpiarCamposCargo();
                actualizarSubtotales();
                actualizarTotalGeneral();
                actualizarValorBaseEquipoManual();
                actualizarValorBaseTransporteManual();
            }

            function eliminarItemCargo(index) {
                itemsCargos.splice(index, 1);
                renderizarItemsCargos();
                actualizarSubtotales();
                actualizarTotalGeneral();
                actualizarValorBaseEquipoManual();
                actualizarValorBaseTransporteManual();
            }

            function renderizarItemsCargos() {
                var container = document.getElementById('listaCargos');
                if (itemsCargos.length === 0) {
                    container.innerHTML = '<p class="empty-items">No hay cargos agregados</p>';
                    actualizarSubtotales();
                    return;
                }
                var html = '';
                for (var i = 0; i < itemsCargos.length; i++) {
                    var item = itemsCargos[i];
                    var subtotalFormateado = formatearMoneda(item.subtotal);
                    var valorUnitarioFormateado = formatearMoneda(item.valorUnitario);
                    html += '<div class="item-tag">';
                    html += '<span><strong>' + item.descripcion + '</strong> ' + item.cantidad + ' x ' + valorUnitarioFormateado + ' (' + item.unidad + ') = ' + subtotalFormateado + '</span>';
                    html += '<button type="button" class="btn-remove" data-index="' + i + '"><i class="fas fa-times"></i></button>';
                    html += '</div>';
                }
                container.innerHTML = html;
                
                var removeBtns = container.querySelectorAll('.btn-remove');
                for (var j = 0; j < removeBtns.length; j++) {
                    (function(btn) {
                        btn.addEventListener('click', function() {
                            var index = parseInt(this.getAttribute('data-index'));
                            eliminarItemCargo(index);
                        });
                    })(removeBtns[j]);
                }
                
                actualizarSubtotales();
            }

            function limpiarCamposCargo() {
                document.getElementById('descripcionCargo').value = '';
                document.getElementById('unidadCargo').value = 'und';
                document.getElementById('cantidadCargo').value = '1';
