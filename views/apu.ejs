            function descargarFormatoAPU() {
                var notificacion = document.createElement('div');
                notificacion.className = 'notification';
                notificacion.textContent = '⏳ Generando formato...';
                document.body.appendChild(notificacion);
                setTimeout(function() { notificacion.classList.add('show'); }, 100);
                
                fetch('/api/apus/exportar-formato')
                    .then(function(response) {
                        if (!response.ok) {
                            throw new Error('Error al descargar formato');
                        }
                        return response.blob();
                    })
                    .then(function(blob) {
                        var url = window.URL.createObjectURL(blob);
                        var a = document.createElement('a');
                        a.href = url;
                        a.download = 'formato_apu.xlsx';
                        document.body.appendChild(a);
                        a.click();
                        window.URL.revokeObjectURL(url);
                        a.remove();
                        notificacion.classList.remove('show');
                        setTimeout(function() { notificacion.remove(); }, 300);
                        mostrarNotificacion('✅ Formato descargado');
                    })
                    .catch(function(error) {
                        notificacion.classList.remove('show');
                        setTimeout(function() { notificacion.remove(); }, 300);
                        mostrarNotificacion('❌ Error: ' + error.message);
                    });
            }

            function procesarImportacionAPU(event) {
                var file = event.target.files[0];
                if (!file) return;
                
                var progress = document.getElementById('importarProgresoAPU');
                var mensaje = document.getElementById('importarMensajeAPU');
                var resultado = document.getElementById('importarResultadoAPU');
                
                progress.style.display = 'block';
                mensaje.textContent = '⏳ Leyendo archivo...';
                resultado.style.display = 'none';
                
                var reader = new FileReader();
                reader.onload = function(e) {
                    try {
                        var base64 = e.target.result.split(',')[1];
                        mensaje.textContent = '⏳ Enviando al servidor...';
                        
                        fetch('/api/apus/importar', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ file: base64 })
                        })
                        .then(function(response) { return response.json(); })
                        .then(function(data) {
                            if (data.success) {
                                var apusExistentes = JSON.parse(localStorage.getItem('apu') || '[]');
                                var categoriasExistentes = JSON.parse(localStorage.getItem('categorias') || '[]');
                                
                                var maxId = 0;
                                for (var i = 0; i < apusExistentes.length; i++) {
                                    if (apusExistentes[i].id > maxId) {
                                        maxId = apusExistentes[i].id;
                                    }
                                }
                                
                                var contador = 0;
                                var categoriasNuevas = [];
                                
                                for (var j = 0; j < data.apus.length; j++) {
                                    var apu = data.apus[j];
                                    var existe = false;
                                    
                                    var categoriaExiste = false;
                                    for (var k = 0; k < categoriasExistentes.length; k++) {
                                        if (categoriasExistentes[k].toLowerCase() === apu.categoria.toLowerCase()) {
                                            categoriaExiste = true;
                                            break;
                                        }
                                    }
                                    
                                    if (!categoriaExiste && apu.categoria) {
                                        categoriasExistentes.push(apu.categoria);
                                        categoriasNuevas.push(apu.categoria);
                                    }
                                    
                                    for (var l = 0; l < apusExistentes.length; l++) {
                                        if (apusExistentes[l].codigo === apu.codigo) {
                                            apusExistentes[l] = apu;
                                            apusExistentes[l].id = apusExistentes[l].id || (maxId + 1);
                                            existe = true;
                                            contador++;
                                            break;
                                        }
                                    }
                                    
                                    if (!existe) {
                                        maxId++;
                                        apu.id = maxId;
                                        apusExistentes.push(apu);
                                        contador++;
                                    }
                                }
                                
                                localStorage.setItem('apu', JSON.stringify(apusExistentes));
                                localStorage.setItem('categorias', JSON.stringify(categoriasExistentes));
                                
                                apus = apusExistentes;
                                categoriasGuardadas = categoriasExistentes;
                                generarMapaLetras();
                                renderizarTablasAgrupadas();
                                
                                var mensajeCategorias = '';
                                if (categoriasNuevas.length > 0) {
                                    mensajeCategorias = '<br>📁 Categorías nuevas creadas: ' + categoriasNuevas.join(', ');
                                }
                                
                                resultado.style.display = 'block';
                                resultado.style.background = '#d1fae5';
                                resultado.style.color = '#065f46';
                                resultado.innerHTML = '<strong>✅ Importación exitosa!</strong><br>' + 
                                    'Se importaron/actualizaron ' + contador + ' APUs.' + mensajeCategorias;
                                
                                progress.style.display = 'none';
                                mostrarNotificacion('✅ APUs importados: ' + contador);
                                
                                setTimeout(function() {
                                    cerrarModalImportar();
                                }, 3000);
                                
                            } else if (data.error) {
                                resultado.style.display = 'block';
                                resultado.style.background = '#fee2e2';
                                resultado.style.color = '#991b1b';
                                
                                var errorMsg = '<strong>❌ Error:</strong> ' + data.error;
                                if (data.detalles && data.detalles.length > 0) {
                                    errorMsg += '<br><ul style="margin-top:8px; padding-left:20px;">';
                                    for (var m = 0; m < data.detalles.length; m++) {
                                        errorMsg += '<li>' + data.detalles[m] + '</li>';
                                    }
                                    errorMsg += '</ul>';
                                }
                                resultado.innerHTML = errorMsg;
                                progress.style.display = 'none';
                            }
                        })
                        .catch(function(error) {
                            resultado.style.display = 'block';
                            resultado.style.background = '#fee2e2';
                            resultado.style.color = '#991b1b';
                            resultado.innerHTML = '<strong>❌ Error:</strong> ' + error.message;
                            progress.style.display = 'none';
                        });
                        
                    } catch (error) {
                        resultado.style.display = 'block';
                        resultado.style.background = '#fee2e2';
                        resultado.style.color = '#991b1b';
                        resultado.innerHTML = '<strong>❌ Error:</strong> ' + error.message;
                        progress.style.display = 'none';
                    }
                };
                
                reader.readAsDataURL(file);
            }

