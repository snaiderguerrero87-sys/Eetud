                var html = '';
                itemsCargos.forEach((item, i) => {
                    html += '<div class="item-tag"><span><strong>' + escapeHtml(item.descripcion) + '</strong> ' + item.cantidad + ' x ' + formatearMoneda(item.valorUnitario) + ' (' + item.unidad + ') = ' + formatearMoneda(item.subtotal) + '</span>';
                    html += '<button type="button" class="btn-remove" onclick="eliminarItemCargo(' + i + ')"><i class="fas fa-times"></i></button></div>';
                });
                container.innerHTML = html;
                actualizarSubtotales();
            }

