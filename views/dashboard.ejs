<%- include('layouts/main', { 
    title: 'Dashboard',
    usuario: usuario,
    usuarioData: usuarioData,
    body: `
        <section class="dashboard-cards">
            <div class="card">
                <div class="card-icon blue">
                    <i class="fas fa-project-diagram"></i>
                </div>
                <div class="card-info">
                    <h3 id="totalProyectos">0</h3>
                    <p>Proyectos</p>
                    <div class="card-detalle">
                        <span id="proyectosCompletos">0</span> completos · 
                        <span id="proyectosFaltantes" style="color: var(--warning);">0</span> en curso
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-icon green">
                    <i class="fas fa-file-invoice"></i>
                </div>
                <div class="card-info">
                    <h3 id="totalCotizaciones">0</h3>
                    <p>Cotizaciones</p>
                    <div class="card-detalle">
                        <span id="cotizacionesActivas">0</span> activas
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-icon orange">
                    <i class="fas fa-tools"></i>
                </div>
                <div class="card-info">
                    <h3 id="totalHerramientas">0</h3>
                    <p>Herramientas</p>
                    <div class="card-detalle">
                        <span id="herramientasAsignadas">0</span> en obra · 
                        <span id="herramientasDisponibles">0</span> disponibles
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-icon purple">
                    <i class="fas fa-users"></i>
                </div>
                <div class="card-info">
                    <h3 id="totalEmpleados">0</h3>
                    <p>Empleados</p>
                    <div class="card-detalle">
                        <span id="empleadosEnObra">0</span> en obra · 
                        <span id="empleadosDisponibles">0</span> disponibles
                    </div>
                </div>
            </div>
        </section>

        <section class="dashboard-detalle">
            <div class="detalle-columna">
                <div class="detalle-header">
                    <h3><i class="fas fa-chart-line" style="color: var(--warning);"></i> Proyectos en Curso</h3>
                    <a href="/proyectos" class="view-all">Ver todos</a>
                </div>
                <div id="listaProyectosCurso"></div>
                <div id="sinProyectosCurso" class="empty-state-detalle" style="display:none;">
                    <i class="fas fa-check-circle" style="color: var(--success);"></i>
                    <p>Todos los proyectos están completos</p>
                </div>
            </div>

            <div class="detalle-columna">
                <div class="detalle-header">
                    <h3><i class="fas fa-tools" style="color: var(--orange);"></i> Herramientas en Obra</h3>
                    <a href="/herramientas" class="view-all">Ver todas</a>
                </div>
                <div id="listaHerramientasObra"></div>
                <div id="sinHerramientasObra" class="empty-state-detalle" style="display:none;">
                    <i class="fas fa-tools"></i>
                    <p>No hay herramientas asignadas</p>
                </div>
            </div>

            <div class="detalle-columna">
                <div class="detalle-header">
                    <h3><i class="fas fa-users" style="color: var(--purple);"></i> Empleados en Obra</h3>
                    <a href="/asistencia" class="view-all">Ver todos</a>
                </div>
                <div id="listaEmpleadosObra"></div>
                <div id="sinEmpleadosObra" class="empty-state-detalle" style="display:none;">
                    <i class="fas fa-users"></i>
                    <p>No hay empleados asignados</p>
                </div>
            </div>
        </section>

        <script>
            function escapeHtml(text) {
                if (text === undefined || text === null) return '';
                return String(text)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            async function cargarDashboard() {
                try {
                    const response = await fetch('/api/dashboard/resumen');
                    if (!response.ok) throw new Error('Error al cargar resumen');
                    const data = await response.json();

                    // ===== PROYECTOS =====
                    document.getElementById('totalProyectos').textContent = data.proyectos.total;
                    document.getElementById('proyectosCompletos').textContent = data.proyectos.completos;
                    document.getElementById('proyectosFaltantes').textContent = data.proyectos.enCurso;

                    var containerProyectos = document.getElementById('listaProyectosCurso');
                    var sinProyectos = document.getElementById('sinProyectosCurso');

                    if (data.proyectos.lista.length === 0) {
                        containerProyectos.innerHTML = '';
                        sinProyectos.style.display = 'block';
                    } else {
                        sinProyectos.style.display = 'none';
                        var htmlProyectos = '';
                        for (var i = 0; i < data.proyectos.lista.length; i++) {
                            var p = data.proyectos.lista[i];
                            var avance = Math.round(p.avanceTotal || 0);
                            htmlProyectos += '<div class="item-detalle">';
                            htmlProyectos += '<div class="item-info">';
                            htmlProyectos += '<strong>' + escapeHtml(p.nombre || 'Proyecto #' + p.id) + '</strong>';
                            htmlProyectos += '<span class="item-sub">' + escapeHtml(p.cliente || '-') + '</span>';
                            htmlProyectos += '</div>';
                            htmlProyectos += '<div class="item-progress">';
                            htmlProyectos += '<div class="progress-bar-mini">';
                            htmlProyectos += '<div class="progress-fill-mini" style="width:' + avance + '%;"></div>';
                            htmlProyectos += '<span class="progress-text-mini">' + avance + '%</span>';
                            htmlProyectos += '</div>';
                            htmlProyectos += '</div>';
                            htmlProyectos += '</div>';
                        }
                        containerProyectos.innerHTML = htmlProyectos;
                    }

                    // ===== COTIZACIONES =====
                    document.getElementById('totalCotizaciones').textContent = data.cotizaciones.total;
                    document.getElementById('cotizacionesActivas').textContent = data.cotizaciones.total;

                    // ===== HERRAMIENTAS =====
                    document.getElementById('totalHerramientas').textContent = data.herramientas.total;
                    document.getElementById('herramientasAsignadas').textContent = data.herramientas.enObra;
                    document.getElementById('herramientasDisponibles').textContent = data.herramientas.disponibles;

                    var containerHerr = document.getElementById('listaHerramientasObra');
                    var sinHerr = document.getElementById('sinHerramientasObra');

                    if (data.herramientas.detalleEnObra.length === 0) {
                        containerHerr.innerHTML = '';
                        sinHerr.style.display = 'block';
                    } else {
                        sinHerr.style.display = 'none';
                        var htmlHerr = '';
                        for (var j = 0; j < data.herramientas.detalleEnObra.length; j++) {
                            var h = data.herramientas.detalleEnObra[j];
                            htmlHerr += '<div class="item-detalle">';
                            htmlHerr += '<div class="item-info">';
                            htmlHerr += '<strong>' + escapeHtml(h.nombre || 'Herramienta') + '</strong>';
                            htmlHerr += '<span class="item-sub">' + escapeHtml(h.marca || '-') + ' · ' + escapeHtml(h.codigo || '-') + '</span>';
                            htmlHerr += '</div>';
                            htmlHerr += '<div class="item-badge">';
                            htmlHerr += '<span class="badge-success">En obra</span>';
                            htmlHerr += '</div>';
                            htmlHerr += '</div>';
                        }
                        containerHerr.innerHTML = htmlHerr;
                    }

                    // ===== EMPLEADOS =====
                    document.getElementById('totalEmpleados').textContent = data.empleados.total;
                    document.getElementById('empleadosEnObra').textContent = data.empleados.enObra;
                    document.getElementById('empleadosDisponibles').textContent = data.empleados.disponibles;

                    var containerEmp = document.getElementById('listaEmpleadosObra');
                    var sinEmp = document.getElementById('sinEmpleadosObra');

                    if (data.empleados.detalleEnObra.length === 0) {
                        containerEmp.innerHTML = '';
                        sinEmp.style.display = 'block';
                    } else {
                        sinEmp.style.display = 'none';
                        var htmlEmp = '';
                        for (var k = 0; k < data.empleados.detalleEnObra.length; k++) {
                            var e = data.empleados.detalleEnObra[k];
                            htmlEmp += '<div class="item-detalle">';
                            htmlEmp += '<div class="item-info">';
                            htmlEmp += '<strong>' + escapeHtml(e.nombre || 'Empleado') + '</strong>';
                            htmlEmp += '<span class="item-sub">' + escapeHtml(e.cargo || '-') + '</span>';
                            htmlEmp += '</div>';
                            htmlEmp += '<div class="item-badge">';
                            htmlEmp += '<span class="badge-success">En obra</span>';
                            htmlEmp += '</div>';
                            htmlEmp += '</div>';
                        }
                        containerEmp.innerHTML = htmlEmp;
                    }

                } catch (error) {
                    console.error('Error al cargar dashboard:', error);
                }
            }

            document.addEventListener('DOMContentLoaded', function() {
                cargarDashboard();
            });
        </script>
    `
}) %>